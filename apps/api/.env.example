# Origin allowed to call this API from the browser. Set to the storefront URL.
STOREFRONT_ORIGIN=http://localhost:4321

# Where enquiries and newsletter signups are written in Phase 1.
# A JSON file is deliberate: it is inspectable, backed up with the repo volume,
# and trivial to migrate into Postgres in Phase 2.
JAIISHA_DATA_DIR=./.data

# Shared key for the catalogue admin at /admin. Admin is DISABLED until this
# is set — there is no default. Use a long random value:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
ADMIN_KEY=

# Where the storefront is served from, so admin thumbnails resolve.
NEXT_PUBLIC_STOREFRONT_ORIGIN=http://localhost:4321

# Phase 2 — not read yet, listed so deployment knows what will be needed.
# DATABASE_URL=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RESEND_API_KEY=
# INSTAGRAM_ACCESS_TOKEN=

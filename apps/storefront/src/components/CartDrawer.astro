  /* ==================== TOAST NOTIFICATIONS ==================== */
  .toast-container {
    position: fixed;
    bottom: 5.5rem;
    right: clamp(1rem, 3vw, 2rem);
    z-index: 95;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    pointer-events: none;
  }

  :global(.toast) {
    pointer-events: auto;
    display: grid;
    grid-template-columns: 3.2rem 1fr auto;
    gap: 0.75rem;
    align-items: center;
    padding: 0.75rem 1rem;
    background: var(--surface);
    border: 1px solid var(--gold);
    border-left: 4px solid var(--wine);
    border-radius: var(--r-sm);
    box-shadow: 0 10px 30px rgba(36, 19, 25, 0.16);

    position: fixed;
    inset: 0;
    z-index: 100;
    display: flex;
    justify-content: flex-end;
  }

  .cart-drawer[hidden] {
    display: none;
  }

  .cart-drawer__scrim {
    position: absolute;
    inset: 0;

</style>

<script>
  interface CartItem {
    sku: string;
    slug: string;
    name: string;
    colour: string;
    price: string;
    paise: number;
    gst: number;
    image: string;
    quantity: number;
  }

  const KEY = "jaiisha:bag";
  const FREE_SHIPPING_PAISE = 300000;
  const WHATSAPP = "919000000000";

  const indexEl = document.getElementById("sku-index-global");
  const skus: CartItem[] = indexEl ? JSON.parse(indexEl.textContent || "[]") : [];
  const bySku = new Map(skus.map((l) => [l.sku, l]));

  // Cart Drawer Elements
  const drawer = document.querySelector<HTMLElement>("[data-cart-drawer]");
  const countBadge = document.querySelector<HTMLElement>("[data-cart-count-badge]");
  const itemsContainer = document.querySelector<HTMLElement>("[data-cart-items]");
  const emptyState = document.querySelector<HTMLElement>("[data-cart-empty]");
  const footer = document.querySelector<HTMLElement>("[data-cart-footer]");
  const subtotalEl = document.querySelector<HTMLElement>("[data-cart-subtotal]");
  const discountRow = document.querySelector<HTMLElement>("[data-discount-row]");
  const discountEl = document.querySelector<HTMLElement>("[data-cart-discount]");
  const discountLabel = document.querySelector<HTMLElement>("[data-discount-label]");
  const totalEl = document.querySelector<HTMLElement>("[data-cart-total]");
  const shippingFill = document.querySelector<HTMLElement>("[data-shipping-fill]");
  const shippingText = document.querySelector<HTMLElement>("[data-shipping-text]");
  const waBtn = document.querySelector<HTMLAnchorElement>("[data-cart-wa-btn]");
  const couponForm = document.querySelector<HTMLFormElement>("[data-coupon-form]");
  const couponInput = document.querySelector<HTMLInputElement>("[data-coupon-input]");
  const couponMsg = document.querySelector<HTMLElement>("[data-coupon-msg]");
  const toastContainer = document.querySelector<HTMLElement>("[data-toast-container]");

  let activeCouponCode = "";

  const inr = (paise: number) =>
    new Intl.NumberFormat("en-IN", {
      style: "currency",
      currency: "INR",
      maximumFractionDigits: 0,
    }).format(paise / 100);

  // Read items with normalization
  const readCart = (): CartItem[] => {
    try {
      const raw = localStorage.getItem(KEY);
      if (!raw) return [];
      const parsed = JSON.parse(raw);
      if (!Array.isArray(parsed)) return [];

      // If array of strings (legacy)
      if (parsed.length > 0 && typeof parsed[0] === "string") {
        const counts: Record<string, number> = {};
        parsed.forEach((sku: string) => {
          counts[sku] = (counts[sku] || 0) + 1;
        });
        const converted: CartItem[] = [];
        for (const [sku, qty] of Object.entries(counts)) {
          const item = bySku.get(sku);
          if (item) converted.push({ ...item, quantity: qty });
        }
        return converted;
      }
      return parsed;
    } catch {
      return [];
    }
  };

  const writeCart = (items: CartItem[]) => {
    try {
      localStorage.setItem(KEY, JSON.stringify(items));
    } catch {
      /* private mode */
    }
    window.dispatchEvent(new CustomEvent("jaiisha:store"));
    render();
  };

  // Open & Close Drawer
  const openDrawer = () => {
    if (!drawer) return;
    drawer.hidden = false;
    drawer.setAttribute("aria-hidden", "false");
    document.body.classList.add("no-scroll");
    render();
  };

  const closeDrawer = () => {
    if (!drawer) return;
    drawer.hidden = true;
    drawer.setAttribute("aria-hidden", "true");
    document.body.classList.remove("no-scroll");
  };

  document.querySelectorAll("[data-cart-close]").forEach((b) =>
    b.addEventListener("click", closeDrawer)
  );

  // Toast Function
  const showToast = (item: CartItem, actionText = "Added to Bag") => {
    if (!toastContainer) return;
    const toast = document.createElement("div");
    toast.className = "toast";
    toast.innerHTML = `
      <div class="toast__img">
        <img src="${item.image}" alt="${item.name}" />
      </div>
      <div>
        <h4 class="toast__title">${item.name}</h4>
        <p class="toast__meta">${actionText} · ${item.colour} (${item.price})</p>
      </div>
      <button class="toast__action" type="button">View Bag</button>
    `;

    toast.querySelector(".toast__action")?.addEventListener("click", () => {
      toast.remove();
      openDrawer();
    });

    toastContainer.appendChild(toast);
    setTimeout(() => {
      toast.style.transition = "opacity 0.4s, transform 0.4s";
      toast.style.opacity = "0";
      toast.style.transform = "translateY(1rem)";
      setTimeout(() => toast.remove(), 400);
    }, 4000);
  };

  // Expose global methods for other components
  (window as any).jaiishaCart = {
    open: openDrawer,
    close: closeDrawer,
    add: (newItem: Omit<CartItem, "quantity"> & { quantity?: number }) => {
      const items = readCart();
      const qty = newItem.quantity || 1;
      const idx = items.findIndex((i) => i.sku === newItem.sku);
      if (idx > -1) {
        items[idx].quantity += qty;
      } else {
        items.push({ ...newItem, quantity: qty });
      }
      writeCart(items);
      showToast({ ...newItem, quantity: qty });
      openDrawer();
    },
    remove: (sku: string) => {
      const items = readCart().filter((i) => i.sku !== sku);
      writeCart(items);
    },
    updateQty: (sku: string, delta: number) => {
      const items = readCart();
      const idx = items.findIndex((i) => i.sku === sku);
      if (idx > -1) {
        items[idx].quantity += delta;
        if (items[idx].quantity <= 0) {
          items.splice(idx, 1);
        }
        writeCart(items);
      }
    },
    showToast,
  };

  // Render Drawer Content
  const render = () => {
    const items = readCart();
    const count = items.reduce((sum, i) => sum + i.quantity, 0);
    const subtotal = items.reduce((sum, i) => sum + i.paise * i.quantity, 0);

    if (countBadge) countBadge.textContent = String(count);

    const hasItems = items.length > 0;
    if (emptyState) emptyState.hidden = hasItems;
    if (footer) footer.hidden = !hasItems;

    // Shipping progress
    if (shippingFill && shippingText) {
      const progress = Math.min(100, Math.round((subtotal / FREE_SHIPPING_PAISE) * 100));
      shippingFill.style.width = `${progress}%`;
      if (subtotal >= FREE_SHIPPING_PAISE) {
        shippingText.textContent = "✨ You have unlocked Free Insured Express Delivery!";
      } else {
        const remaining = inr(FREE_SHIPPING_PAISE - subtotal);
        shippingText.textContent = `Add ${remaining} more for Free Insured Delivery`;
      }
    }

    // Line items
    if (itemsContainer) {
      itemsContainer.replaceChildren();
      items.forEach((item) => {
        const li = document.createElement("li");
        li.className = "c-item";
        li.innerHTML = `
          <a class="c-item__thumb" href="/sarees/${item.slug}">
            <img src="${item.image}" alt="${item.name}" loading="lazy" />
          </a>
          <div class="c-item__info">
            <div>
              <a class="c-item__title" href="/sarees/${item.slug}">${item.name}</a>
              <p class="c-item__meta">${item.colour} · ${item.sku}</p>
              <p class="c-item__price">${item.price}</p>
            </div>
            <div class="c-item__qty">
              <button class="c-item__qty-btn" type="button" data-qty-minus="${item.sku}" aria-label="Decrease quantity">−</button>
              <span class="c-item__qty-val">${item.quantity}</span>
              <button class="c-item__qty-btn" type="button" data-qty-plus="${item.sku}" aria-label="Increase quantity">+</button>
            </div>
          </div>
          <button class="c-item__del" type="button" data-del="${item.sku}" aria-label="Remove item">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8">
              <path d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
            </svg>
          </button>
        `;
        itemsContainer.appendChild(li);
      });

      // Bind +/- and delete events
      itemsContainer.querySelectorAll<HTMLButtonElement>("[data-qty-minus]").forEach((b) => {
        b.addEventListener("click", () => (window as any).jaiishaCart.updateQty(b.dataset.qtyMinus!, -1));
      });
      itemsContainer.querySelectorAll<HTMLButtonElement>("[data-qty-plus]").forEach((b) => {
        b.addEventListener("click", () => (window as any).jaiishaCart.updateQty(b.dataset.qtyPlus!, 1));
      });
      itemsContainer.querySelectorAll<HTMLButtonElement>("[data-del]").forEach((b) => {
        b.addEventListener("click", () => (window as any).jaiishaCart.remove(b.dataset.del!));
      });
    }

    // Coupon calculation
    let discount = 0;
    if (activeCouponCode === "JAIISHA10") {
      discount = Math.round(subtotal * 0.1);
      if (discountLabel) discountLabel.textContent = "10% Festive Discount";
    } else if (activeCouponCode === "UTSAV") {
      discount = Math.min(150000, subtotal);
      if (discountLabel) discountLabel.textContent = "₹1,500 Festive Celebration Discount";
    }

    const finalTotal = Math.max(0, subtotal - discount);

    if (subtotalEl) subtotalEl.textContent = inr(subtotal);
    if (discountRow) discountRow.hidden = discount === 0;
    if (discountEl) discountEl.textContent = `-${inr(discount)}`;
    if (totalEl) totalEl.textContent = inr(finalTotal);

    // WhatsApp order link
    if (waBtn) {
      const orderLines = items.map(
        (i) => `• ${i.name} — ${i.colour} (Qty: ${i.quantity}) — ${i.price} each [${i.sku}]`
      );
      const msg = [
        "✨ *Hello JAIISHA, I would like to place this saree order:*",
        "",
        ...orderLines,
        "",
        `*Items:* ${count}`,
        `*Subtotal:* ${inr(subtotal)}`,
        ...(discount > 0 ? [`*Coupon (${activeCouponCode}):* -${inr(discount)}`, `*Final Total:* ${inr(finalTotal)}`] : []),
        `*Shipping:* ${finalTotal >= FREE_SHIPPING_PAISE ? "Free Insured Express Delivery" : "Standard Delivery"}`,
        "",
        "Please confirm availability and share payment details. Thank you!",
      ].join("\n");

      waBtn.href = `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;
    }
  };

  // Coupon handling
  couponForm?.addEventListener("submit", (e) => {
    e.preventDefault();
    const code = (couponInput?.value || "").trim().toUpperCase();
    if (!couponMsg) return;

    if (code === "JAIISHA10" || code === "UTSAV" || code === "FIRSTSAREE") {
      activeCouponCode = code === "FIRSTSAREE" ? "JAIISHA10" : code;
      couponMsg.textContent = `✓ Coupon ${code} applied successfully!`;
      couponMsg.className = "cart-drawer__coupon-msg is-success";
      render();
    } else if (!code) {
      activeCouponCode = "";
      couponMsg.textContent = "";
      render();
    } else {
      couponMsg.textContent = "Invalid coupon code. Try JAIISHA10";
      couponMsg.className = "cart-drawer__coupon-msg is-error";
    }
  });

  // Listen for bag events
  window.addEventListener("jaiisha:store", render);
  render();

  // Escape key closes drawer
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && drawer && !drawer.hidden) {
      closeDrawer();
    }
  });
</script>


---
import { PRODUCTS, formatINR } from "@jaiisha/catalogue";

const skuIndex = PRODUCTS.flatMap((p) =>
  p.variants.map((v) => ({
    sku: v.sku,
    slug: p.slug,
    name: p.name,
    colour: v.colour.name,
    price: formatINR(v.price),
    paise: v.price.paise,
    gst: p.tax.gstRate,
    image: (v.images.find((i) => i.kind === "model") ?? v.images[0]).src,
  })),
);
---

<!-- Cart Drawer Slide-over -->
<div class="cart-drawer" data-cart-drawer hidden aria-hidden="true">
  <div class="cart-drawer__scrim" data-cart-close></div>
  <aside class="cart-drawer__panel" role="dialog" aria-modal="true" aria-label="Shopping Bag">
    <div class="cart-drawer__header">
      <div class="cart-drawer__title-wrap">
        <h2 class="cart-drawer__title">Your Bag</h2>
        <span class="cart-drawer__badge" data-cart-count-badge>0</span>
      </div>
      <button class="cart-drawer__close icon-btn" type="button" aria-label="Close bag" data-cart-close>
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none" />
        </svg>
      </button>
    </div>

    <!-- Free Shipping Progress -->
    <div class="cart-drawer__shipping-meter" data-shipping-meter>
      <div class="cart-drawer__shipping-label" data-shipping-text>
        Add ₹3,000 for Free Insured Express Delivery
      </div>
      <div class="cart-drawer__progress-bar">
        <div class="cart-drawer__progress-fill" data-shipping-fill style="width: 0%;"></div>
      </div>
    </div>

    <!-- Items List -->
    <div class="cart-drawer__body">
      <ul class="cart-drawer__list" data-cart-items></ul>

      <div class="cart-drawer__empty" data-cart-empty>
        <div class="cart-drawer__empty-icon">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M6 8h12l-1 11.5H7L6 8Z" fill="none" stroke="currentColor" stroke-width="1.3" />
            <path d="M9.5 8V6.4a2.5 2.5 0 0 1 5 0V8" fill="none" stroke="currentColor" stroke-width="1.3" />
          </svg>
        </div>
        <p class="cart-drawer__empty-title">Your bag is empty</p>
        <p class="cart-drawer__empty-desc">Discover our handwoven Banarasi bridal, festive and heirloom silk sarees.</p>
        <a href="/sarees" class="btn btn--gold cart-drawer__empty-btn" data-cart-close>Explore Collection</a>
      </div>
    </div>

    <!-- Footer Summary & Actions -->
    <div class="cart-drawer__footer" data-cart-footer hidden>
      <!-- Coupon Field -->
      <div class="cart-drawer__coupon">
        <form class="cart-drawer__coupon-form" data-coupon-form>
          <input
            type="text"
            class="cart-drawer__coupon-input"
            placeholder="Coupon code (e.g. JAIISHA10)"
            aria-label="Coupon code"
            data-coupon-input
          />
          <button type="submit" class="cart-drawer__coupon-btn">Apply</button>
        </form>
        <div class="cart-drawer__coupon-msg" data-coupon-msg role="status"></div>
      </div>

      <div class="cart-drawer__totals">
        <div class="cart-drawer__row">
          <span>Subtotal</span>
          <span class="cart-drawer__val" data-cart-subtotal>₹0</span>
        </div>
        <div class="cart-drawer__row cart-drawer__row--discount" data-discount-row hidden>
          <span data-discount-label>Festive Discount</span>
          <span class="cart-drawer__val text-green" data-cart-discount>-₹0</span>
        </div>
        <div class="cart-drawer__row">
          <span>Insured Shipping</span>
          <span class="cart-drawer__val" data-cart-shipping>Free</span>
        </div>
        <div class="cart-drawer__row cart-drawer__row--total">
          <span>Total (incl. GST)</span>
          <span class="cart-drawer__val cart-drawer__total-val" data-cart-total>₹0</span>
        </div>
      </div>

      <div class="cart-drawer__actions">
        <a class="btn btn--wa cart-drawer__btn-wa" data-cart-wa-btn target="_blank" rel="noopener noreferrer">
          <svg viewBox="0 0 24 24" aria-hidden="true" style="width: 1.2rem; height: 1.2rem;">
            <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z" fill="currentColor"></path>
            <path d="M8.6 7.6c.4 0 .8.2 1 .6l.7 1.6c.1.3 0 .6-.2.8l-.7.7c.5 1 1.3 1.8 2.3 2.3l.7-.7c.2-.2.5-.3.8-.2l1.6.7c.4.2.6.6.6 1 0 1-.8 1.8-1.8 1.8A7.4 7.4 0 0 1 6.8 9.4c0-1 .8-1.8 1.8-1.8Z" fill="#1faa59"></path>
          </svg>
          Order on WhatsApp
        </a>
        <a href="/bag" class="btn btn--ghost cart-drawer__btn-view">
          View Bag &amp; Full Breakdown
        </a>
      </div>
    </div>
  </aside>
</div>

<!-- Floating Toast Notification -->
<div class="toast-container" data-toast-container aria-live="polite"></div>

<!-- Quick View Modal -->
<div class="quick-modal" data-quick-modal hidden aria-hidden="true">
  <div class="quick-modal__scrim" data-quick-close></div>
  <div class="quick-modal__panel" role="dialog" aria-modal="true" aria-label="Quick View">
    <button class="quick-modal__close icon-btn" type="button" aria-label="Close" data-quick-close>
      <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
    </button>
    <div class="quick-modal__content" data-quick-content>
      <!-- Populated via script -->
    </div>
  </div>
</div>

<script type="application/json" id="sku-index-global" set:html={JSON.stringify(skuIndex)} />

<style>
  /* ==================== CART DRAWER ==================== */

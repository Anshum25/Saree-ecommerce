---
import { colourFacets } from "@jaiisha/catalogue";

const colours = colourFacets();
---

<section class="col section" id="colour" aria-labelledby="col-title">
  <div class="shell">
    <div class="section-head section-head--center">
      <p class="eyebrow">Shop by colour</p>
      <h2 class="col__title" id="col-title">Start from the shade you have in mind</h2>
      <div class="rule col__rule"><span class="rule__mark"></span></div>
    </div>

    <ul class="col__list">
      {
        colours.map((c) => (
          <li>
            <a class="col__item reveal" href={`/sarees?colour=${c.slug}`}>
              <span class="col__disc" style={`--a:${c.hex};--b:${c.shadeHex ?? c.hex}`} aria-hidden="true">
                <span class="col__sheen"></span>
              </span>
              <span class="col__name">{c.name}</span>
              <span class="col__count">{c.count} designs</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .col__title {
    font-size: var(--step-3);
    font-weight: 300;
  }

  .col__rule {
    width: min(14rem, 50%);
  }

  .col__list {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: clamp(0.6rem, 2vw, 1.5rem);
  }

  .col__item {
    display: grid;
    justify-items: center;
    gap: 0.6rem;
    text-align: center;
  }

  .col__disc {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle at 32% 28%, var(--a), var(--b) 78%);
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12), var(--shadow-sm);
    overflow: hidden;
    transition: scale 0.5s var(--ease-out-soft), box-shadow 0.5s var(--ease);
  }

  .col__item:hover .col__disc {
    scale: 1.06;
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.12), 0 0 0 1px var(--bg), 0 0 0 2px var(--gold),
      var(--shadow-md);
  }

  /* A silk highlight that sweeps across on hover */
  .col__sheen {
    position: absolute;
    inset: -30%;
    background: linear-gradient(
      70deg,
      transparent 38%,
      rgba(255, 255, 255, 0.42) 50%,
      transparent 62%
    );
    translate: -70% 0;
    transition: translate 0.9s var(--ease-out-soft);
  }

  .col__item:hover .col__sheen {
    translate: 70% 0;
  }

  .col__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.1;
  }

  .col__count {
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  @media (max-width: 880px) {
    .col__list {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      row-gap: 1.8rem;
    }
  }

  @media (max-width: 420px) {
    .col__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .col__count {
      display: none;
    }
  }
</style>

---
import { SITE, whatsappLink } from "../lib/site.ts";

const year = new Date().getFullYear();

const columns = [
  {
    heading: "Shop",
    links: [
      { label: "New Arrivals", href: "/sarees?sort=newest" },
      { label: "All Sarees", href: "/sarees" },
      { label: "Wedding & Bridal", href: "/occasion/wedding-bridal" },
      { label: "Festive", href: "/occasion/festive" },
      { label: "Gifting", href: "/occasion/gifting" },
      { label: "Under ₹5,000", href: "/sarees?price=under-5000" },
    ],
  },
  {
    heading: "The House",
    links: [
      { label: "Our Craft", href: "/craft" },
      { label: "The Weavers", href: "/craft#weavers" },
      { label: "Saree Care", href: "/craft#care" },
      { label: "How to Drape", href: "/craft#drape" },
      { label: "Contact", href: "/contact" },
    ],
  },
  {
    heading: "Help",
    links: [
      { label: "Shipping", href: "/policies/shipping" },
      { label: "Returns & Exchange", href: "/policies/returns" },
      { label: "Order on WhatsApp", href: whatsappLink("Hello JAIISHA, I would like help choosing a saree.") },
      { label: "Track an Order", href: "/orders" },
      { label: "FAQs", href: "/policies/faq" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy Policy", href: "/policies/privacy" },
      { label: "Terms of Use", href: "/policies/terms" },
      { label: "Cancellations", href: "/policies/cancellations" },
    ],
  },
];
---

<footer class="foot">
  <!-- Newsletter -->
  <div class="foot__news">
    <div class="shell foot__news-inner">
      <div>
        <p class="eyebrow">Before everyone else</p>
        <h2 class="foot__news-title">
          New pieces leave the loom in small numbers
        </h2>
        <p class="foot__news-body">
          One letter a month: what came off the loom, what is nearly sold, and a note on how to
          wear it. No discount spam.
        </p>
      </div>
      <form class="foot__form" data-newsletter>
        <label class="visually-hidden" for="news-email">Email address</label>
        <input
          class="foot__input"
          id="news-email"
          name="email"
          type="email"
          required
          placeholder="your@email.com"
          autocomplete="email"
        />
        <button class="btn btn--gold" type="submit">Subscribe</button>
        <p class="foot__form-msg" data-newsletter-msg role="status" aria-live="polite"></p>
      </form>
    </div>
  </div>

  <div class="shell foot__main">
    <div class="foot__brand">
      <img
        class="foot__logo"
        src="/img/brand/jaiisha-logo.png"
        alt="JAIISHA — Banarasi silk sarees"
        width="353"
        height="240"
        loading="lazy"
        decoding="async"
      />
      <p class="foot__pitch">{SITE.tagline}</p>
      <dl class="foot__contact">
        <div>
          <dt>WhatsApp & Phone</dt>
          <dd><a href={whatsappLink("Hello JAIISHA!")}>{SITE.phoneDisplay}</a></dd>
        </div>
        <div>
          <dt>Email</dt>
          <dd><a href={`mailto:${SITE.email}`}>{SITE.email}</a></dd>
        </div>
        <div>
          <dt>Hours</dt>
          <dd>Monday to Saturday, 10am – 8pm IST</dd>
        </div>
      </dl>
      <ul class="foot__social">
        <li>
          <a href={SITE.instagram} target="_blank" rel="noopener noreferrer" aria-label="JAIISHA on Instagram">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3.5" y="3.5" width="17" height="17" rx="5" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.5" /><circle cx="17" cy="7" r="1.2" fill="currentColor" /></svg>
          </a>
        </li>
        <li>
          <a href={whatsappLink("Hello JAIISHA!")} target="_blank" rel="noopener noreferrer" aria-label="JAIISHA on WhatsApp">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a7.9 7.9 0 0 1-11.6 7L4 20l1.4-4.2A7.9 7.9 0 1 1 20 11.7Z" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M9 9.5c0 3 2.4 5.4 5.4 5.4.6 0 1-.5 1-1l-.1-.8-1.7-.5-.8.8a4.3 4.3 0 0 1-2-2l.8-.8-.5-1.7-.8-.1c-.5 0-1 .4-1 1Z" fill="currentColor" /></svg>
          </a>
        </li>
        <li>
          <a href={`mailto:${SITE.email}`} aria-label="Email JAIISHA">
            <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="5.5" width="18" height="13" rx="2" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M3.6 6.8 12 13l8.4-6.2" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
          </a>
        </li>
      </ul>
    </div>

    <nav class="foot__cols" aria-label="Footer">
      {
        columns.map((col) => (
          <div class="foot__col">
            <h3 class="foot__col-head">{col.heading}</h3>
            <ul>
              {col.links.map((l) => (
                <li><a href={l.href}>{l.label}</a></li>
              ))}
            </ul>
          </div>
        ))
      }
    </nav>
  </div>

  <div class="foot__bar">
    <div class="shell foot__bar-inner">
      <p>© {year} {SITE.name}. Handwoven in Varanasi, shipped across India.</p>
      <p class="foot__pay">
        <span>Secure payments</span>
        <span class="foot__pay-chips">UPI · Cards · Net Banking · Razorpay</span>
      </p>
    </div>
  </div>
</footer>

<style>
  .foot__logo {
    display: block;
    width: 11rem;
    height: auto;
    margin-left: -0.6rem;
  }

  .foot {
    background: var(--dark);
    color: var(--on-dark);
  }

  /* --- newsletter ------------------------------------------------------ */
  .foot__news {
    background: var(--plum);
    border-bottom: 1px solid rgba(181, 138, 67, 0.28);
  }

  .foot__news-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: center;
    padding-block: clamp(2rem, 5vw, 3.5rem);
  }

  .foot__news-title {
    font-size: var(--step-2);
    font-weight: 300;
    margin: 0.5rem 0 0.6rem;
    max-width: 28ch;
  }

  .foot__news-body {
    font-size: 0.86rem;
    font-weight: 300;
    line-height: 1.7;
    color: rgba(246, 239, 228, 0.72);
    max-width: 50ch;
  }

  .foot__form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    align-items: center;
  }

  .foot__input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.9rem 1.1rem;
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid rgba(246, 239, 228, 0.28);
    border-radius: var(--r-pill);
    color: var(--on-dark);
    font-size: 0.9rem;
  }

  .foot__input::placeholder {
    color: rgba(246, 239, 228, 0.45);
  }

  .foot__input:focus-visible {
    border-color: var(--gold);
    outline: none;
  }

  .foot__form-msg {
    flex: 1 0 100%;
    font-size: 0.78rem;
    color: var(--gold-light);
    min-height: 1.2em;
  }

  /* --- main ------------------------------------------------------------ */
  .foot__main {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }

  .foot__pitch {
    margin: 1.1rem 0 1.4rem;
    max-width: 34ch;
    font-family: var(--font-display);
    font-size: var(--step-1);
    font-family: var(--font-italic);
    font-style: italic;
    color: var(--on-dark-soft);
  }

  .foot__contact {
    display: grid;
    gap: 0.8rem;
    margin: 0 0 1.4rem;
  }

  .foot__contact dt {
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .foot__contact dd {
    margin: 0.15rem 0 0;
    font-size: 0.9rem;
    color: var(--on-dark-soft);
  }

  .foot__contact a:hover {
    color: var(--gold-light);
  }

  .foot__social {
    display: flex;
    gap: 0.5rem;
  }

  .foot__social a {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid rgba(246, 239, 228, 0.25);
    border-radius: 50%;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease),
      border-color 0.3s var(--ease);
  }

  .foot__social svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .foot__social a:hover {
    background: var(--gold);
    border-color: var(--gold);
    color: var(--dark);
  }

  /* --- link columns ---------------------------------------------------- */
  .foot__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1.2rem, 3vw, 2.5rem);
  }

  .foot__col-head {
    font-family: var(--font-sans);
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 1rem;
  }

  .foot__col ul {
    display: grid;
    gap: 0.55rem;
  }

  .foot__col a {
    font-size: 0.86rem;
    font-weight: 300;
    color: var(--on-dark-soft);
    transition: color 0.25s var(--ease), padding-left 0.3s var(--ease);
  }

  .foot__col a:hover {
    color: var(--ivory);
    padding-left: 4px;
  }

  /* --- bottom bar ------------------------------------------------------ */
  .foot__bar {
    border-top: 1px solid rgba(246, 239, 228, 0.14);
  }

  .foot__bar-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    flex-wrap: wrap;
    padding-block: 1.3rem;
    font-size: 0.76rem;
    color: rgba(246, 239, 228, 0.6);
  }

  .foot__pay {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .foot__pay-chips {
    color: var(--gold-light);
    letter-spacing: 0.06em;
  }

  @media (max-width: 900px) {
    .foot__news-inner,
    .foot__main {
      grid-template-columns: 1fr;
    }
    .foot__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 2rem;
    }
  }
</style>

<script>
  /**
   * Newsletter signup.
   *
   * Posts to the Next.js API when it is reachable; otherwise it confirms
   * optimistically so the form is never a dead end on the static build.
   */
  const form = document.querySelector<HTMLFormElement>("[data-newsletter]");
  const msg = document.querySelector<HTMLElement>("[data-newsletter-msg]");

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    const email = new FormData(form).get("email");
    if (msg) msg.textContent = "Adding you…";

    try {
      const base = (import.meta.env.PUBLIC_API_URL as string) || "";
      const res = await fetch(`${base}/api/newsletter`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ email }),
      });
      if (!res.ok) throw new Error(String(res.status));
      if (msg) msg.textContent = "Added. Watch for the next letter.";
      form.reset();
    } catch {
      if (msg) msg.textContent = "Added. Watch for the next letter.";
      form.reset();
    }
  });
</script>

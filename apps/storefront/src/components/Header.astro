---
import Logo from "./Logo.astro";
import {
  colourFacets,
  defaultVariant,
  newArrivals,
  occasionBySlug,
  queryProducts,
  type Product,
  type ProductQuery,
} from "@jaiisha/catalogue";
import { ANNOUNCEMENTS, NAV, SITE } from "../lib/site.ts";

interface Props {
  /** Lay the header over a dark hero until the page scrolls. */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;
const path = Astro.url.pathname;

/*
 * Menu panels. Every top-level item with something to show opens a
 * full-width panel: a row of round, gold-framed photographs, each one a door
 * into that cut of the shop, and the same links again as plain text beneath.
 *
 * Photographs are resolved from the catalogue rather than hard-coded, so a
 * link to "?fabric=organza" always shows the best-selling organza saree and
 * the menu keeps up with the shelf.
 */
interface Tile {
  label: string;
  href: string;
  note?: string;
  image?: string;
}

const modelOf = (product: Product | undefined, colour?: string) => {
  if (!product) return undefined;
  const v = (colour && product.variants.find((x) => x.colour.slug === colour)) || defaultVariant(product);
  return (v.images.find((i) => i.kind === "model") ?? v.images[0])?.src;
};

const imageFor = (href: string): string | undefined => {
  const url = new URL(href, "https://jaiisha.local");
  if (url.pathname.startsWith("/occasion/")) {
    return occasionBySlug(url.pathname.split("/")[2] ?? "")?.image;
  }
  const q: ProductQuery = { sort: "bestsellers", perPage: 1 };
  const get = (k: string) => url.searchParams.get(k) ?? undefined;
  if (get("fabric")) q.fabric = get("fabric") as ProductQuery["fabric"];
  if (get("colour")) q.colour = get("colour");
  if (get("weave")) q.weave = get("weave") as ProductQuery["weave"];
  if (get("price")) q.price = get("price");
  if (get("occasion")) q.occasion = get("occasion") as ProductQuery["occasion"];
  if (url.searchParams.get("sort") === "newest") q.sort = "newest";
  return modelOf(queryProducts(q).items[0], q.colour);
};

const panelFor = (item: (typeof NAV)[number]): Tile[] => {
  if (item.children) {
    return item.children.map((c) => ({ ...c, image: imageFor(c.href) }));
  }
  if (item.href.startsWith("/sarees?sort=newest")) {
    return newArrivals(6).map((p) => ({
      label: p.name.replace(/ Saree$/, ""),
      href: `/sarees/${p.slug}`,
      image: modelOf(p),
    }));
  }
  if (item.href.startsWith("/sarees#colour")) {
    return colourFacets().map((c) => ({
      label: c.name,
      href: `/sarees?colour=${c.slug}`,
      note: `${c.count} designs`,
      image: imageFor(`/sarees?colour=${c.slug}`),
    }));
  }
  return [];
};

const menus = NAV.map((item) => ({ ...item, panel: panelFor(item) }));
---

<div class="announce">
  <div class="announce__track" role="status" aria-live="off">
    {
      ANNOUNCEMENTS.map((line, i) => (
        <span class="announce__item" data-i={i} aria-hidden={i === 0 ? "false" : "true"}>
          {line}
        </span>
      ))
    }
  </div>
</div>

<header class:list={["head", overHero && "head--over"]} data-over-hero={overHero ? "true" : "false"}>
  <div class="head__inner shell">
    <button class="icon-btn head__burger" type="button" aria-label="Open menu" aria-expanded="false" data-menu-open>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
    </button>

    <a href="/" class="head__brand" aria-label={`${SITE.name} — home`}>
      <img
        class="head__logo"
        src="/img/brand/jaiisha-logo.png"
        alt={`${SITE.name} — Banarasi silk sarees`}
        width="353"
        height="240"
        fetchpriority="high"
        decoding="async"
      />
    </a>

    <nav class="head__nav" aria-label="Main">
      <ul class="head__list">
        {
          menus.map((item) => (
            <li class:list={["head__item", item.panel.length > 0 && "has-menu"]}>
              <a
                href={item.href}
                class="head__link"
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
                {item.panel.length > 0 && (
                  <svg class="head__caret" viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M7 10l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                )}
              </a>
              {item.panel.length > 0 && (
                <div class="mega" role="group" aria-label={item.label}>
                  <div class="mega__inner shell">
                    <ul class="mega__tiles" style={`--n:${Math.min(item.panel.length, 8)}`}>
                      {item.panel.map((t, i) => (
                        <li style={`--i:${i}`}>
                          <a href={t.href} class="mega__tile">
                            <span class="mega__ring" aria-hidden="true">
                              <span class="mega__photo">
                                {t.image && (
                                  <img src={t.image} alt="" width="160" height="160" loading="lazy" decoding="async" />
                                )}
                              </span>
                            </span>
                            <span class="mega__label">{t.label}</span>
                            {t.note && <span class="mega__note">{t.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                    <div class="mega__foot">
                      <span class="mega__kicker">{item.label}</span>
                      {item.panel.slice(0, 7).map((t) => (
                        <a href={t.href} class="mega__text">{t.label}</a>
                      ))}
                      <a href={item.href} class="mega__all">View all</a>
                    </div>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="head__tools">
      <button class="icon-btn" type="button" aria-label="Search sarees" data-search-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
      </button>
      <a class="icon-btn" href="/account" aria-label="Your account">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M4.5 20c1.4-3.8 4-5.6 7.5-5.6S18.1 16.2 19.5 20" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
      <a class="icon-btn" href="/wishlist" aria-label="Your wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-9.6A4.4 4.4 0 0 1 12 7.7a4.4 4.4 0 0 1 7.5 2.7c0 5-7.5 9.6-7.5 9.6Z" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        <span class="icon-btn__count" data-wishlist-count hidden>0</span>
      </a>
      <button class="icon-btn" type="button" aria-label="Your shopping bag" data-bag-btn>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 11.5H7L6 8Z" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M9.5 8V6.4a2.5 2.5 0 0 1 5 0V8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        <span class="icon-btn__count" data-bag-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div class="drawer" data-menu hidden>
  <div class="drawer__scrim" data-menu-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer__top">
      <Logo size={1.2} showDescriptor={false} />
      <button class="icon-btn" type="button" aria-label="Close menu" data-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="drawer__list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="drawer__link">{item.label}</a>
              {item.children && (
                <ul class="drawer__sub">
                  {item.children.map((c) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="drawer__foot">
      <a class="btn btn--wa" href={`https://wa.me/${SITE.whatsapp}`}>Order on WhatsApp</a>
      <p class="drawer__meta">{SITE.phoneDisplay}<br />{SITE.email}</p>
    </div>
  </aside>
</div>

<!-- Search overlay -->
<div class="search" data-search hidden>
  <div class="search__scrim" data-search-close></div>
  <div class="search__panel" role="dialog" aria-modal="true" aria-label="Search">
    <form class="search__form" action="/sarees" method="get">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="search__icon"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
      <input
        type="search"
        name="q"
        class="search__input"
        placeholder="Katan silk, kadwa, maroon bridal…"
        aria-label="Search sarees"
        autocomplete="off"
        data-search-input
      />
      <button class="btn btn--gold search__submit" type="submit">Search</button>
    </form>
    <div class="search__hints">
      <span class="eyebrow eyebrow--ink">Popular</span>
      <a href="/sarees?search=kadwa">Kadwa</a>
      <a href="/occasion/wedding-bridal">Bridal</a>
      <a href="/sarees?fabric=organza">Organza</a>
      <a href="/sarees?colour=maroon">Maroon</a>
      <a href="/sarees?price=under-5000">Under ₹5,000</a>
    </div>
  </div>
</div>

<style>
  /* --- announcement bar ------------------------------------------------ */
  .announce {
    position: relative;
    z-index: 60;
    background: var(--wine-deep);
    color: var(--gold-pale);
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .announce__track {
    position: relative;
    height: 2.4rem;
    display: grid;
    place-items: center;
    padding-inline: var(--gutter);
  }

  .announce__item {
    position: absolute;
    opacity: 0;
    translate: 0 6px;
    transition: opacity 0.7s var(--ease), translate 0.7s var(--ease);
    padding-inline: 1rem;
  }

  .announce__item.is-on {
    opacity: 1;
    translate: 0 0;
  }

  /* --- header --------------------------------------------------------- */
  /* Deep wine, the burgundy the logo is woven on, so the mark sits in the
     bar rather than on it. */
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    background:
      radial-gradient(40% 140% at 12% 50%, rgba(122, 30, 52, 0.85), transparent 70%),
      linear-gradient(180deg, #4a0f20, #3a0a18);
    color: var(--gold-pale);
    border-bottom: 1px solid rgba(181, 138, 67, 0.45);
    box-shadow: 0 8px 30px -12px rgba(28, 8, 14, 0.6);
    transition: background-color 0.45s var(--ease), border-color 0.45s var(--ease),
      color 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }

  /* Over a dark hero: transparent until scrolled. The .is-stuck class is
     added by the inline script below once the page leaves the top. */
  .head--over {
    position: fixed;
    inset-inline: 0;
    top: 2.4rem;
    background: transparent;
    border-bottom-color: transparent;
    color: var(--on-dark);
  }

  .head--over :global(.logo__descriptor) {
    color: var(--gold-light);
  }

  .head--over.is-stuck {
    position: fixed;
    top: 0;
    background: rgba(28, 15, 21, 0.86);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: rgba(181, 138, 67, 0.28);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .head__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: stretch;
    gap: 1rem;
    min-height: 5.2rem;
  }

  .head__brand {
    justify-self: start;
    align-self: center;
  }

  /* Transparent artwork, so it sits on the bar as it would on any colour. */
  .head__logo {
    display: block;
    height: 4.8rem;
    width: auto;
  }

  /* Scoped to .head__inner so this beats `.icon-btn { display: grid }`,
     which is declared later with the same specificity. Without it the burger
     stays visible on desktop, making four grid children fight over three
     columns and dropping the tool icons onto a second row. */
  .head__inner .head__burger {
    display: none;
  }

  /* --- nav ------------------------------------------------------------ */
  .head__nav {
    justify-self: center;
  }

  /* Links fill the bar's full height, so the pointer never crosses a gap on
     its way down into a panel. */
  .head__list {
    display: flex;
    align-items: stretch;
    gap: clamp(0.9rem, 1.8vw, 2.1rem);
    height: 100%;
    margin: 0;
  }

  /* Static, so each panel measures from the header and spans its width. */
  .head__item {
    position: static;
    display: flex;
  }

  .head__link {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--gold-pale);
    position: relative;
    transition: color 0.3s var(--ease);
  }

  .head__item:hover .head__link,
  .head__link[aria-current="page"] {
    color: #fff4dc;
  }

  .head__caret {
    width: 0.8rem;
    height: 0.8rem;
    opacity: 0.7;
    transition: rotate 0.35s var(--ease);
  }

  .head__item:hover .head__caret,
  .head__item:focus-within .head__caret {
    rotate: 180deg;
  }

  .head__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.55rem;
    height: 1px;
    background: var(--gold-light);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.45s var(--ease-out-soft);
  }

  .head__item:hover .head__link::after,
  .head__link[aria-current="page"]::after {
    scale: 1 1;
  }

  /* --- menu panels ----------------------------------------------------- */
  .mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 2;
    color: var(--ink);
    background:
      repeating-linear-gradient(45deg, rgba(181, 138, 67, 0.08) 0 1px, transparent 1px 36px),
      repeating-linear-gradient(-45deg, rgba(181, 138, 67, 0.08) 0 1px, transparent 1px 36px),
      linear-gradient(180deg, #f6ecdd, #efe0c9);
    border-top: 2px solid var(--gold);
    border-bottom: 1px solid rgba(181, 138, 67, 0.45);
    box-shadow: 0 30px 60px -20px rgba(36, 19, 25, 0.45);
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    clip-path: inset(0 0 100% 0);
    transition:
      opacity 0.3s var(--ease),
      clip-path 0.55s var(--ease-out-soft),
      visibility 0s linear 0.55s;
  }

  /* A woven border along the panel's foot. */
  .mega::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 5px;
    background: repeating-linear-gradient(90deg, rgba(181, 138, 67, 0.7) 0 6px, transparent 6px 11px);
  }

  .head__item.has-menu:hover .mega,
  .head__item.has-menu:focus-within .mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    clip-path: inset(0 0 0 0);
    transition:
      opacity 0.3s var(--ease),
      clip-path 0.55s var(--ease-out-soft),
      visibility 0s;
  }

  .mega__inner {
    padding-block: 1.8rem 1.6rem;
  }

  .mega__tiles {
    display: grid;
    grid-template-columns: repeat(var(--n), minmax(0, 9.5rem));
    justify-content: center;
    gap: clamp(0.8rem, 2vw, 2rem);
  }

  .mega__tile {
    display: grid;
    justify-items: center;
    gap: 0.55rem;
    text-align: center;
  }

  /* Each tile rises in a beat after the one before when the panel opens. */
  .head__item:hover .mega__tiles > li,
  .head__item:focus-within .mega__tiles > li {
    animation: tileUp 0.6s var(--ease-out-soft) both;
    animation-delay: calc(var(--i) * 45ms + 80ms);
  }

  @keyframes tileUp {
    from {
      opacity: 0;
      translate: 0 12px;
    }
  }

  /* The frame: a gold ring, a ring of zari dots that turns on hover, and a
     lozenge at the crown. */
  .mega__ring {
    position: relative;
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 1;
    border-radius: 50%;
    padding: 9%;
    background:
      radial-gradient(circle, transparent 60%, rgba(181, 138, 67, 0.12) 61%, transparent 72%),
      transparent;
    border: 1px solid rgba(160, 120, 52, 0.75);
  }

  .mega__ring::before {
    content: "";
    position: absolute;
    inset: 4%;
    border-radius: 50%;
    border: 2px dotted rgba(160, 120, 52, 0.75);
    transition: rotate 1.2s var(--ease-out-soft);
  }

  .mega__ring::after {
    content: "";
    position: absolute;
    top: -0.3rem;
    left: 50%;
    width: 0.55rem;
    height: 0.55rem;
    translate: -50% 0;
    rotate: 45deg;
    background: var(--gold);
    box-shadow: 0 0 0 3px #f4e8d6;
  }

  .mega__tile:hover .mega__ring::before {
    rotate: 90deg;
  }

  .mega__photo {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    overflow: hidden;
    border-radius: 50%;
    background: #6a1a2c;
    box-shadow:
      0 0 0 3px #f4e8d6,
      0 0 0 4px rgba(160, 120, 52, 0.6),
      0 12px 24px -10px rgba(66, 20, 36, 0.55);
  }

  .mega__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 18%;
    transition: scale 0.8s var(--ease-out-soft);
  }

  .mega__tile:hover .mega__photo img {
    scale: 1.08;
  }

  .mega__label {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4a1326;
    line-height: 1.35;
  }

  .mega__note {
    margin-top: -0.3rem;
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  .mega__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: center;
    gap: 0.4rem 1.2rem;
    margin-top: 1.5rem;
    padding-top: 1.1rem;
    border-top: 1px solid rgba(160, 120, 52, 0.3);
  }

  .mega__kicker {
    flex-basis: 100%;
    text-align: center;
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .mega__text,
  .mega__all {
    font-family: var(--font-display);
    font-size: 0.95rem;
    color: #4a1326;
    background: linear-gradient(var(--gold), var(--gold)) 0 100% / 0 1px no-repeat;
    transition:
      background-size 0.35s var(--ease-out-soft),
      color 0.25s var(--ease);
  }

  .mega__text:hover,
  .mega__all:hover {
    color: var(--wine);
    background-size: 100% 1px;
  }

  .mega__all {
    font-weight: 600;
  }

  @media (prefers-reduced-motion: reduce) {
    .mega,
    .head__item.has-menu:hover .mega {
      clip-path: none;
      transition: opacity 0.2s, visibility 0s;
    }
    .head__item:hover .mega__tiles > li {
      animation: none;
    }
  }

  /* --- tools ---------------------------------------------------------- */
  .head__tools {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    justify-self: end;
  }

  .icon-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .icon-btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .icon-btn {
    color: var(--gold-pale);
  }

  .icon-btn:hover {
    background: rgba(246, 239, 228, 0.12);
    color: #fff4dc;
  }

  .head--over .icon-btn:hover {
    background: rgba(246, 239, 228, 0.14);
    color: var(--gold-light);
  }

  .icon-btn__count {
    position: absolute;
    top: 0.3rem;
    right: 0.25rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding-inline: 0.25rem;
    border-radius: var(--r-pill);
    background: var(--gold);
    color: #1c0f15;
    font-size: 0.6rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  /* --- drawer --------------------------------------------------------- */
  .drawer,
  .search {
    position: fixed;
    inset: 0;
    z-index: 90;
  }

  .drawer__scrim,
  .search__scrim {
    position: absolute;
    inset: 0;
    background: rgba(28, 15, 21, 0.55);
    backdrop-filter: blur(3px);
    animation: fade 0.3s var(--ease);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .drawer__panel {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: min(21rem, 88vw);
    background: var(--ivory-warm);
    display: flex;
    flex-direction: column;
    padding: 1.2rem var(--gutter) 1.6rem;
    overflow-y: auto;
    animation: slide 0.4s var(--ease-out-soft);
  }

  @keyframes slide {
    from {
      translate: -100% 0;
    }
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .drawer__list {
    padding-block: 1rem;
  }

  .drawer__link {
    display: block;
    padding: 0.7rem 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .drawer__sub {
    padding-bottom: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .drawer__sub a {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .drawer__foot {
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.9rem;
  }

  .drawer__meta {
    font-size: 0.78rem;
    color: var(--ink-faint);
    line-height: 1.8;
  }

  /* --- search --------------------------------------------------------- */
  .search__panel {
    position: absolute;
    inset-inline: 0;
    top: 0;
    background: var(--ivory-warm);
    padding: clamp(1.5rem, 5vw, 3rem) var(--gutter);
    animation: drop 0.4s var(--ease-out-soft);
  }

  @keyframes drop {
    from {
      translate: 0 -100%;
    }
  }

  .search__form {
    max-width: var(--max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.9rem;
  }

  .search__icon {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--ink-faint);
    flex: none;
  }

  .search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    padding-block: 0.2rem;
  }

  .search__input::placeholder {
    color: var(--ink-faint);
    opacity: 0.7;
  }

  .search__submit {
    flex: none;
  }

  .search__hints {
    max-width: var(--max);
    margin: 1.1rem auto 0;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
  }

  .search__hints a {
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
  }

  .search__hints a:hover {
    color: var(--wine);
    border-color: var(--wine);
  }

  /* --- responsive ----------------------------------------------------- */
  @media (max-width: 1080px) {
    .head__nav {
      display: none;
    }
    .head__inner .head__burger {
      display: grid;
    }
    .head__inner {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      min-height: 4.2rem;
    }
    .head__brand {
      justify-self: center;
    }
    .head__logo {
      height: 3.7rem;
    }
  }

  @media (max-width: 560px) {
    .head__tools .icon-btn:nth-child(2) {
      display: none; /* account moves into the drawer */
    }
    .search__submit {
      display: none;
    }
  }
</style>

<script>
  // --- announcement rotation -------------------------------------------
  const items = Array.from(document.querySelectorAll<HTMLElement>(".announce__item"));
  if (items.length) {
    let i = 0;
    const show = (n: number) => {
      items.forEach((el, k) => {
        el.classList.toggle("is-on", k === n);
        el.setAttribute("aria-hidden", k === n ? "false" : "true");
      });
    };
    show(0);
    if (items.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(() => {
        i = (i + 1) % items.length;
        show(i);
      }, 4200);
    }
  }

  // --- header state over the hero ---------------------------------------
  const head = document.querySelector<HTMLElement>(".head");
  if (head?.dataset.overHero === "true") {
    const onScroll = () => head.classList.toggle("is-stuck", window.scrollY > 24);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // --- menu panels: fetch their photographs on first approach -----------
  // They are lazy, and a lazy image inside a hidden panel never starts
  // loading until the panel opens; start them as soon as the pointer
  // reaches the bar so the panel opens full.
  const nav = document.querySelector<HTMLElement>(".head__nav");
  const warm = () => nav?.querySelectorAll<HTMLImageElement>(".mega img").forEach((img) => (img.loading = "eager"));
  nav?.addEventListener("pointerenter", warm, { once: true });
  nav?.addEventListener("focusin", warm, { once: true });

  // --- overlays ---------------------------------------------------------
  const openOverlay = (el: HTMLElement | null) => {
    if (!el) return;
    el.hidden = false;
    document.body.classList.add("no-scroll");
  };
  const closeOverlay = (el: HTMLElement | null) => {
    if (!el) return;
    el.hidden = true;
    document.body.classList.remove("no-scroll");
  };

  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const search = document.querySelector<HTMLElement>("[data-search]");

  document.querySelector("[data-menu-open]")?.addEventListener("click", () => openOverlay(menu));
  document.querySelectorAll("[data-menu-close]").forEach((b) =>
    b.addEventListener("click", () => closeOverlay(menu)),
  );
  document.querySelector("[data-search-open]")?.addEventListener("click", () => {
    openOverlay(search);
    search?.querySelector<HTMLInputElement>("[data-search-input]")?.focus();
  });
  document.querySelectorAll("[data-search-close]").forEach((b) =>
    b.addEventListener("click", () => closeOverlay(search)),
  );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeOverlay(menu);
      closeOverlay(search);
    }
    // "/" focuses search, the way a catalogue should behave.
    if (e.key === "/" && !["INPUT", "TEXTAREA"].includes((e.target as HTMLElement)?.tagName)) {
      e.preventDefault();
      openOverlay(search);
      search?.querySelector<HTMLInputElement>("[data-search-input]")?.focus();
    }
  });

  // --- wishlist / bag counts (localStorage until Phase 2) ---------------
  const paintCount = (sel: string, key: string) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (!el) return;
    let n = 0;
    try {
      const items = JSON.parse(localStorage.getItem(key) || "[]");
      if (Array.isArray(items)) {
        if (items.length > 0 && typeof items[0] === "object" && items[0] !== null && "quantity" in items[0]) {
          n = items.reduce((sum: number, item: any) => sum + (Number(item.quantity) || 1), 0);
        } else {
          n = items.length;
        }
      }
    } catch {
      n = 0;
    }
    el.textContent = String(n);
    el.hidden = n === 0;
  };
  const paintAll = () => {
    paintCount("[data-wishlist-count]", "jaiisha:wishlist");
    paintCount("[data-bag-count]", "jaiisha:bag");
  };
  paintAll();
  window.addEventListener("jaiisha:store", paintAll);

  // Bag button opens slide-over drawer or navigates to /bag
  document.querySelector("[data-bag-btn]")?.addEventListener("click", () => {
    if ((window as any).jaiishaCart?.open) {
      (window as any).jaiishaCart.open();
    } else {
      window.location.href = "/bag";
    }
  });
</script>

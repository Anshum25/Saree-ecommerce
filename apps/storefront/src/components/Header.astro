---
import Logo from "./Logo.astro";
import { ANNOUNCEMENTS, NAV, SITE } from "../lib/site.ts";

interface Props {
  /** Lay the header over a dark hero until the page scrolls. */
  overHero?: boolean;
}
const { overHero = false } = Astro.props;
const path = Astro.url.pathname;
---

<div class="announce">
  <div class="announce__track" role="status" aria-live="off">
    {
      ANNOUNCEMENTS.map((line, i) => (
        <span class="announce__item" data-i={i} aria-hidden={i === 0 ? "false" : "true"}>
          {line}
        </span>
      ))
    }
  </div>
</div>

<header class:list={["head", overHero && "head--over"]} data-over-hero={overHero ? "true" : "false"}>
  <div class="head__inner shell">
    <button class="icon-btn head__burger" type="button" aria-label="Open menu" aria-expanded="false" data-menu-open>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
    </button>

    <a href="/" class="head__brand" aria-label={`${SITE.name} — home`}>
      <Logo size={1.45} />
    </a>

    <nav class="head__nav" aria-label="Main">
      <ul class="head__list">
        {
          NAV.map((item) => (
            <li class:list={["head__item", item.children && "has-menu"]}>
              <a
                href={item.href}
                class="head__link"
                aria-current={path === item.href ? "page" : undefined}
              >
                {item.label}
              </a>
              {item.children && (
                <div class="mega" role="group">
                  <div class="mega__inner">
                    <ul class="mega__list">
                      {item.children.map((child) => (
                        <li>
                          <a href={child.href} class="mega__link">
                            <span class="mega__label">{child.label}</span>
                            {child.note && <span class="mega__note">{child.note}</span>}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </div>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="head__tools">
      <button class="icon-btn" type="button" aria-label="Search sarees" data-search-open>
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
      </button>
      <a class="icon-btn" href="/account" aria-label="Your account">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.8" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M4.5 20c1.4-3.8 4-5.6 7.5-5.6S18.1 16.2 19.5 20" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
      </a>
      <a class="icon-btn" href="/wishlist" aria-label="Your wishlist">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-9.6A4.4 4.4 0 0 1 12 7.7a4.4 4.4 0 0 1 7.5 2.7c0 5-7.5 9.6-7.5 9.6Z" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        <span class="icon-btn__count" data-wishlist-count hidden>0</span>
      </a>
      <button class="icon-btn" type="button" aria-label="Your shopping bag" data-bag-btn>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 11.5H7L6 8Z" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M9.5 8V6.4a2.5 2.5 0 0 1 5 0V8" fill="none" stroke="currentColor" stroke-width="1.4" /></svg>
        <span class="icon-btn__count" data-bag-count hidden>0</span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile drawer -->
<div class="drawer" data-menu hidden>
  <div class="drawer__scrim" data-menu-close></div>
  <aside class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer__top">
      <Logo size={1.2} showDescriptor={false} />
      <button class="icon-btn" type="button" aria-label="Close menu" data-menu-close>
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
      </button>
    </div>
    <nav aria-label="Mobile">
      <ul class="drawer__list">
        {
          NAV.map((item) => (
            <li>
              <a href={item.href} class="drawer__link">{item.label}</a>
              {item.children && (
                <ul class="drawer__sub">
                  {item.children.map((c) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="drawer__foot">
      <a class="btn btn--wa" href={`https://wa.me/${SITE.whatsapp}`}>Order on WhatsApp</a>
      <p class="drawer__meta">{SITE.phoneDisplay}<br />{SITE.email}</p>
    </div>
  </aside>
</div>

<!-- Search overlay -->
<div class="search" data-search hidden>
  <div class="search__scrim" data-search-close></div>
  <div class="search__panel" role="dialog" aria-modal="true" aria-label="Search">
    <form class="search__form" action="/sarees" method="get">
      <svg viewBox="0 0 24 24" aria-hidden="true" class="search__icon"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.4" /><path d="M16 16l4.5 4.5" stroke="currentColor" stroke-width="1.4" fill="none" /></svg>
      <input
        type="search"
        name="q"
        class="search__input"
        placeholder="Katan silk, kadwa, maroon bridal…"
        aria-label="Search sarees"
        autocomplete="off"
        data-search-input
      />
      <button class="btn btn--gold search__submit" type="submit">Search</button>
    </form>
    <div class="search__hints">
      <span class="eyebrow eyebrow--ink">Popular</span>
      <a href="/sarees?search=kadwa">Kadwa</a>
      <a href="/occasion/wedding-bridal">Bridal</a>
      <a href="/sarees?fabric=organza">Organza</a>
      <a href="/sarees?colour=maroon">Maroon</a>
      <a href="/sarees?price=under-5000">Under ₹5,000</a>
    </div>
  </div>
</div>

<style>
  /* --- announcement bar ------------------------------------------------ */
  .announce {
    position: relative;
    z-index: 60;
    background: var(--wine-deep);
    color: var(--gold-pale);
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .announce__track {
    position: relative;
    height: 2.4rem;
    display: grid;
    place-items: center;
    padding-inline: var(--gutter);
  }

  .announce__item {
    position: absolute;
    opacity: 0;
    translate: 0 6px;
    transition: opacity 0.7s var(--ease), translate 0.7s var(--ease);
    padding-inline: 1rem;
  }

  .announce__item.is-on {
    opacity: 1;
    translate: 0 0;
  }

  /* --- header --------------------------------------------------------- */
  .head {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--ivory-warm);
    border-bottom: 1px solid var(--line);
    transition: background-color 0.45s var(--ease), border-color 0.45s var(--ease),
      color 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }

  /* Over a dark hero: transparent until scrolled. The .is-stuck class is
     added by the inline script below once the page leaves the top. */
  .head--over {
    position: fixed;
    inset-inline: 0;
    top: 2.4rem;
    background: transparent;
    border-bottom-color: transparent;
    color: var(--on-dark);
  }

  .head--over :global(.logo__descriptor) {
    color: var(--gold-light);
  }

  .head--over.is-stuck {
    position: fixed;
    top: 0;
    background: rgba(28, 15, 21, 0.86);
    backdrop-filter: blur(14px) saturate(1.2);
    border-bottom-color: rgba(181, 138, 67, 0.28);
    box-shadow: 0 10px 40px rgba(0, 0, 0, 0.3);
  }

  .head__inner {
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: 1rem;
    min-height: 4.6rem;
  }

  .head__brand {
    justify-self: start;
  }

  /* Scoped to .head__inner so this beats `.icon-btn { display: grid }`,
     which is declared later with the same specificity. Without it the burger
     stays visible on desktop, making four grid children fight over three
     columns and dropping the tool icons onto a second row. */
  .head__inner .head__burger {
    display: none;
  }

  /* --- nav ------------------------------------------------------------ */
  .head__nav {
    justify-self: center;
  }

  .head__list {
    display: flex;
    align-items: center;
    gap: clamp(0.9rem, 1.8vw, 2.1rem);
    margin: 0;
  }

  .head__item {
    position: relative;
  }

  .head__link {
    display: inline-block;
    padding: 1.6rem 0;
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
    position: relative;
  }

  .head__link::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.25rem;
    height: 1px;
    background: var(--gold);
    scale: 0 1;
    transform-origin: left;
    transition: scale 0.45s var(--ease-out-soft);
  }

  .head__item:hover .head__link::after,
  .head__link[aria-current="page"]::after {
    scale: 1 1;
  }

  /* --- mega menu ------------------------------------------------------ */
  .mega {
    position: absolute;
    top: 100%;
    left: 50%;
    translate: -50% 0;
    padding-top: 0.25rem;
    opacity: 0;
    visibility: hidden;
    pointer-events: none;
    transition: opacity 0.3s var(--ease), translate 0.35s var(--ease), visibility 0.3s;
  }

  .head__item.has-menu:hover .mega,
  .head__item.has-menu:focus-within .mega {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    translate: -50% 0;
  }

  .mega__inner {
    min-width: 19rem;
    background: var(--surface);
    color: var(--ink);
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    box-shadow: var(--shadow-lg);
    padding: 0.6rem;
  }

  .mega__link {
    display: flex;
    flex-direction: column;
    gap: 0.1rem;
    padding: 0.6rem 0.85rem;
    transition: background-color 0.25s var(--ease);
  }

  .mega__link:hover {
    background: var(--bg-sunk);
  }

  .mega__label {
    font-size: 0.86rem;
    letter-spacing: 0.04em;
  }

  .mega__note {
    font-size: 0.72rem;
    color: var(--ink-faint);
  }

  /* --- tools ---------------------------------------------------------- */
  .head__tools {
    display: flex;
    align-items: center;
    gap: 0.15rem;
    justify-self: end;
  }

  .icon-btn {
    position: relative;
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .icon-btn svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .icon-btn:hover {
    background: rgba(101, 29, 53, 0.08);
    color: var(--wine);
  }

  .head--over .icon-btn:hover {
    background: rgba(246, 239, 228, 0.14);
    color: var(--gold-light);
  }

  .icon-btn__count {
    position: absolute;
    top: 0.3rem;
    right: 0.25rem;
    min-width: 1.05rem;
    height: 1.05rem;
    padding-inline: 0.25rem;
    border-radius: var(--r-pill);
    background: var(--gold);
    color: #1c0f15;
    font-size: 0.6rem;
    font-weight: 700;
    display: grid;
    place-items: center;
  }

  /* --- drawer --------------------------------------------------------- */
  .drawer,
  .search {
    position: fixed;
    inset: 0;
    z-index: 90;
  }

  .drawer__scrim,
  .search__scrim {
    position: absolute;
    inset: 0;
    background: rgba(28, 15, 21, 0.55);
    backdrop-filter: blur(3px);
    animation: fade 0.3s var(--ease);
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  .drawer__panel {
    position: absolute;
    inset-block: 0;
    left: 0;
    width: min(21rem, 88vw);
    background: var(--ivory-warm);
    display: flex;
    flex-direction: column;
    padding: 1.2rem var(--gutter) 1.6rem;
    overflow-y: auto;
    animation: slide 0.4s var(--ease-out-soft);
  }

  @keyframes slide {
    from {
      translate: -100% 0;
    }
  }

  .drawer__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--line);
  }

  .drawer__list {
    padding-block: 1rem;
  }

  .drawer__link {
    display: block;
    padding: 0.7rem 0 0.35rem;
    font-family: var(--font-display);
    font-size: 1.35rem;
  }

  .drawer__sub {
    padding-bottom: 0.8rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 0.9rem;
  }

  .drawer__sub a {
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .drawer__foot {
    margin-top: auto;
    padding-top: 1.2rem;
    border-top: 1px solid var(--line);
    display: grid;
    gap: 0.9rem;
  }

  .drawer__meta {
    font-size: 0.78rem;
    color: var(--ink-faint);
    line-height: 1.8;
  }

  /* --- search --------------------------------------------------------- */
  .search__panel {
    position: absolute;
    inset-inline: 0;
    top: 0;
    background: var(--ivory-warm);
    padding: clamp(1.5rem, 5vw, 3rem) var(--gutter);
    animation: drop 0.4s var(--ease-out-soft);
  }

  @keyframes drop {
    from {
      translate: 0 -100%;
    }
  }

  .search__form {
    max-width: var(--max);
    margin-inline: auto;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 0.9rem;
  }

  .search__icon {
    width: 1.3rem;
    height: 1.3rem;
    color: var(--ink-faint);
    flex: none;
  }

  .search__input {
    flex: 1;
    min-width: 0;
    border: 0;
    background: none;
    font-family: var(--font-display);
    font-size: var(--step-2);
    padding-block: 0.2rem;
  }

  .search__input::placeholder {
    color: var(--ink-faint);
    opacity: 0.7;
  }

  .search__submit {
    flex: none;
  }

  .search__hints {
    max-width: var(--max);
    margin: 1.1rem auto 0;
    display: flex;
    align-items: center;
    gap: 0.9rem;
    flex-wrap: wrap;
    font-size: 0.82rem;
  }

  .search__hints a {
    color: var(--ink-soft);
    border-bottom: 1px solid var(--line-strong);
    padding-bottom: 2px;
  }

  .search__hints a:hover {
    color: var(--wine);
    border-color: var(--wine);
  }

  /* --- responsive ----------------------------------------------------- */
  @media (max-width: 1080px) {
    .head__nav {
      display: none;
    }
    .head__inner .head__burger {
      display: grid;
    }
    .head__inner {
      grid-template-columns: auto 1fr auto;
      min-height: 4rem;
    }
    .head__brand {
      justify-self: center;
    }
  }

  @media (max-width: 560px) {
    .head__tools .icon-btn:nth-child(2) {
      display: none; /* account moves into the drawer */
    }
    .search__submit {
      display: none;
    }
  }
</style>

<script>
  // --- announcement rotation -------------------------------------------
  const items = Array.from(document.querySelectorAll<HTMLElement>(".announce__item"));
  if (items.length) {
    let i = 0;
    const show = (n: number) => {
      items.forEach((el, k) => {
        el.classList.toggle("is-on", k === n);
        el.setAttribute("aria-hidden", k === n ? "false" : "true");
      });
    };
    show(0);
    if (items.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
      setInterval(() => {
        i = (i + 1) % items.length;
        show(i);
      }, 4200);
    }
  }

  // --- header state over the hero ---------------------------------------
  const head = document.querySelector<HTMLElement>(".head");
  if (head?.dataset.overHero === "true") {
    const onScroll = () => head.classList.toggle("is-stuck", window.scrollY > 24);
    onScroll();
    window.addEventListener("scroll", onScroll, { passive: true });
  }

  // --- overlays ---------------------------------------------------------
  const openOverlay = (el: HTMLElement | null) => {
    if (!el) return;
    el.hidden = false;
    document.body.classList.add("no-scroll");
  };
  const closeOverlay = (el: HTMLElement | null) => {
    if (!el) return;
    el.hidden = true;
    document.body.classList.remove("no-scroll");
  };

  const menu = document.querySelector<HTMLElement>("[data-menu]");
  const search = document.querySelector<HTMLElement>("[data-search]");

  document.querySelector("[data-menu-open]")?.addEventListener("click", () => openOverlay(menu));
  document.querySelectorAll("[data-menu-close]").forEach((b) =>
    b.addEventListener("click", () => closeOverlay(menu)),
  );
  document.querySelector("[data-search-open]")?.addEventListener("click", () => {
    openOverlay(search);
    search?.querySelector<HTMLInputElement>("[data-search-input]")?.focus();
  });
  document.querySelectorAll("[data-search-close]").forEach((b) =>
    b.addEventListener("click", () => closeOverlay(search)),
  );

  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      closeOverlay(menu);
      closeOverlay(search);
    }
    // "/" focuses search, the way a catalogue should behave.
    if (e.key === "/" && !["INPUT", "TEXTAREA"].includes((e.target as HTMLElement)?.tagName)) {
      e.preventDefault();
      openOverlay(search);
      search?.querySelector<HTMLInputElement>("[data-search-input]")?.focus();
    }
  });

  // --- wishlist / bag counts (localStorage until Phase 2) ---------------
  const paintCount = (sel: string, key: string) => {
    const el = document.querySelector<HTMLElement>(sel);
    if (!el) return;
    let n = 0;
    try {
      const items = JSON.parse(localStorage.getItem(key) || "[]");
      if (Array.isArray(items)) {
        if (items.length > 0 && typeof items[0] === "object" && items[0] !== null && "quantity" in items[0]) {
          n = items.reduce((sum: number, item: any) => sum + (Number(item.quantity) || 1), 0);
        } else {
          n = items.length;
        }
      }
    } catch {
      n = 0;
    }
    el.textContent = String(n);
    el.hidden = n === 0;
  };
  const paintAll = () => {
    paintCount("[data-wishlist-count]", "jaiisha:wishlist");
    paintCount("[data-bag-count]", "jaiisha:bag");
  };
  paintAll();
  window.addEventListener("jaiisha:store", paintAll);

  // Bag button opens slide-over drawer or navigates to /bag
  document.querySelector("[data-bag-btn]")?.addEventListener("click", () => {
    if ((window as any).jaiishaCart?.open) {
      (window as any).jaiishaCart.open();
    } else {
      window.location.href = "/bag";
    }
  });
</script>

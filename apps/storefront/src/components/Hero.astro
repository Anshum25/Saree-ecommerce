---
import { OCCASIONS } from "@jaiisha/catalogue";

/**
 * Hero — the cinema.
 *
 * One photograph fills the whole first screen, edge to edge, and the words sit
 * over it on a wash of wine silk. Five occasions take turns. Each new
 * photograph does not fade in: it falls into place in six vertical pleats,
 * alternately from above and below, the way the pleats of a saree drop when
 * it is let go — the one transition on the page that could only belong to a
 * saree shop.
 *
 *   left        the claim, and the line of tradition for the live occasion
 *   right edge  the occasion's name in Hindi, drawn tall and hollow in gold
 *   foot        five numbered occasions, each with its clock, then the ticker
 *
 * One index drives all of it. Scenes come from the catalogue taxonomy
 * (OCCASIONS), so the copy cannot drift from the shop. Under
 * prefers-reduced-motion nothing advances on its own and nothing decorative
 * moves; the occasions still change when chosen.
 */

/* Each occasion's name as it is said at home. */
const DEVA: Record<string, string> = {
  "wedding-bridal": "विवाह",
  festive: "त्योहार",
  "party-celebration": "उत्सव",
  "traditional-functions": "पूजा",
  gifting: "उपहार",
};

const scenes = OCCASIONS.map((o) => ({
  slug: o.slug,
  name: o.name,
  tradition: o.tradition,
  accent: o.accent,
  image: o.image,
  imageAlt: o.imageAlt,
  deva: DEVA[o.slug] ?? o.name,
}));

/* The pleats a photograph falls in as. */
const PLEATS = 6;

/* The ticker: what the cloth carries, in the language it carries it in. */
const values = [
  { deva: "अखण्ड", en: "Unstitched, and therefore whole" },
  { deva: "सौभाग्य", en: "Red for a long married life" },
  { deva: "शुद्ध", en: "Pure silk, fit for a temple" },
  { deva: "गंगा", en: "Woven on the banks of the Ganga" },
  { deva: "विरासत", en: "Inherited, never replaced" },
  { deva: "सोलह शृंगार", en: "The first of a bride's adornments" },
  { deva: "हस्तकला", en: "Two weavers, three weeks, one saree" },
];

const zariWord = "remember".split("");
const pad = (n: number) => String(n).padStart(2, "0");
---

<!-- ================= the drape =================
     Shown on every load: a length of wine silk with zari borders covers the
     screen, then is drawn off to the right to reveal the page. Pure CSS, so
     it always finishes even if the script below never runs. -->
<div class="drape" aria-hidden="true">
  <div class="drape__cloth">
    <span class="drape__border drape__border--top"></span>
    <div class="drape__mark">
      <img
        class="drape__logo"
        src="/img/brand/jaiisha-logo-full.png"
        alt=""
        width="768"
        height="522"
        fetchpriority="high"
        decoding="async"
      />
      <span class="drape__deva">छह गज़ की विरासत</span>
      <span class="drape__rule"></span>
      <span class="drape__en">Six yards of inheritance</span>
    </div>
    <span class="drape__border drape__border--bottom"></span>
  </div>
  <span class="drape__edge"></span>
</div>
<script is:inline>
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.setAttribute("data-hero-intro", "seen");
  }
</script>


<section class="hero" aria-labelledby="hero-title" data-hero style={`--accent:${scenes[0].accent}`}>
  <!-- ================= the picture: one layer per occasion, cut into pleats ================= -->
  <div class="screen" aria-hidden="true">
    {
      scenes.map((s, i) => (
        <div class:list={["layer", i === 0 && "is-on"]} data-layer={i}>
          {Array.from({ length: PLEATS }).map((_, p) => (
            <div class="pleat" style={`--p:${p}`}>
              <img
                src={s.image}
                alt=""
                width="1600"
                height="2400"
                fetchpriority={i === 0 ? "high" : "low"}
                decoding="async"
              />
            </div>
          ))}
        </div>
      ))
    }
    <div class="screen__shade"></div>
    <div class="screen__grain"></div>
  </div>

  <!-- The live photograph, described once for screen readers. -->
  <p class="visually-hidden" data-alt>{scenes[0].imageAlt}</p>

  <!-- ================= the words ================= -->
  <div class="shell hero__grid">
    <div class="copy">
      <p class="copy__eyebrow rise" style="--d:0ms">
        <span class="copy__dot" aria-hidden="true"></span>
        Handwoven in Varanasi, since the 1400s
      </p>

      <h1 class="copy__title" id="hero-title">
        <span class="line"><span class="line__in" style="--d:80ms">For the days</span></span>
        <span class="line"
          ><span class="line__in" style="--d:190ms"
            >you'll <em class="zari" aria-label="remember"
              >{zariWord.map((c, i) => <span class="zari__c" style={`--c:${i}`} aria-hidden="true">{c}</span>)}</em
            >,</span
          ></span
        >
        <span class="line"><span class="line__in" style="--d:300ms">silk you'll keep.</span></span>
      </h1>

      <div class="now rise" style="--d:460ms">
        <p class="now__label">
          Worn today for
          <span class="now__name" data-name>{scenes[0].name}</span>
        </p>
        <p class="now__tradition" data-tradition>{scenes[0].tradition}</p>
      </div>

      <div class="copy__actions rise" style="--d:600ms">
        <a class="btn btn--gold copy__cta" href={`/occasion/${scenes[0].slug}`} data-link>
          <span data-link-label>Shop {scenes[0].name.toLowerCase()}</span>
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg
          >
        </a>
        <a class="btn copy__alt" href="/sarees">Every saree</a>
      </div>
    </div>

    <!-- The occasion's name in Hindi, tall and hollow, down the right edge. -->
    <div class="deva" aria-hidden="true">
      {
        scenes.map((s, i) => (
          <span class:list={["deva__word", i === 0 && "is-on"]} data-deva={i} lang="hi">
            {s.deva}
          </span>
        ))
      }
    </div>
  </div>

  <!-- ================= the occasions ================= -->
  <div class="shell reel rise" style="--d:720ms">
    <div class="reel__list" role="tablist" aria-label="Choose an occasion" data-tabs>
      {
        scenes.map((s, i) => (
          <button
            type="button"
            role="tab"
            class="reel__tab"
            aria-selected={i === 0 ? "true" : "false"}
            tabindex={i === 0 ? "0" : "-1"}
            data-tab={i}
          >
            <span class="reel__clock" aria-hidden="true"><i /></span>
            <span class="reel__no">{pad(i + 1)}</span>
            <span class="reel__name">{s.name}</span>
          </button>
        ))
      }
    </div>
    <div class="reel__nav">
      <button class="reel__arrow" type="button" aria-label="Previous occasion" data-step="-1">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 6l-6 6 6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
      <button class="reel__arrow" type="button" aria-label="Next occasion" data-step="1">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
      </button>
    </div>
  </div>

  <!-- ================= the ticker ================= -->
  <div class="values" aria-label="What a Banarasi carries">
    <div class="values__track">
      {
        [0, 1].map((dup) => (
          <ul class="values__list" aria-hidden={dup === 1 ? "true" : "false"}>
            {values.map((v) => (
              <li>
                <span class="values__deva" lang="hi">{v.deva}</span>
                <span class="values__en">{v.en}</span>
                <span class="values__sep" aria-hidden="true">◆</span>
              </li>
            ))}
          </ul>
        ))
      }
    </div>
  </div>

  <script
    type="application/json"
    data-scenes
    set:html={JSON.stringify(
      scenes.map((s) => ({
        slug: s.slug,
        name: s.name,
        tradition: s.tradition,
        accent: s.accent,
        alt: s.imageAlt,
      })),
    )}
  />
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero) return;

    type Scene = { slug: string; name: string; tradition: string; accent: string; alt: string };
    let scenes: Scene[] = [];
    try {
      scenes = JSON.parse(hero.querySelector("[data-scenes]")?.textContent ?? "[]") as Scene[];
    } catch {
      return;
    }
    if (scenes.length < 2) return;

    const layers = [...hero.querySelectorAll<HTMLElement>("[data-layer]")];
    const tabs = [...hero.querySelectorAll<HTMLButtonElement>("[data-tab]")];
    const words = [...hero.querySelectorAll<HTMLElement>("[data-deva]")];
    const name = hero.querySelector<HTMLElement>("[data-name]");
    const tradition = hero.querySelector<HTMLElement>("[data-tradition]");
    const alt = hero.querySelector<HTMLElement>("[data-alt]");
    const link = hero.querySelector<HTMLAnchorElement>("[data-link]");
    const linkLabel = hero.querySelector<HTMLElement>("[data-link-label]");

    /* Matches the tab clock's fill duration in CSS. */
    const HOLD = 7000;
    let index = 0;
    let timer = 0;
    let swap = 0;
    let paused = false;

    const replay = (el: HTMLElement | null | undefined) => {
      if (!el) return;
      el.style.animation = "none";
      void el.offsetWidth;
      el.style.animation = "";
    };

    const stop = () => {
      window.clearTimeout(timer);
      timer = 0;
    };

    const start = () => {
      stop();
      if (reduce.matches || document.hidden || paused) return;
      timer = window.setTimeout(() => show(index + 1), HOLD);
    };

    const show = (next: number) => {
      const prev = index;
      index = ((next % scenes.length) + scenes.length) % scenes.length;
      if (index === prev) return start();
      const scene = scenes[index];

      /* The outgoing photograph stays beneath while the new one's pleats fall. */
      layers.forEach((el, i) => {
        el.classList.toggle("is-prev", i === prev);
        el.classList.toggle("is-on", i === index);
      });
      words.forEach((el, i) => {
        el.classList.toggle("is-on", i === index);
        el.classList.toggle("is-out", i === prev);
      });
      tabs.forEach((el, i) => {
        const on = i === index;
        el.setAttribute("aria-selected", on ? "true" : "false");
        el.tabIndex = on ? 0 : -1;
      });
      replay(tabs[index]?.querySelector<HTMLElement>(".reel__clock i"));

      /* After the first scene, pleats fall the moment they are asked to. */
      hero.style.setProperty("--pd", "0s");
      hero.style.setProperty("--accent", scene.accent);
      if (alt) alt.textContent = scene.alt;
      if (link) link.href = `/occasion/${scene.slug}`;
      if (linkLabel) linkLabel.textContent = `Shop ${scene.name.toLowerCase()}`;

      window.clearTimeout(swap);
      name?.classList.add("is-out");
      tradition?.classList.add("is-out");
      swap = window.setTimeout(() => {
        if (name) name.textContent = scene.name;
        if (tradition) tradition.textContent = scene.tradition;
        name?.classList.remove("is-out");
        tradition?.classList.remove("is-out");
      }, 280);

      start();
    };

    tabs.forEach((tab, i) => tab.addEventListener("click", () => show(i)));
    hero.querySelectorAll<HTMLButtonElement>("[data-step]").forEach((b) =>
      b.addEventListener("click", () => show(index + Number(b.dataset.step))),
    );
    hero.querySelector("[data-tabs]")?.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      if (ev.key !== "ArrowRight" && ev.key !== "ArrowLeft") return;
      ev.preventDefault();
      show(index + (ev.key === "ArrowRight" ? 1 : -1));
      tabs[index]?.focus();
    });

    /* Hold still while someone is reading. */
    const copy = hero.querySelector<HTMLElement>(".copy");
    [copy, hero.querySelector<HTMLElement>(".reel")].forEach((el) => {
      el?.addEventListener("pointerenter", () => {
        paused = true;
        hero.classList.add("is-paused");
        stop();
      });
      el?.addEventListener("pointerleave", () => {
        paused = false;
        hero.classList.remove("is-paused");
        replay(tabs[index]?.querySelector<HTMLElement>(".reel__clock i"));
        start();
      });
    });

    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    reduce.addEventListener("change", start);

    /* Hold the first scene until the drape has cleared. */
    const intro = document.documentElement.getAttribute("data-hero-intro") === "seen" ? 0 : 1400;
    window.setTimeout(() => {
      replay(tabs[0]?.querySelector<HTMLElement>(".reel__clock i"));
      start();
    }, intro);
  })();

  /* The photograph drifts a little against the cursor. */
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero || reduce.matches || !window.matchMedia("(pointer: fine)").matches) return;
    let frame = 0;
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      const x = ((e.clientX - r.left) / r.width) * 2 - 1;
      const y = ((e.clientY - r.top) / r.height) * 2 - 1;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        hero.style.setProperty("--mx", x.toFixed(3));
        hero.style.setProperty("--my", y.toFixed(3));
      });
    });
    hero.addEventListener("pointerleave", () => {
      hero.style.setProperty("--mx", "0");
      hero.style.setProperty("--my", "0");
    });
  })();
</script>

<style>
  /* ================================================================= *
   * the drape
   * ================================================================= */
  .drape {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    animation: drapeGone 0s linear 1.75s forwards;
  }

  :global(:root[data-hero-intro="seen"]) .drape {
    display: none;
  }

  @keyframes drapeGone {
    to {
      visibility: hidden;
    }
  }

  .drape__cloth {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background:
      repeating-linear-gradient(45deg, rgba(217, 184, 114, 0.08) 0 1px, transparent 1px 34px),
      repeating-linear-gradient(-45deg, rgba(217, 184, 114, 0.08) 0 1px, transparent 1px 34px),
      radial-gradient(70% 60% at 50% 50%, #7a2442, #3f1020 80%);
    clip-path: inset(0 0 0 0);
    animation: drawOff 0.85s cubic-bezier(0.77, 0, 0.18, 1) 0.9s forwards;
  }

  /* The cloth is pulled away to the right, the way a saree is drawn off a
     shop counter to show its length. */
  @keyframes drawOff {
    to {
      clip-path: inset(0 0 0 100%);
    }
  }

  /* A bright zari selvedge riding the edge of the cloth as it goes. */
  .drape__edge {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 10px;
    background: linear-gradient(90deg, transparent, var(--gold-light), #fff6e2, var(--gold-light), transparent);
    box-shadow: 0 0 40px 8px rgba(217, 184, 114, 0.55);
    opacity: 0;
    animation: edgeRun 0.85s cubic-bezier(0.77, 0, 0.18, 1) 0.9s forwards;
  }

  @keyframes edgeRun {
    0% {
      left: 0;
      opacity: 1;
    }
    92% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  .drape__border {
    height: clamp(1.4rem, 3vh, 2.2rem);
    background:
      repeating-linear-gradient(90deg, rgba(28, 15, 21, 0.55) 0 2px, transparent 2px 14px),
      linear-gradient(180deg, #8a6626, var(--gold-light) 30%, #fff1cf 50%, var(--gold-light) 70%, #8a6626);
    background-size: 200% 100%, 100% 100%;
    animation: weave 1.6s linear infinite;
  }

  @keyframes weave {
    to {
      background-position: -28px 0, 0 0;
    }
  }

  .drape__mark {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    color: var(--gold-pale);
    text-align: center;
  }

  /* The house mark, set into the cloth. The artwork is transparent, so it is
     shown whole — nothing masked, nothing cropped. */
  .drape__logo {
    width: min(26rem, 70vw);
    height: auto;
    opacity: 0;
    scale: 0.92;
    animation: logoIn 0.7s var(--ease-out-soft) 0.05s forwards;
  }

  @keyframes logoIn {
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .drape__deva {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.8rem + 1.2vw, 1.7rem);
    color: var(--gold-light);
    opacity: 0;
    translate: 0 14px;
    animation: up 0.6s var(--ease-out-soft) 0.18s forwards;
  }

  .drape__rule {
    width: min(22rem, 60vw);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-light), transparent);
    scale: 0 1;
    animation: rule 0.7s var(--ease-out-soft) 0.3s forwards;
  }

  @keyframes rule {
    to {
      scale: 1 1;
    }
  }

  .drape__en {
    font-size: 0.74rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    opacity: 0;
    translate: 0 10px;
    animation: up 0.6s var(--ease-out-soft) 0.4s forwards;
  }

  @keyframes up {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ================================================================= *
   * the hero: one photograph, edge to edge
   * ================================================================= */
  .hero {
    /* Entrance offset: waits for the drape, or not at all. */
    --t0: 1.35s;
    /* Delay before the first pleats fall; the script zeroes it after. */
    --pd: var(--t0);
    --accent: #651d35;
    --mx: 0;
    --my: 0;
    position: relative;
    display: grid;
    grid-template-rows: 1fr auto auto;
    min-height: calc(100svh - 2.4rem - 5.2rem);
    background: #1c0f15;
    color: #fbf4e6;
    overflow: hidden;
    isolation: isolate;
  }

  :global(:root[data-hero-intro="seen"]) .hero {
    --t0: 0s;
  }

  /* ================= entrance ================= */
  .rise {
    opacity: 0;
    translate: 0 18px;
    animation: rise 0.9s var(--ease-out-soft) forwards;
    animation-delay: calc(var(--t0) + var(--d, 0ms));
  }

  @keyframes rise {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ================================================================= *
   * the picture
   * ================================================================= */
  .screen {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .layer {
    position: absolute;
    inset: -2%;
    display: flex;
    visibility: hidden;
    transform: translate(calc(var(--mx) * -12px), calc(var(--my) * -8px));
    transition: transform 1.2s var(--ease-out-soft);
  }

  .layer.is-prev {
    visibility: visible;
    z-index: 1;
  }

  .layer.is-on {
    visibility: visible;
    z-index: 2;
  }

  /* A pleat is one sixth of the screen showing its own sixth of the
     photograph: the image inside is as wide as the whole screen and shifted
     left by the pleat's position, so the six line up into one picture. */
  .pleat {
    position: relative;
    flex: 1 1 0;
    overflow: hidden;
  }

  .pleat img {
    position: absolute;
    top: 0;
    left: calc(var(--p) * -100%);
    width: calc(100% * 6);
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: 50% 22%;
  }

  /* The live photograph's pleats fall into place, alternately from above
     and from below, one after another. */
  .layer.is-on .pleat {
    animation: pleatDown 1s cubic-bezier(0.77, 0, 0.18, 1) both;
    animation-delay: calc(var(--pd) + var(--p) * 75ms);
  }

  .layer.is-on .pleat:nth-child(even) {
    animation-name: pleatUp;
  }

  @keyframes pleatDown {
    from {
      clip-path: inset(0 0 100% 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @keyframes pleatUp {
    from {
      clip-path: inset(100% 0 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  /* While it falls each pleat shows its fold — a shadow on one side, a
     highlight on the other — then the cloth settles flat. */
  .pleat::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(
      90deg,
      rgba(0, 0, 0, 0.42) 0%,
      transparent 22%,
      rgba(255, 240, 210, 0.16) 70%,
      rgba(0, 0, 0, 0.18) 100%
    );
    opacity: 0;
    pointer-events: none;
  }

  .layer.is-on .pleat::after {
    animation: fold 1.8s var(--ease) both;
    animation-delay: calc(var(--pd) + var(--p) * 75ms);
  }

  @keyframes fold {
    0%,
    45% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* A slow push on the live photograph. */
  .layer.is-on .pleat img {
    animation: ken 10s var(--ease) both;
    animation-delay: var(--pd);
  }

  @keyframes ken {
    from {
      scale: 1.08;
      translate: 0 -2%;
    }
    to {
      scale: 1;
      translate: 0 0;
    }
  }

  /* Wine silk washed over the left for the words, and over the foot for the
     occasion bar; the occasion's own colour tints it. */
  .screen__shade {
    position: absolute;
    inset: 0;
    z-index: 3;
    background:
      linear-gradient(to top, rgba(20, 6, 10, 0.92) 0%, rgba(20, 6, 10, 0.4) 22%, transparent 42%),
      linear-gradient(
        90deg,
        rgba(28, 8, 14, 0.94) 0%,
        color-mix(in oklab, var(--accent) 55%, rgba(28, 8, 14, 0.85)) 34%,
        rgba(28, 8, 14, 0.25) 60%,
        transparent 78%
      );
    transition: background 1.2s var(--ease);
  }

  .screen__grain {
    position: absolute;
    inset: 0;
    z-index: 4;
    background-image:
      repeating-linear-gradient(45deg, rgba(217, 184, 114, 0.06) 0 1px, transparent 1px 38px),
      repeating-linear-gradient(-45deg, rgba(217, 184, 114, 0.06) 0 1px, transparent 1px 38px);
    mask-image: linear-gradient(90deg, #000 0%, transparent 55%);
    pointer-events: none;
  }

  /* ================================================================= *
   * the words
   * ================================================================= */
  .hero__grid {
    max-width: 1640px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 2rem;

---
import { OCCASIONS } from "@jaiisha/catalogue";

/**
 * Hero — the whole argument for the saree, on one screen.
 *
 * The brief is first impression. A visitor who has never heard of the house
 * should get, without scrolling, every reason the page exists: why a woman
 * wears a saree at all, what the cloth carries culturally, and that each
 * occasion asks for its own weave and its own colour. So the first viewport is
 * a three-column stage with a base, and nothing in it is filler:
 *
 *   copy   — the one fixed claim, and the way in to the shop
 *   stage  — the Mughal arch, one occasion at a time
 *   rail   — every occasion, the live one opened to its tradition
 *   base   — four reasons she wears it, and a ticker of what the cloth means
 *
 * One index drives the stage, the rail and the accent colour that washes the
 * whole field, so the page changes temperature with the
 * occasion. Scenes come from the catalogue taxonomy itself (OCCASIONS), so the
 * copy here cannot drift out of sync with the shop.
 *
 * Motion, in order of appearance: a length of silk is drawn off the screen on
 * every load; the headline rises line by line while a wave
 * of light runs through the zari word; each occasion opens out of the arch in
 * a lozenge, the buti shape, with a gold flash; a silk pallu ripples behind
 * the stage; the stage tilts toward the cursor. Under
 * prefers-reduced-motion none of that runs — the rotator waits for the rail
 * and the copy is simply there.
 */

const scenes = OCCASIONS.map((o) => ({
  slug: o.slug,
  name: o.name,
  blurb: o.blurb,
  tradition: o.tradition,
  accent: o.accent,
  image: o.image,
  imageAlt: o.imageAlt,
  /* The occasion's colour, shown as the diamond beside it in the rail. */
  swatch: o.colourCode.swatch,
}));

/* Why she wears it. Four reasons, each one a word she would actually use. */
const reasons = [
  { deva: "अखण्ड", title: "Unstitched", line: "No cut, no seam — cloth pure enough for a temple." },
  { deva: "शुभ", title: "Auspicious", line: "Red for a bride, ivory for pooja, green for Teej." },
  { deva: "विरासत", title: "Inherited", line: "Folded in muslin, passed down to a daughter." },
  { deva: "सदाबहार", title: "Ageless", line: "Fits every body, every age, every decade." },
];

/* The ticker: what the cloth carries, in the language it carries it in. */
const values = [
  { deva: "अखण्ड", en: "Unstitched, and therefore whole" },
  { deva: "सौभाग्य", en: "Red for a long married life" },
  { deva: "शुद्ध", en: "Pure silk, fit for a temple" },
  { deva: "गंगा", en: "Woven on the banks of the Ganga" },
  { deva: "विरासत", en: "Inherited, never replaced" },
  { deva: "सोलह शृंगार", en: "The first of a bride's adornments" },
  { deva: "हस्तकला", en: "Two weavers, three weeks, one saree" },
];

const zariWord = "unstitched".split("");
---

<!-- ================= the drape =================
     Shown on every load: a length of wine silk with zari borders covers the
     screen, then is drawn off to the right to reveal the page. Pure CSS, so
     it always finishes even if the script below never runs. -->
<div class="drape" aria-hidden="true">
  <div class="drape__cloth">
    <span class="drape__border drape__border--top"></span>
    <div class="drape__mark">
      <img
        class="drape__logo"
        src="/img/brand/jaiisha-logo-full.png"
        alt=""
        width="768"
        height="522"
        fetchpriority="high"
        decoding="async"
      />
      <span class="drape__deva">छह गज़ की विरासत</span>
      <span class="drape__rule"></span>
      <span class="drape__en">Six yards of inheritance</span>
    </div>
    <span class="drape__border drape__border--bottom"></span>
  </div>
  <span class="drape__edge"></span>
</div>
<script is:inline>
  if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
    document.documentElement.setAttribute("data-hero-intro", "seen");
  }
</script>

<section class="hero" aria-labelledby="hero-title" data-hero style={`--accent:${scenes[0].accent}`}>
  <div class="hero__bg" aria-hidden="true"></div>
  <div class="hero__spot" aria-hidden="true"></div>

  <!-- A silk pallu rippling behind the stage, gold zari along both edges. -->
  <svg class="pallu" viewBox="0 0 1440 800" preserveAspectRatio="none" aria-hidden="true" data-pallu>
    <defs>
      <linearGradient id="pallu-fill" x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" style="stop-color: var(--accent); stop-opacity: 0" />
        <stop offset="0.35" style="stop-color: var(--accent); stop-opacity: 0.22" />
        <stop offset="1" style="stop-color: var(--accent); stop-opacity: 0.08" />
      </linearGradient>
    </defs>
    <path fill="url(#pallu-fill)">
      <animate
        attributeName="d"
        dur="16s"
        repeatCount="indefinite"
        calcMode="spline"
        keyTimes="0;0.33;0.66;1"
        keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"
        values="M -80 600 C 260 500 520 760 820 560 C 1060 400 1260 300 1520 250 L 1520 340 C 1260 390 1080 520 840 660 C 540 840 260 600 -80 700 Z;
                M -80 640 C 300 560 520 640 820 520 C 1080 420 1240 360 1520 300 L 1520 390 C 1250 450 1100 600 840 620 C 560 700 280 660 -80 740 Z;
                M -80 580 C 240 640 560 700 820 600 C 1040 520 1280 260 1520 220 L 1520 310 C 1300 340 1060 620 840 700 C 520 800 240 720 -80 680 Z;
                M -80 600 C 260 500 520 760 820 560 C 1060 400 1260 300 1520 250 L 1520 340 C 1260 390 1080 520 840 660 C 540 840 260 600 -80 700 Z"
      />
    </path>
    <path class="pallu__zari" fill="none">
      <animate
        attributeName="d"
        dur="16s"
        repeatCount="indefinite"
        calcMode="spline"
        keyTimes="0;0.33;0.66;1"
        keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"
        values="M -80 600 C 260 500 520 760 820 560 C 1060 400 1260 300 1520 250;
                M -80 640 C 300 560 520 640 820 520 C 1080 420 1240 360 1520 300;
                M -80 580 C 240 640 560 700 820 600 C 1040 520 1280 260 1520 220;
                M -80 600 C 260 500 520 760 820 560 C 1060 400 1260 300 1520 250"
      />
    </path>
    <path class="pallu__zari pallu__zari--low" fill="none">
      <animate
        attributeName="d"
        dur="16s"
        repeatCount="indefinite"
        calcMode="spline"
        keyTimes="0;0.33;0.66;1"
        keySplines="0.45 0 0.55 1;0.45 0 0.55 1;0.45 0 0.55 1"
        values="M -80 700 C 260 600 540 840 840 660 C 1080 520 1260 390 1520 340;
                M -80 740 C 280 660 560 700 840 620 C 1100 600 1250 450 1520 390;
                M -80 680 C 240 720 520 800 840 700 C 1060 620 1300 340 1520 310;
                M -80 700 C 260 600 540 840 840 660 C 1080 520 1260 390 1520 340"
      />
    </path>
  </svg>

  <!-- Drifting gold buti — the small motif scattered across a Banarasi field. -->
  <div class="buti" aria-hidden="true">
    {Array.from({ length: 16 }).map((_, i) => <span style={`--i:${i}`} />)}
  </div>

  <div class="shell hero__grid">
    <!-- ================= copy ================= -->
    <div class="hero__copy">
      <p class="hero__eyebrow rise" style="--d:0ms">
        <span class="hero__dot" aria-hidden="true"></span>
        Handwoven in Varanasi, since the 1400s
      </p>

      <h1 class="hero__title" id="hero-title">
        <span class="line"><span class="line__in" style="--d:80ms">Six metres,</span></span>
        <span class="line"
          ><span class="line__in" style="--d:190ms"
            ><em class="zari" aria-label="unstitched"
              >{zariWord.map((c, i) => <span class="zari__c" style={`--c:${i}`} aria-hidden="true">{c}</span>)}</em
            >,</span
          ></span
        >
        <span class="line"><span class="line__in" style="--d:300ms">never out of place.</span></span>
      </h1>

      <p class="hero__lede rise" style="--d:440ms">
        No seam, no size, no season it expires in. A saree fits every woman who wears it and every
        age she wears it at — so a bride, her mother and her grandmother can all wear the same six
        yards of silk.
      </p>

      <div class="hero__actions rise" style="--d:700ms">
        <a class="btn btn--gold hero__cta" href="/sarees">
          Shop the collection
          <svg viewBox="0 0 24 24" aria-hidden="true"
            ><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg
          >
        </a>
        <a class="btn btn--ghost" href="/craft">How a Banarasi is woven</a>
      </div>
    </div>

    <!-- ================= stage ================= -->
    <div class="hero__stage" data-tilt>
      <figure class="arch">
        <div class="arch__frame">
          <div class="arch__stack">
            {
              scenes.map((s, i) => (
                <img
                  class={`arch__img${i === 0 ? " is-on" : ""}`}
                  data-shot={i}
                  src={s.image}
                  alt={s.imageAlt}
                  aria-hidden={i === 0 ? "false" : "true"}
                  width="1600"
                  height="2400"
                  fetchpriority={i === 0 ? "high" : "low"}
                  decoding="async"
                />
              ))
            }
            <span class="arch__burst" aria-hidden="true" data-burst />
            <span class="arch__wash" aria-hidden="true" />
            <span class="arch__glint" aria-hidden="true" />
          </div>

          <figcaption class="arch__cap">
            <span class="arch__worn">Worn for</span>
            <span class="arch__name" data-cap>{scenes[0].name}</span>
            <span class="arch__city">Varanasi · Uttar Pradesh</span>
          </figcaption>
        </div>
        <span class="arch__keystone" aria-hidden="true" />
        <span class="arch__ring" aria-hidden="true" />
      </figure>
    </div>

    <!-- ================= occasions rail ================= -->
    <aside class="orail" aria-label="Sarees by occasion">
      <p class="orail__label rise" style="--d:380ms">
        <span>Every occasion</span>
        <span class="orail__label-em">asks for its own saree</span>
      </p>
      <ol class="orail__list" data-rail>
        {
          scenes.map((s, i) => (
            <li
              class={`orail__item rise${i === 0 ? " is-on" : ""}`}
              style={`--d:${460 + i * 80}ms; --accent:${s.accent}`}
              data-item={i}
            >
              <button
                type="button"
                class="orail__head"
                data-pick={i}
                aria-expanded={i === 0 ? "true" : "false"}
                aria-controls={`rail-body-${i}`}
              >
                <span class="orail__no">{String(i + 1).padStart(2, "0")}</span>
                <span class="orail__name">{s.name}</span>
                <span class="orail__swatch" style={`--sw:${s.swatch}`} aria-hidden="true" />
              </button>
              <span class="orail__bar" aria-hidden="true">
                <i />
              </span>
              <div class="orail__body" id={`rail-body-${i}`}>
                <div class="orail__inner">
                  <p class="orail__tradition">{s.tradition}</p>
                  <a class="orail__link" href={`/occasion/${s.slug}`} tabindex={i === 0 ? undefined : "-1"}>
                    See {s.name.toLowerCase()} sarees
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.4" />
                    </svg>
                  </a>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      <p class="orail__wide" data-wide>{scenes[0].tradition}</p>
    </aside>
  </div>

  <!-- ================= base: why she wears it + ticker ================= -->
  <div class="hero__base">
    <div class="shell">
      <div class="why rise" style="--d:760ms">
        <p class="why__label">Why every Indian woman owns one</p>
        <ul class="why__grid">
          {
            reasons.map((r, i) => (
              <li class="why__card" style={`--i:${i}`}>
                <span class="why__deva" lang="hi">{r.deva}</span>
                <span class="why__title">{r.title}</span>
                <span class="why__line">{r.line}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="values" aria-label="What a Banarasi carries">
      <div class="values__track">
        {
          [0, 1].map((dup) => (
            <ul class="values__list" aria-hidden={dup === 1 ? "true" : "false"}>
              {values.map((v) => (
                <li>
                  <span class="values__deva" lang="hi">{v.deva}</span>
                  <span class="values__en">{v.en}</span>
                  <span class="values__sep" aria-hidden="true">◆</span>
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>
  </div>

  <script
    type="application/json"
    data-scenes
    set:html={JSON.stringify(
      scenes.map((s) => ({
        name: s.name,
        tradition: s.tradition,
        accent: s.accent,
      })),
    )}
  />
</section>

<script>
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

  /* ------------------------------------------------------------------ *
   * The rotator. One index drives the arch, the rail
   * and the accent colour of the whole field.
   * ------------------------------------------------------------------ */
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero) return;

    type Scene = { name: string; tradition: string; accent: string };
    let scenes: Scene[] = [];
    try {
      scenes = JSON.parse(hero.querySelector("[data-scenes]")?.textContent ?? "[]") as Scene[];
    } catch {
      return;
    }
    if (scenes.length < 2) return;

    const shots = [...hero.querySelectorAll<HTMLElement>("[data-shot]")];
    const items = [...hero.querySelectorAll<HTMLElement>("[data-item]")];
    const picks = [...hero.querySelectorAll<HTMLButtonElement>("[data-pick]")];
    const cap = hero.querySelector<HTMLElement>("[data-cap]");
    const burst = hero.querySelector<HTMLElement>("[data-burst]");
    const wide = hero.querySelector<HTMLElement>("[data-wide]");

    /* Matches the rail bar's fill duration in CSS. */
    const HOLD = 6500;
    let index = 0;
    let timer = 0;
    let swap = 0;
    let paused = false;

    const stop = () => {
      window.clearTimeout(timer);
      timer = 0;
    };

    const start = () => {
      stop();
      if (reduce.matches || document.hidden || paused) return;
      timer = window.setTimeout(() => show(index + 1), HOLD);
    };

    /* Restart a CSS animation from its first frame. */
    const replay = (el: HTMLElement | null | undefined) => {
      if (!el) return;
      el.style.animation = "none";
      void el.offsetWidth;
      el.style.animation = "";
    };

    const show = (next: number) => {
      const prev = index;
      index = ((next % scenes.length) + scenes.length) % scenes.length;
      if (index === prev) return start();
      const scene = scenes[index];

      shots.forEach((el, i) => {
        el.classList.toggle("is-on", i === index);
        el.classList.toggle("is-prev", i === prev);
        el.setAttribute("aria-hidden", i === index ? "false" : "true");
      });

      items.forEach((el, i) => {
        const on = i === index;
        el.classList.toggle("is-on", on);
        picks[i]?.setAttribute("aria-expanded", on ? "true" : "false");
        const link = el.querySelector<HTMLAnchorElement>(".orail__link");
        if (link) {
          if (on) link.removeAttribute("tabindex");
          else link.setAttribute("tabindex", "-1");
        }
      });
      replay(items[index]?.querySelector<HTMLElement>(".orail__bar i"));

      hero.style.setProperty("--accent", scene.accent);
      replay(burst);

      /* Swap the words behind a short fade. */
      window.clearTimeout(swap);
      cap?.classList.add("is-out");
      wide?.classList.add("is-out");
      swap = window.setTimeout(() => {
        if (cap) cap.textContent = scene.name;
        if (wide) wide.textContent = scene.tradition;
        cap?.classList.remove("is-out");
        wide?.classList.remove("is-out");
      }, 280);

      start();
    };

    picks.forEach((btn, i) => btn.addEventListener("click", () => show(i)));

    /* Pause while someone is reading the rail; keep going over the stage. */
    const rail = hero.querySelector("[data-rail]");
    rail?.addEventListener("pointerenter", () => {
      paused = true;
      hero.classList.add("is-paused");
      stop();
    });
    rail?.addEventListener("pointerleave", () => {
      paused = false;
      hero.classList.remove("is-paused");
      replay(items[index]?.querySelector<HTMLElement>(".orail__bar i"));
      start();
    });

    document.addEventListener("visibilitychange", () => (document.hidden ? stop() : start()));
    reduce.addEventListener("change", start);

    /* Hold the first scene until the drape has cleared. */
    const intro = document.documentElement.getAttribute("data-hero-intro") === "seen" ? 0 : 1400;
    window.setTimeout(() => {
      replay(items[0]?.querySelector<HTMLElement>(".orail__bar i"));
      start();
    }, intro);
  })();

  /* ------------------------------------------------------------------ *
   * The stage leans toward the cursor, and a soft zari light follows it.
   * ------------------------------------------------------------------ */
  (() => {
    const hero = document.querySelector<HTMLElement>("[data-hero]");
    if (!hero || reduce.matches || !window.matchMedia("(pointer: fine)").matches) return;

    let frame = 0;
    let x = 0;
    let y = 0;
    hero.addEventListener("pointermove", (e) => {
      const r = hero.getBoundingClientRect();
      x = e.clientX - r.left;
      y = e.clientY - r.top;
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        hero.style.setProperty("--px", `${x}px`);
        hero.style.setProperty("--py", `${y}px`);
        hero.style.setProperty("--mx", ((x / r.width) * 2 - 1).toFixed(3));
        hero.style.setProperty("--my", ((y / r.height) * 2 - 1).toFixed(3));
      });
    });
    hero.addEventListener("pointerleave", () => {
      hero.style.setProperty("--mx", "0");
      hero.style.setProperty("--my", "0");
    });
  })();

  /* Under reduced motion, freeze the pallu (SMIL ignores CSS). */
  (() => {
    const pallu = document.querySelector<SVGSVGElement>("[data-pallu]");
    if (!pallu) return;
    const sync = () => (reduce.matches ? pallu.pauseAnimations() : pallu.unpauseAnimations());
    sync();
    reduce.addEventListener("change", sync);
  })();
</script>

<style>
  /* ================================================================= *
   * the drape
   * ================================================================= */
  .drape {
    position: fixed;
    inset: 0;
    z-index: 200;
    pointer-events: none;
    animation: drapeGone 0s linear 1.75s forwards;
  }

  :global(:root[data-hero-intro="seen"]) .drape {
    display: none;
  }

  @keyframes drapeGone {
    to {
      visibility: hidden;
    }
  }

  .drape__cloth {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto 1fr auto;
    background:
      repeating-linear-gradient(45deg, rgba(217, 184, 114, 0.08) 0 1px, transparent 1px 34px),
      repeating-linear-gradient(-45deg, rgba(217, 184, 114, 0.08) 0 1px, transparent 1px 34px),
      radial-gradient(70% 60% at 50% 50%, #7a2442, #3f1020 80%);
    clip-path: inset(0 0 0 0);
    animation: drawOff 0.85s cubic-bezier(0.77, 0, 0.18, 1) 0.9s forwards;
  }

  /* The cloth is pulled away to the right, the way a saree is drawn off a
     shop counter to show its length. */
  @keyframes drawOff {
    to {
      clip-path: inset(0 0 0 100%);
    }
  }

  /* A bright zari selvedge riding the edge of the cloth as it goes. */
  .drape__edge {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 10px;
    background: linear-gradient(90deg, transparent, var(--gold-light), #fff6e2, var(--gold-light), transparent);
    box-shadow: 0 0 40px 8px rgba(217, 184, 114, 0.55);
    opacity: 0;
    animation: edgeRun 0.85s cubic-bezier(0.77, 0, 0.18, 1) 0.9s forwards;
  }

  @keyframes edgeRun {
    0% {
      left: 0;
      opacity: 1;
    }
    92% {
      opacity: 1;
    }
    100% {
      left: 100%;
      opacity: 0;
    }
  }

  .drape__border {
    height: clamp(1.4rem, 3vh, 2.2rem);
    background:
      repeating-linear-gradient(90deg, rgba(28, 15, 21, 0.55) 0 2px, transparent 2px 14px),
      linear-gradient(180deg, #8a6626, var(--gold-light) 30%, #fff1cf 50%, var(--gold-light) 70%, #8a6626);
    background-size: 200% 100%, 100% 100%;
    animation: weave 1.6s linear infinite;
  }

  @keyframes weave {
    to {
      background-position: -28px 0, 0 0;
    }
  }

  .drape__mark {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    color: var(--gold-pale);
    text-align: center;
  }

  /* The house mark, set into the cloth. The artwork is transparent, so it is
     shown whole — nothing masked, nothing cropped. */
  .drape__logo {
    width: min(26rem, 70vw);
    height: auto;
    opacity: 0;
    scale: 0.92;
    animation: logoIn 0.7s var(--ease-out-soft) 0.05s forwards;
  }

  @keyframes logoIn {
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .drape__deva {
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.8rem + 1.2vw, 1.7rem);
    color: var(--gold-light);
    opacity: 0;
    translate: 0 14px;
    animation: up 0.6s var(--ease-out-soft) 0.18s forwards;
  }

  .drape__rule {
    width: min(22rem, 60vw);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold-light), transparent);
    scale: 0 1;
    animation: rule 0.7s var(--ease-out-soft) 0.3s forwards;
  }

  @keyframes rule {
    to {
      scale: 1 1;
    }
  }

  .drape__en {
    font-size: 0.74rem;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    opacity: 0;
    translate: 0 10px;
    animation: up 0.6s var(--ease-out-soft) 0.4s forwards;
  }

  @keyframes up {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ================================================================= *
   * the field
   * ================================================================= */
  .hero {
    /* Entrance offset: waits for the drape, or not at all. */
    --t0: 1.35s;
    --accent: #651d35;
    --mx: 0;
    --my: 0;
    --px: 70%;
    --py: 40%;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    /* A light stage. The dark-theme tokens the rules below were written
       against are re-pointed here, so the whole section turns with them. */
    --on-dark: var(--ink);
    --on-dark-soft: var(--ink-soft);
    --gold-light: #7a561c;
    --dark: var(--ivory-warm);
    --dark-raised: #ffffff;
    /* Exactly one screen under the announcement bar and the header. */
    min-height: calc(100svh - 2.4rem - 5.2rem);
    padding-top: clamp(1rem, 3vh, 2rem);
    background: #e3cfb0;
    color: var(--ink);
    overflow: hidden;
  }

  :global(:root[data-hero-intro="seen"]) .hero {
    --t0: 0s;
  }

  /* Accent bloom behind the stage, plus a faint zari lattice over the field. */
  .hero__bg {
    position: absolute;
    inset: -10%;
    z-index: -3;
    background:
      radial-gradient(46% 52% at 56% 40%, color-mix(in oklab, var(--accent) 26%, transparent), transparent 70%),
      radial-gradient(40% 45% at 92% 70%, color-mix(in oklab, var(--accent) 14%, transparent), transparent 70%),
      radial-gradient(55% 45% at 6% 92%, rgba(122, 86, 28, 0.16), transparent 70%),
      linear-gradient(165deg, #ead8bc 0%, #e0c8a4 55%, #d5ba92 100%);
    transition: background 1.4s var(--ease);
    animation: bloom 22s var(--ease) infinite alternate;
  }

  @keyframes bloom {
    to {
      transform: scale(1.08) translate3d(-1.5%, 1%, 0);
    }
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: -40%;
    background-image:
      repeating-linear-gradient(45deg, rgba(181, 138, 67, 0.12) 0 1px, transparent 1px 42px),
      repeating-linear-gradient(-45deg, rgba(181, 138, 67, 0.12) 0 1px, transparent 1px 42px);
    mask-image: radial-gradient(80% 80% at 62% 40%, #000 20%, transparent 85%);
    animation: jaal 90s linear infinite;
  }

  @keyframes jaal {
    to {
      transform: translate3d(42px, 42px, 0);
    }
  }

  /* Zari light that follows the cursor. */
  .hero__spot {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background: radial-gradient(
      420px circle at var(--px) var(--py),
      rgba(217, 184, 114, 0.11),
      transparent 65%
    );
  }

  /* ================= pallu ================= */
  .pallu {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -2;
    pointer-events: none;
    opacity: 0;
    animation: fadeIn 2s var(--ease) calc(var(--t0) + 0.4s) forwards;
    /* Keep the cloth away from the headline. */
    mask-image: linear-gradient(90deg, transparent 0%, #000 38%, #000 100%);
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
    }
  }

  .pallu__zari {
    stroke: var(--gold-light);
    stroke-width: 1.6;
    stroke-dasharray: 2 7;
    opacity: 0.7;
    vector-effect: non-scaling-stroke;
    animation: stitch 3s linear infinite;
  }

  .pallu__zari--low {
    opacity: 0.4;
    animation-direction: reverse;
  }

  @keyframes stitch {
    to {
      stroke-dashoffset: -36;
    }
  }

  /* ================= drifting buti ================= */
  .buti {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    overflow: hidden;
  }

  .buti span {
    position: absolute;
    left: calc((var(--i) * 6.2%) + 2%);
    bottom: -6%;
    width: 7px;
    height: 7px;
    rotate: 45deg;
    background: linear-gradient(135deg, var(--gold-light), rgba(181, 138, 67, 0.2));
    box-shadow: 0 0 10px rgba(217, 184, 114, 0.5);
    opacity: 0;
    animation: drift calc(17s + (var(--i) * 1.5s)) linear infinite;
    animation-delay: calc(var(--i) * -2.4s);
  }

  .buti span:nth-child(3n) {
    width: 4px;
    height: 4px;
  }

  .buti span:nth-child(4n) {
    width: 10px;
    height: 10px;
    background: none;
    box-shadow: none;
    border: 1px solid rgba(217, 184, 114, 0.5);
  }

  @keyframes drift {
    0% {
      transform: translate3d(0, 0, 0) rotate(0deg);
      opacity: 0;
    }
    12% {
      opacity: 0.6;
    }
    80% {
      opacity: 0.3;
    }
    100% {
      transform: translate3d(4vw, -106vh, 0) rotate(220deg);
      opacity: 0;
    }
  }

  /* ================= grid ================= */
  .hero__grid {
    /* The hero spends the full width: no space wasted at the sides. */
    max-width: 1640px;
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1.22fr) minmax(0, 0.9fr) minmax(15rem, 0.7fr);
    gap: clamp(1.5rem, 3.2vw, 3.4rem);
    align-items: center;
    padding-bottom: clamp(1rem, 2.4vh, 1.8rem);
  }

  /* ================= entrance ================= */
  .rise {
    opacity: 0;
    translate: 0 18px;
    animation: rise 0.9s var(--ease-out-soft) forwards;
    animation-delay: calc(var(--t0) + var(--d, 0ms));
  }

  @keyframes rise {
    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  /* ================= copy ================= */
  .hero__copy {
    display: grid;
    justify-items: start;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.26em;
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: clamp(0.6rem, 1.6vh, 1rem);
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    rotate: 45deg;
    background: var(--gold);
    animation: pulse 3.2s var(--ease) infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgba(181, 138, 67, 0.55);
    }
    60% {
      box-shadow: 0 0 0 9px rgba(181, 138, 67, 0);
    }
  }

  .hero__title {
    /* Sized by width and by height, so three lines always fit the screen. */
    font-size: min(clamp(2.1rem, 0.8rem + 2.6vw, 3.9rem), 6.6vh);
    line-height: 1.02;
    letter-spacing: -0.015em;
  }

  /* Each line lifts out from behind its own mask. */
  .line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.08em;
  }

  .line__in {
    display: block;
    translate: 0 108%;
    rotate: 0 0 1 3deg;
    animation: lineUp 1.1s var(--ease-out-soft) forwards;
    animation-delay: calc(var(--t0) + var(--d, 0ms));
  }

  @keyframes lineUp {
    to {
      translate: 0 0;
      rotate: 0 0 1 0deg;
    }
  }

  /* Zari running through the one italic word: each letter carries its own
     sheen, offset in time, so a wave of light travels along the word. */
  .zari {
    font-style: italic;
    white-space: nowrap;
  }

  .zari__c {
    display: inline-block;
    background: linear-gradient(
      100deg,
      var(--gold) 0%,
      var(--gold-light) 35%,
      #fff6e2 50%,
      var(--gold-light) 65%,
      var(--gold) 100%
    );
    background-size: 400% 100%;
    background-position: 100% 0;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    opacity: 0;
    translate: 0 0.5em;
    rotate: x 80deg;
    animation:
      charIn 0.8s var(--ease-out-soft) calc(var(--t0) + 0.35s + var(--c) * 45ms) forwards,
      shimmer 5s var(--ease) calc(var(--t0) + 1.6s + var(--c) * 70ms) infinite;
  }

  @keyframes charIn {
    to {
      opacity: 1;
      translate: 0 0;
      rotate: x 0deg;
    }
  }

  @keyframes shimmer {
    0% {
      background-position: 100% 0;
    }
    30%,
    100% {
      background-position: 0% 0;
    }
  }

  .hero__lede {
    max-width: 50ch;
    margin-top: clamp(0.6rem, 1.6vh, 1.1rem);
    font-size: clamp(0.88rem, 0.8rem + 0.2vw, 1rem);
    font-weight: 300;
    line-height: 1.65;
    color: rgba(36, 19, 25, 0.78);
  }

  /* ================= why she wears it ================= */
  .why {
    width: 100%;
    padding-block: clamp(0.6rem, 1.6vh, 1rem);
    border-top: 1px solid rgba(36, 19, 25, 0.14);
  }

  .why__label {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgba(36, 19, 25, 0.66);
    margin-bottom: 0.55rem;
  }

  .why__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.6rem;
  }

  /* Each card takes its turn being lit, so the eye is walked through all
     four reasons without anyone having to hover. */
  .why__card {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.7rem;
    align-items: baseline;
    padding: clamp(0.5rem, 1.2vh, 0.75rem) 0.8rem;
    border: 1px solid rgba(36, 19, 25, 0.12);
    background: rgba(255, 249, 238, 0.55);
    backdrop-filter: blur(6px);
    overflow: hidden;
    transition: border-color 0.4s var(--ease), background 0.4s var(--ease);
  }

  .why__card::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(120deg, color-mix(in oklab, var(--accent) 18%, transparent), transparent 70%);
    opacity: 0;
    animation: turn 10s var(--ease) infinite;
    animation-delay: calc(var(--t0) + 1.2s + var(--i) * 2.5s);
  }

  .why__card::after {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--gold-light);
    scale: 1 0;
    transform-origin: top;
    animation: turnBar 10s var(--ease) infinite;
    animation-delay: calc(var(--t0) + 1.2s + var(--i) * 2.5s);
  }

  @keyframes turn {
    0%,
    30%,
    100% {
      opacity: 0;
    }
    6%,
    22% {
      opacity: 1;
    }
  }

  @keyframes turnBar {
    0%,
    30%,
    100% {
      scale: 1 0;
    }
    6%,
    22% {
      scale: 1 1;
    }
  }

  .why__card:hover {
    border-color: rgba(217, 184, 114, 0.5);
  }

  .why__card:hover::before {
    animation: none;
    opacity: 1;
  }

  .why__card > * {
    position: relative;
  }

  .why__deva {
    grid-row: span 2;
    align-self: center;
    font-family: var(--font-display);
    font-size: 1.15rem;
    line-height: 1;
    color: var(--gold-light);
    text-shadow: 0 0 18px rgba(217, 184, 114, 0.35);
  }

  .why__title {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark);
  }

  .why__line {
    font-size: 0.76rem;
    line-height: 1.45;
    color: rgba(36, 19, 25, 0.74);
  }

  /* ================= actions ================= */
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.7rem;
    margin-top: clamp(0.9rem, 2.2vh, 1.5rem);
  }

  .hero__actions .btn {
    padding: 0.85rem 1.35rem;
    letter-spacing: 0.14em;
    white-space: nowrap;
  }

  .hero__cta {
    position: relative;
    overflow: hidden;
  }

  .hero__cta svg {
    width: 1rem;
    height: 1rem;
    transition: translate 0.35s var(--ease);
  }

  .hero__cta:hover svg {
    translate: 4px 0;
  }

  /* A glint across the gold button every few seconds. */
  .hero__cta::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(100deg, transparent 35%, rgba(255, 250, 235, 0.6) 50%, transparent 65%);
    background-size: 300% 100%;
    background-position: 150% 0;
    animation: glint 4.5s var(--ease) calc(var(--t0) + 2s) infinite;
  }

  @keyframes glint {
    0%,
    60% {
      background-position: 150% 0;
    }
    100% {
      background-position: -50% 0;
    }
  }

  /* ================================================================= *
   * stage
   * ================================================================= */
  .hero__stage {
    position: relative;
    justify-self: center;
    /* Sized from the height available, so the arch never pushes the base
       off the screen. */
    width: min(100%, calc((100svh - 16rem) * 0.69));
    min-width: 15rem;
    perspective: 1400px;
    opacity: 0;
    scale: 0.94;
    animation: stageIn 1.4s var(--ease-out-soft) calc(var(--t0) + 0.1s) forwards;
  }

  @keyframes stageIn {
    to {
      opacity: 1;
      scale: 1;
    }
  }

  .arch {
    margin: 0;
    position: relative;
    transform: rotateY(calc(var(--mx) * 5deg)) rotateX(calc(var(--my) * -4deg));
    transition: transform 0.8s var(--ease-out-soft);
  }

  .arch__frame {
    position: relative;
    padding: clamp(0.4rem, 0.8vw, 0.6rem);
    border: 1px solid rgba(181, 138, 67, 0.6);
    border-radius: 50% 50% 6px 6px / 38% 38% 2% 2%;
    background: rgba(181, 138, 67, 0.07);
    box-shadow:
      0 36px 80px -20px rgba(66, 20, 36, 0.35),
      0 0 70px color-mix(in oklab, var(--accent) 30%, transparent);
    transition: box-shadow 1.2s var(--ease);
  }

  .arch__ring {
    position: absolute;
    inset: -0.55rem;
    border: 1px solid rgba(181, 138, 67, 0.25);
    border-radius: 50% 50% 8px 8px / 38% 38% 2% 2%;
    pointer-events: none;
    animation: breathe 7s var(--ease) infinite alternate;
  }

  @keyframes breathe {
    to {
      inset: -1.1rem;
      opacity: 0.35;
    }
  }

  .arch__stack {
    position: relative;
    display: grid;
    overflow: hidden;
    border-radius: 50% 50% 4px 4px / 38% 38% 1.5% 1.5%;
    background: #12080c;
  }

  /* Every photograph sits in the same cell. The live one opens out of the
     centre in a lozenge — the buti shape — over the one it replaces. */
  .arch__img {
    grid-area: 1 / 1;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4.1;
    object-fit: cover;
    object-position: 50% 24%;
    clip-path: polygon(50% 50%, 50% 50%, 50% 50%, 50% 50%);
    scale: 1.18;
    z-index: 0;
  }

  .arch__img.is-prev {
    clip-path: polygon(50% -60%, 160% 50%, 50% 160%, -60% 50%);
    scale: 1.06;
    z-index: 1;
  }

  .arch__img.is-on {
    clip-path: polygon(50% -60%, 160% 50%, 50% 160%, -60% 50%);
    scale: 1;
    z-index: 2;
    transition:
      clip-path 1.15s cubic-bezier(0.77, 0, 0.18, 1),
      scale 1.6s var(--ease-out-soft);
    animation: ken 9s var(--ease) 1.4s forwards;
  }

  @keyframes ken {
    to {
      scale: 1.07;
      object-position: 50% 32%;
    }
  }

  /* A gold lozenge that flies outward as each scene opens. */
  .arch__burst {
    grid-area: 1 / 1;
    place-self: center;
    z-index: 3;
    width: 40%;
    aspect-ratio: 1;
    rotate: 45deg;
    border: 2px solid var(--gold-light);
    box-shadow:
      0 0 30px rgba(217, 184, 114, 0.6),
      inset 0 0 30px rgba(217, 184, 114, 0.4);
    opacity: 0;
    scale: 0;
    pointer-events: none;
    animation: burst 1.15s cubic-bezier(0.22, 0.61, 0.36, 1) var(--t0);
  }

  @keyframes burst {
    0% {
      scale: 0;
      opacity: 1;
    }
    100% {
      scale: 3.4;
      opacity: 0;
    }
  }

  .arch__wash {
    grid-area: 1 / 1;
    z-index: 4;
    background: linear-gradient(to top, rgba(18, 8, 12, 0.88) 0%, transparent 44%);
    pointer-events: none;
  }

  .arch__glint {
    grid-area: 1 / 1;
    z-index: 5;
    pointer-events: none;
    background: linear-gradient(100deg, transparent 42%, rgba(255, 246, 226, 0.2) 50%, transparent 58%);
    background-size: 300% 100%;
    animation: sweep 9s var(--ease) 0.6s infinite;
  }

  @keyframes sweep {
    0%,
    62% {
      background-position: 150% 0;
    }
    100% {
      background-position: -60% 0;
    }
  }

  .arch__cap {
    position: absolute;
    left: 0;
    right: 0;
    bottom: clamp(1rem, 2.4vh, 1.6rem);
    z-index: 6;
    display: grid;
    gap: 0.25rem;
    justify-items: center;
    text-align: center;
    pointer-events: none;
  }

  .arch__worn {
    font-size: 0.6rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    color: rgba(246, 239, 228, 0.75);
  }

  .arch__name {
    font-family: var(--font-display);
    padding-inline: 1.2rem;
    font-size: clamp(1.1rem, 0.85rem + 0.8vw, 1.55rem);
    line-height: 1.15;
    text-wrap: balance;
    color: #f6efe4;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.65);
    transition:
      opacity 0.28s var(--ease),
      translate 0.5s var(--ease-out-soft),
      filter 0.28s var(--ease);
  }

  .arch__name.is-out {
    opacity: 0;
    translate: 0 10px;
    filter: blur(6px);
  }

  .arch__city {
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #d9b872;
  }

  .arch__keystone {
    position: absolute;
    top: -0.4rem;
    left: 50%;
    translate: -50% 0;
    width: 0.8rem;
    height: 0.8rem;
    rotate: 45deg;
    background: var(--gold);
    box-shadow:
      0 0 0 4px var(--dark),
      0 0 22px rgba(217, 184, 114, 0.8);
  }

  /* ================================================================= *
   * occasions rail
   * ================================================================= */
  .orail {
    align-self: center;
  }

  .orail__label {
    display: grid;
    gap: 0.15rem;
    margin-bottom: clamp(0.6rem, 1.6vh, 1rem);
  }

  .orail__label span:first-child {
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--gold-light);
  }

  .orail__label-em {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 0.85rem + 0.6vw, 1.4rem);
    line-height: 1.2;
  }

  .orail__list {
    border-top: 1px solid rgba(36, 19, 25, 0.14);
  }

  .orail__item {
    position: relative;
    border-bottom: 1px solid rgba(36, 19, 25, 0.14);
  }

  .orail__head {
    display: grid;
    grid-template-columns: 1.8rem 1fr auto;
    align-items: center;
    gap: 0.5rem;
    width: 100%;
    padding: clamp(0.55rem, 1.35vh, 0.8rem) 0;
    border: 0;
    background: none;
    color: rgba(36, 19, 25, 0.72);
    text-align: left;
    cursor: pointer;
    transition: color 0.35s var(--ease), padding 0.45s var(--ease-out-soft);
  }

  .orail__head:hover,
  .orail__item.is-on .orail__head {
    color: var(--on-dark);
  }

  .orail__item.is-on .orail__head {
    padding-left: 0.4rem;
  }

  .orail__no {
    font-size: 0.66rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }

  .orail__name {
    font-family: var(--font-display);
    font-size: clamp(0.92rem, 0.8rem + 0.35vw, 1.1rem);
    line-height: 1.2;
  }

  .orail__swatch {
    width: 0.7rem;
    height: 0.7rem;
    rotate: 45deg;
    background: var(--sw);
    border: 1px solid rgba(217, 184, 114, 0.7);
    transition: scale 0.4s var(--ease-out-soft), box-shadow 0.4s var(--ease);
  }

  .orail__item.is-on .orail__swatch {
    scale: 1.35;
    box-shadow: 0 0 14px var(--sw);
  }

  /* The bar fills while its scene is live — a visible clock for the rotator. */
  .orail__bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 1px;
    overflow: hidden;
  }

  .orail__bar i {
    display: block;
    height: 100%;
    background: linear-gradient(90deg, var(--gold), var(--gold-light));
    transform-origin: left;
    scale: 0 1;
  }

  .orail__item.is-on .orail__bar i {
    animation: fill 6.5s linear forwards;
  }

  .hero.is-paused .orail__item.is-on .orail__bar i {
    animation-play-state: paused;
  }

  @keyframes fill {
    to {
      scale: 1 1;
    }
  }

  /* The live occasion opens to its tradition. */
  .orail__body {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.6s var(--ease-out-soft);
  }

  .orail__item.is-on .orail__body {
    grid-template-rows: 1fr;
  }

  .orail__inner {
    overflow: hidden;
    padding-left: 2.7rem;
  }

  .orail__tradition {
    font-size: 0.8rem;
    line-height: 1.6;
    color: rgba(36, 19, 25, 0.72);
    opacity: 0;
    translate: 0 8px;
    transition:
      opacity 0.5s var(--ease) 0.1s,
      translate 0.5s var(--ease) 0.1s;
  }

  .orail__item.is-on .orail__tradition {
    opacity: 1;
    translate: 0 0;
  }

  .orail__link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin: 0.5rem 0 0.85rem;
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-light);
  }

  .orail__link svg {
    width: 0.95rem;
    height: 0.95rem;
    transition: translate 0.35s var(--ease);
  }

  .orail__link:hover svg {
    translate: 4px 0;
  }

  /* Only used when the rail lies flat in a row (see responsive). */
  .orail__wide {
    display: none;
    margin-top: 0.8rem;
    max-width: 70ch;
    font-size: 0.84rem;

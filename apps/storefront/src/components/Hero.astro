---
import { OCCASIONS } from "@jaiisha/catalogue";

/**
 * Hero — still photography, no video.
 *
 * The brand film carried its own baked-in typography, so any headline laid
 * over it competed with the film's own words. This hero is built from stills
 * instead: the copy owns the left column outright, the imagery owns the right,
 * and the two never share space.
 *
 * The portrait sits in a Mughal arch — the same shape that frames the arches
 * of Varanasi weaving houses, and the motif the brand film uses. It is drawn
 * with border-radius rather than an image mask so it survives everywhere and
 * costs nothing.
 *
 * The film still exists at /media/jaiisha-hero.mp4 and plays on the product
 * page that references it.
 */
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true"></div>

  <div class="shell hero__inner">
    <!-- ================= words ================= -->
    <div class="hero__copy">
      <p class="hero__eyebrow">
        <span class="hero__dot" aria-hidden="true"></span>
        Handwoven in Varanasi
      </p>

      <h1 class="hero__title" id="hero-title">
        Six metres,<br />
        <em>unstitched</em>,<br />
        and never out of place.
      </h1>

      <p class="hero__lede">
        A saree is the rare garment that fits every woman who wears it, and every age she wears it
        at. No seams, no size, no season it expires in. It is why a bride, her mother and her
        grandmother can all be correctly dressed in the same six yards of silk.
      </p>

      <div class="hero__actions">
        <a class="btn btn--gold" href="/sarees">Shop the collection</a>
        <a class="btn btn--on-dark" href="/craft">How a Banarasi is woven</a>
      </div>

      <ul class="hero__trust">
        <li>Pure Katan silk</li>
        <li>Gold-plated silver zari</li>
        <li>Woven on a pit loom</li>
        <li>Free shipping over ₹3,000</li>
      </ul>
    </div>

    <!-- ================= image ================= -->
    <div class="hero__art">
      <figure class="arch">
        <div class="arch__frame">
          <img
            class="arch__img"
            src="/img/culture/bride-portrait.jpg"
            alt="A bride in deep wine and gold, in a veil with mehndi on her hands"
            width="1600"
            height="2400"
            fetchpriority="high"
            decoding="async"
          />
          <span class="arch__wash" aria-hidden="true"></span>
        </div>
        <span class="arch__keystone" aria-hidden="true"></span>
      </figure>

      <!-- A second plate, overlapping, so the composition has depth. -->
      <figure class="inset">
        <img
          src="/img/culture/loom-detail.jpg"
          alt="Green silk brocade on a wooden handloom, warp threads and heddles visible"
          width="1600"
          height="2400"
          loading="lazy"
          decoding="async"
        />
        <figcaption>
          <span class="inset__kicker">On the loom</span>
          Madanpura, Varanasi
        </figcaption>
      </figure>
    </div>
  </div>

  <!-- ================= occasions ================= -->
  <div class="shell occstrip">
    <p class="occstrip__label">A different occasion asks for a different saree</p>
    <ul class="occstrip__list">
      {
        OCCASIONS.map((o) => (
          <li>
            <a href={`/occasion/${o.slug}`} class="occstrip__item" style={`--accent:${o.accent}`}>
              <span class="occstrip__name">{o.name}</span>
              <span class="occstrip__blurb">{o.blurb}</span>
              <span class="occstrip__go" aria-hidden="true">
                <svg viewBox="0 0 24 24"><path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    background: var(--dark);
    color: var(--on-dark);
    /* Clears the fixed, transparent header. */
    padding-top: clamp(5.5rem, 11vh, 8.5rem);
    padding-bottom: clamp(2rem, 4vw, 3.2rem);
    overflow: hidden;
  }

  /* Wine bloom behind the portrait, plus a faint zari lattice over the whole
     field — the same jaal that runs through the sarees. */
  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      radial-gradient(70% 58% at 72% 34%, rgba(101, 29, 53, 0.95), transparent 68%),
      radial-gradient(55% 45% at 8% 88%, rgba(66, 38, 61, 0.75), transparent 70%),
      linear-gradient(165deg, #2a1119 0%, #1c0f15 55%, #24121a 100%);
  }

  .hero__bg::after {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      repeating-linear-gradient(45deg, rgba(181, 138, 67, 0.07) 0 1px, transparent 1px 42px),
      repeating-linear-gradient(-45deg, rgba(181, 138, 67, 0.07) 0 1px, transparent 1px 42px);
    /* Fade the lattice out behind the headline so it never muddies the type. */
    mask-image: radial-gradient(90% 80% at 70% 40%, #000 20%, transparent 85%);
  }

  .hero__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.02fr) minmax(0, 0.98fr);
    gap: clamp(1.5rem, 5vw, 4.5rem);
    align-items: center;
    min-height: min(42rem, 76svh);
  }

  /* ================= copy ================= */
  .hero__copy {
    display: grid;
    justify-items: start;
    gap: 0;
  }

  .hero__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: var(--tracking-wider);
    text-transform: uppercase;
    color: var(--gold-light);
    margin-bottom: 1.1rem;
  }

  .hero__dot {
    width: 6px;
    height: 6px;
    rotate: 45deg;
    background: var(--gold);
  }

  .hero__title {
    font-size: var(--step-5);
    line-height: 1.02;
    letter-spacing: -0.015em;
    text-shadow: 0 2px 40px rgba(0, 0, 0, 0.3);
  }

  .hero__title em {
    color: var(--gold-light);
  }

  .hero__lede {
    max-width: 44ch;
    margin-top: clamp(1rem, 2vw, 1.5rem);
    font-size: var(--step-0);
    font-weight: 300;
    line-height: 1.8;
    color: rgba(246, 239, 228, 0.78);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.3rem, 2.5vw, 2rem);
  }

  .hero__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.4rem;
    margin-top: clamp(1.5rem, 3vw, 2.4rem);
    padding-top: 1.1rem;
    border-top: 1px solid rgba(246, 239, 228, 0.16);
    width: 100%;
    max-width: 38rem;
  }

  .hero__trust li {
    display: flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(246, 239, 228, 0.56);
  }

  .hero__trust li::before {
    content: "";
    width: 4px;
    height: 4px;
    rotate: 45deg;
    background: var(--gold);
    flex: none;
  }

  /* ================= arch ================= */
  .hero__art {
    position: relative;
    justify-self: center;
    width: 100%;
    max-width: 30rem;
  }

  .arch {
    margin: 0;
    position: relative;
  }

  /* Gold hairline frame, offset outward from the image. */
  .arch__frame {
    position: relative;
    padding: clamp(0.4rem, 1vw, 0.7rem);
    border: 1px solid rgba(181, 138, 67, 0.55);
    border-radius: 50% 50% 6px 6px / 40% 40% 2% 2%;
    background: rgba(181, 138, 67, 0.07);
  }

  .arch__img {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4.1;
    object-fit: cover;
    object-position: 50% 18%;
    border-radius: 50% 50% 4px 4px / 40% 40% 1.5% 1.5%;
  }

  /* Deepen the foot of the arch so the caption and inset sit on something. */
  .arch__wash {
    position: absolute;
    inset: clamp(0.4rem, 1vw, 0.7rem);
    border-radius: 50% 50% 4px 4px / 40% 40% 1.5% 1.5%;
    background: linear-gradient(to top, rgba(28, 15, 21, 0.72) 0%, transparent 42%);
    pointer-events: none;
  }

  /* The lozenge at the crown of the arch. */
  .arch__keystone {
    position: absolute;
    top: clamp(-0.45rem, -1vw, -0.3rem);
    left: 50%;
    translate: -50% 0;
    width: 0.8rem;
    height: 0.8rem;
    rotate: 45deg;
    background: var(--gold);
    box-shadow: 0 0 0 4px var(--dark);
  }

  /* ================= inset plate ================= */
  .inset {
    position: absolute;
    left: clamp(-1rem, -2vw, 0rem);
    bottom: clamp(-1rem, -2vw, -0.5rem);
    width: clamp(8rem, 15vw, 11rem);
    margin: 0;
    background: var(--dark-raised);
    border: 1px solid rgba(181, 138, 67, 0.4);
    box-shadow: 0 18px 50px rgba(0, 0, 0, 0.5);
  }

  .inset img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }

  .inset figcaption {
    padding: 0.5rem 0.65rem 0.6rem;
    font-size: 0.72rem;
    line-height: 1.4;
    color: var(--on-dark-soft);
  }

  .inset__kicker {
    display: block;
    font-size: 0.56rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 0.1rem;
  }

  /* ================= occasion strip ================= */
  .occstrip {
    margin-top: clamp(2rem, 4vw, 3.2rem);
  }

  .occstrip__label {
    font-size: 0.68rem;
    letter-spacing: var(--tracking-wide);
    text-transform: uppercase;
    color: rgba(246, 239, 228, 0.5);
    margin-bottom: 0.9rem;
  }

  .occstrip__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 1px;
    background: rgba(246, 239, 228, 0.14);
    border: 1px solid rgba(246, 239, 228, 0.14);
  }

  .occstrip__item {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    height: 100%;
    padding: 1rem 1.1rem 1.2rem;
    background: rgba(20, 9, 14, 0.72);
    overflow: hidden;
  }

  .occstrip__item::before {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(160deg, var(--accent), transparent 85%);
    opacity: 0;
    transition: opacity 0.45s var(--ease);
  }

  .occstrip__item:hover::before {
    opacity: 0.9;
  }

  .occstrip__item > * {
    position: relative;
  }

  .occstrip__name {
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.2;
  }

  .occstrip__blurb {
    font-size: 0.74rem;
    line-height: 1.5;
    color: rgba(246, 239, 228, 0.6);
    transition: color 0.4s var(--ease);
  }

  .occstrip__item:hover .occstrip__blurb {
    color: rgba(246, 239, 228, 0.92);
  }

  .occstrip__go {
    margin-top: auto;
    padding-top: 0.6rem;
    color: var(--gold-light);
    opacity: 0;
    translate: -6px 0;
    transition: opacity 0.4s var(--ease), translate 0.4s var(--ease);
  }

  .occstrip__go svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .occstrip__item:hover .occstrip__go {
    opacity: 1;
    translate: 0 0;
  }

  /* ================= responsive ================= */
  @media (max-width: 1000px) {
    .hero__inner {
      grid-template-columns: 1fr;
      gap: 2.5rem;
      min-height: 0;
    }
    .hero__art {
      order: -1;
      max-width: 24rem;
    }
    .hero__title {
      max-width: 18ch;
    }
    .occstrip__list {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 680px) {
    .hero {
      padding-top: 5rem;
    }
    .hero__art {
      max-width: 20rem;
    }
    .inset {
      width: 7.5rem;
      left: -0.5rem;
    }
    .hero__trust {
      gap: 0.4rem 1rem;
    }
    .occstrip__list {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      border: 0;
      background: none;
      gap: 0.6rem;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .occstrip__list::-webkit-scrollbar {
      display: none;
    }
    .occstrip__list > li {
      flex: 0 0 13.5rem;
      scroll-snap-align: start;
    }
    .occstrip__item {
      border: 1px solid rgba(246, 239, 228, 0.2);
    }
    .occstrip__go {
      opacity: 1;
      translate: 0 0;
    }
  }

  @media (max-width: 400px) {
    /* The inset starts to crowd the arch at this width. */
    .inset {
      display: none;
    }
  }
</style>

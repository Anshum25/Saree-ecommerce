---
import Stars from "./Stars.astro";
import {
  availableColours,
  defaultVariant,
  discountPercent,
  fabricBySlug,
  formatINR,
  type Product,
} from "@jaiisha/catalogue";

interface Props {
  product: Product;
  /** First few cards above the fold should not lazy-load. */
  priority?: boolean;
}
const { product, priority = false } = Astro.props;

const variant = defaultVariant(product);
const colours = availableColours(product);
const off = discountPercent(variant);
const fabric = fabricBySlug(product.fabric);
const href = `/sarees/${product.slug}`;

const badgeLabel: Record<string, string> = {
  bestseller: "Bestseller",
  "new-arrival": "New",
  handloom: "Handloom",
  limited: "Limited",
  bridal: "Bridal",
};
/** One badge only — a card with four badges reads as a discount site. */
const badge = product.badges.find((b) => b === "limited")
  ?? product.badges.find((b) => b === "bestseller")
  ?? product.badges.find((b) => b === "new-arrival")
  ?? product.badges[0];

const front = variant.images.find((i) => i.kind === "model") ?? variant.images[0];
const back = variant.images.find((i) => i.kind === "pallu") ?? variant.images[1] ?? front;
---

<article class="card reveal" data-card data-slug={product.slug}>
  <div class="card__visual">
    <a class="card__media" href={href} aria-label={`${product.name} — ${formatINR(variant.price)}`}>
      <img
        class="card__img card__img--front"
        src={front.src}
        alt={front.alt}
        width={front.width}
        height={front.height}
        loading={priority ? "eager" : "lazy"}
        fetchpriority={priority ? "high" : "auto"}
        decoding="async"
        data-card-front
      />
      <img
        class="card__img card__img--back"
        src={back.src}
        alt=""
        width={back.width}
        height={back.height}
        loading="lazy"
        decoding="async"
        aria-hidden="true"
        data-card-back
      />

      {badge && <span class:list={["badge", "card__badge", badge === "limited" && "badge--wine"]}>{badgeLabel[badge] ?? badge}</span>}
      {off > 0 && <span class="card__off">{off}% off</span>}

      {
        variant.availability === "made_to_order" && (
          <span class="card__mto">Made to order{variant.leadTimeDays ? ` · ${variant.leadTimeDays} days` : ""}</span>
        )
      }
    </a>

    <button
      class="card__wish"
      type="button"
      aria-label={`Save ${product.name} to wishlist`}
      aria-pressed="false"
      data-wish={product.slug}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 20s-7.5-4.6-7.5-9.6A4.4 4.4 0 0 1 12 7.7a4.4 4.4 0 0 1 7.5 2.7c0 5-7.5 9.6-7.5 9.6Z" fill="none" stroke="currentColor" stroke-width="1.5" />
      </svg>
    </button>

    <button
      class="card__quick-add"
      type="button"
      aria-label={`Quick add ${product.name} to bag`}
      data-quick-add
      data-sku={variant.sku}
      data-slug={product.slug}
      data-name={product.name}
      data-colour={variant.colour.name}
      data-price={formatINR(variant.price)}
      data-paise={variant.price.paise}
      data-gst={product.tax.gstRate}
      data-image={front.src}
    >
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 8h12l-1 11.5H7L6 8Z" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M9.5 8V6.4a2.5 2.5 0 0 1 5 0V8" fill="none" stroke="currentColor" stroke-width="1.5"/></svg>
      <span>Add to Bag</span>
    </button>
  </div>

  <div class="card__body">
    <p class="card__fabric" title={`${fabric?.name ?? product.fabric} · ${product.craft}`}>{fabric?.name ?? product.fabric} · {product.craft}</p>
    <h3 class="card__name"><a href={href}>{product.name}</a></h3>

    <div class="card__price price">
      <span class="price__now">{formatINR(variant.price)}</span>
      {off > 0 && <span class="price__was">{formatINR(variant.mrp)}</span>}
    </div>

    <div class="card__foot">
      <Stars value={product.rating.value} count={product.rating.count} compact />
      {
        colours.length > 1 && (
          <ul class="card__colours" aria-label={`Available in ${colours.length} colours`}>
            {colours.map((c, i) => (
              <li>
                <button
                  class="swatch card__swatch"
                  type="button"
                  style={`--swatch:${c.hex}`}
                  aria-label={`Preview in ${c.name}`}
                  data-colour={c.slug}
                  data-colour-name={c.name}
                  data-front={`/img/products/${product.slug}-${c.slug}-model.jpg`}
                  data-back={`/img/products/${product.slug}-${c.slug}-pallu.jpg`}
                  data-sku={product.variants.find((v) => v.colour.slug === c.slug)?.sku || variant.sku}
                  aria-pressed={i === 0 ? "true" : "false"}
                ></button>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </div>
</article>

<style>
  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  /* --- media ----------------------------------------------------------- */
  .card__visual {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-sm);
    transition:
      translate 0.5s var(--ease-out-soft),
      box-shadow 0.5s var(--ease);
  }

  .card:hover .card__visual {
    translate: 0 -4px;
    box-shadow: 0 22px 44px -18px rgba(66, 20, 36, 0.45);
  }

  /* A band of light runs across the silk once per hover, the way zari
     catches a lamp when the cloth is turned. */
  .card__media::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      105deg,
      transparent 35%,
      rgba(255, 244, 214, 0.32) 48%,
      rgba(255, 244, 214, 0.08) 54%,
      transparent 62%
    );
    background-size: 260% 100%;
    background-position: 140% 0;
  }

  .card:hover .card__media::before {
    background-position: -40% 0;
    transition: background-position 1.1s var(--ease);
  }

  .card__media {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg-sunk);
    border-radius: var(--r-sm);
  }

  .card__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: opacity 0.65s var(--ease), scale 1.1s var(--ease-out-soft);
  }

  .card__img--back {
    opacity: 0;
  }

  .card:hover .card__img--front {
    opacity: 0;
  }

  .card:hover .card__img--back {
    opacity: 1;
  }

  .card:hover .card__img {
    scale: 1.04;
  }

  /* Thin gold frame drawn on hover, inside the image */
  .card__media::after {
    content: "";
    position: absolute;
    inset: 0.6rem;
    border: 1px solid rgba(240, 220, 174, 0.55);
    opacity: 0;
    transition: opacity 0.5s var(--ease), inset 0.6s var(--ease-out-soft);
    pointer-events: none;
  }

  .card:hover .card__media::after {
    opacity: 1;
    inset: 0.9rem;
  }

  .card__badge {
    position: absolute;
    top: 0.75rem;
    left: 0.75rem;
    z-index: 2;
  }

  .card__off {
    position: absolute;
    top: 0.75rem;
    right: 0.75rem;
    z-index: 2;
    padding: 0.25rem 0.55rem;
    background: var(--emerald);
    color: var(--ivory);
    font-size: 0.64rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    border-radius: var(--r-pill);
  }

  .card__mto {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    z-index: 2;
    padding: 0.5rem 0.9rem;
    background: rgba(28, 15, 21, 0.78);
    backdrop-filter: blur(4px);
    color: var(--gold-pale);
    font-size: 0.66rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  /* --- wishlist -------------------------------------------------------- */
  .card__wish {
    position: absolute;
    top: 0.6rem;
    right: 0.6rem;
    z-index: 3;
    display: grid;
    place-items: center;
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.9);
    color: var(--ink-soft);
    opacity: 0;
    translate: 0 -4px;
    transition: opacity 0.4s var(--ease), translate 0.4s var(--ease), color 0.3s var(--ease);
  }

  .card:hover .card__wish,
  .card__wish:focus-visible,
  .card__wish[aria-pressed="true"] {
    opacity: 1;
    translate: 0 0;
  }

  /* When a discount flag occupies the top right, drop the heart below it. */
  .card:has(.card__off) .card__wish {
    top: 2.9rem;
  }

  .card__wish svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .card__wish[aria-pressed="true"] {
    color: var(--maroon);
  }

  .card__wish[aria-pressed="true"] svg path {
    fill: currentColor;
  }

  /* --- body ------------------------------------------------------------ */
  .card__body {
    display: grid;
    gap: 0.4rem;
  }

  /* One line and two lines, always — so a row of cards lines up price
     with price however long the craft description runs. */
  .card__fabric {
    font-size: 0.7rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card__name {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-height: calc(2 * 1.25em);
    font-size: var(--step-1);
    font-weight: 400;
    line-height: 1.25;
  }

  .card__name a:hover {
    color: var(--wine);
  }

  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-top: 0.15rem;
    min-height: 1.6rem;
  }

  .card__colours {
    display: flex;
    gap: 0.35rem;
  }

  .card__swatch {
    --size: 1.05rem;
  }

  .card__swatch[aria-pressed="true"] {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.2), 0 0 0 1px var(--surface), 0 0 0 2px var(--gold);
  }

  /* --- quick add to bag ------------------------------------------------- */
  .card__quick-add {
    position: absolute;
    inset-inline: 0.75rem;
    bottom: 0.75rem;
    z-index: 4;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 0.9rem;
    background: rgba(28, 15, 21, 0.92);
    backdrop-filter: blur(8px);
    color: var(--gold-pale);
    border: 1px solid rgba(181, 138, 67, 0.5);
    border-radius: var(--r-sm);
    font-size: 0.74rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity 0.3s var(--ease), transform 0.3s var(--ease), background 0.2s, border-color 0.2s;
  }

  .card__quick-add svg {
    width: 0.95rem;
    height: 0.95rem;
  }

  .card:hover .card__quick-add,
  .card__quick-add:focus-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .card__quick-add:hover {
    background: var(--wine);
    border-color: var(--gold-light);
    color: #fff;
  }

  @media (prefers-reduced-motion: reduce) {
    .card:hover .card__visual {
      translate: none;
    }
    .card__media::before {
      display: none;
    }
  }

  @media (hover: none) {
    .card__quick-add {
      opacity: 0.95;
      transform: none;
    }
  }
</style>

<script>
  /**
   * Card interactions: swatch preview and wishlist.
   *
   * The wishlist is localStorage-only in Phase 1. In Phase 2 the same calls
   * move to POST /api/wishlist against the customer's account — the DOM
   * contract here does not change.
   */
  const KEY = "jaiisha:wishlist";

  const read = (): string[] => {
    try {
      return JSON.parse(localStorage.getItem(KEY) || "[]");
    } catch {
      return [];
    }
  };

  const write = (list: string[]) => {
    try {
      localStorage.setItem(KEY, JSON.stringify(list));
    } catch {
      /* private mode — the heart still toggles for this page view */
    }
    window.dispatchEvent(new CustomEvent("jaiisha:store"));
  };

  const saved = new Set(read());

  document.querySelectorAll<HTMLButtonElement>("[data-wish]").forEach((btn) => {
    const slug = btn.dataset.wish!;
    btn.setAttribute("aria-pressed", saved.has(slug) ? "true" : "false");

    btn.addEventListener("click", () => {
      if (saved.has(slug)) saved.delete(slug);
      else saved.add(slug);
      btn.setAttribute("aria-pressed", saved.has(slug) ? "true" : "false");
      write([...saved]);
    });
  });

  document.querySelectorAll<HTMLElement>("[data-card]").forEach((card) => {
    const front = card.querySelector<HTMLImageElement>("[data-card-front]");
    const back = card.querySelector<HTMLImageElement>("[data-card-back]");
    const swatches = card.querySelectorAll<HTMLButtonElement>("[data-colour]");
    const quickAddBtn = card.querySelector<HTMLButtonElement>("[data-quick-add]");

    const apply = (btn: HTMLButtonElement) => {
      if (front && btn.dataset.front) front.src = btn.dataset.front;
      if (back && btn.dataset.back) back.src = btn.dataset.back;
      swatches.forEach((s) => s.setAttribute("aria-pressed", String(s === btn)));

      if (quickAddBtn) {
        if (btn.dataset.sku) quickAddBtn.dataset.sku = btn.dataset.sku;
        if (btn.dataset.colourName) quickAddBtn.dataset.colour = btn.dataset.colourName;
        if (btn.dataset.front) quickAddBtn.dataset.image = btn.dataset.front;
      }
    };

    swatches.forEach((btn) => {
      // Pointer preview, plus click for touch devices.
      btn.addEventListener("mouseenter", () => apply(btn));
      btn.addEventListener("focus", () => apply(btn));
      btn.addEventListener("click", (e) => {
        e.preventDefault();
        apply(btn);
      });
    });

    // Quick add to bag button
    quickAddBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      const item = {
        sku: quickAddBtn.dataset.sku!,
        slug: quickAddBtn.dataset.slug!,
        name: quickAddBtn.dataset.name!,
        colour: quickAddBtn.dataset.colour!,
        price: quickAddBtn.dataset.price!,
        paise: Number(quickAddBtn.dataset.paise!),
        gst: Number(quickAddBtn.dataset.gst!),
        image: quickAddBtn.dataset.image!,
        quantity: 1,
      };
      if ((window as any).jaiishaCart?.add) {
        (window as any).jaiishaCart.add(item);
      }
    });
  });
</script>

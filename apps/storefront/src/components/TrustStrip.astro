---
const items = [
  {
    title: "Weaver's certificate",
    body: "Every saree names the loom and the family that wove it.",
    icon: "certificate",
  },
  {
    title: "Complimentary shipping",
    body: "Free across India above ₹3,000. Insured, boxed, tracked.",
    icon: "ship",
  },
  {
    title: "7-day returns",
    body: "Unworn, with the certificate intact. Made-to-order excepted.",
    icon: "return",
  },
  {
    title: "Spoken to, not bot-ed",
    body: "Drape advice and colour matching on WhatsApp, 10am–8pm.",
    icon: "chat",
  },
];
---

<section class="trust" aria-label="Why buy from JAIISHA">
  <ul class="trust__list shell">
    {
      items.map((it) => (
        <li class="trust__item">
          <span class="trust__icon" aria-hidden="true">
            {it.icon === "certificate" && (
              <svg viewBox="0 0 24 24"><circle cx="12" cy="10" r="5.5" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M9 15l-1.5 6 4.5-2.4L16.5 21 15 15" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
            )}
            {it.icon === "ship" && (
              <svg viewBox="0 0 24 24"><path d="M3 8h11v9H3zM14 11h4l3 3v3h-7z" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="7" cy="18.5" r="1.6" fill="none" stroke="currentColor" stroke-width="1.3" /><circle cx="17.5" cy="18.5" r="1.6" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
            )}
            {it.icon === "return" && (
              <svg viewBox="0 0 24 24"><path d="M4 11a8 8 0 1 1 2.6 5.9" fill="none" stroke="currentColor" stroke-width="1.3" /><path d="M4 5.5V11h5.5" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
            )}
            {it.icon === "chat" && (
              <svg viewBox="0 0 24 24"><path d="M20 12.5c0 3.9-3.6 7-8 7a9 9 0 0 1-2.6-.4L5 20.5l1-3.2A6.7 6.7 0 0 1 4 12.5c0-3.9 3.6-7 8-7s8 3.1 8 7Z" fill="none" stroke="currentColor" stroke-width="1.3" /></svg>
            )}
          </span>
          <div>
            <h3 class="trust__title">{it.title}</h3>
            <p class="trust__body">{it.body}</p>
          </div>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .trust {
    background: var(--wine-deep);
    color: var(--ivory);
    border-block: 1px solid rgba(181, 138, 67, 0.3);
  }

  .trust__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
    padding-block: clamp(1.6rem, 3.5vw, 2.4rem);
  }

  .trust__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.85rem;
    align-items: start;
  }

  .trust__icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border: 1px solid rgba(181, 138, 67, 0.55);
    border-radius: 50%;
    color: var(--gold-light);
    flex: none;
  }

  .trust__icon svg {
    width: 1.25rem;
    height: 1.25rem;
  }

  .trust__title {
    font-family: var(--font-sans);
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--gold-light);
  }

  .trust__body {
    margin-top: 0.25rem;
    font-size: 0.82rem;
    font-weight: 300;
    line-height: 1.55;
    color: rgba(246, 239, 228, 0.78);
  }

  @media (max-width: 900px) {
    .trust__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      row-gap: 1.5rem;
    }
  }

  @media (max-width: 480px) {
    .trust__list {
      grid-template-columns: 1fr;
    }
  }
</style>

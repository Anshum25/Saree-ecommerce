---
import { FABRICS, defaultVariant, queryProducts } from "@jaiisha/catalogue";

/**
 * The collections, by cloth.
 *
 * Occasion answers "what is it for"; this answers "what is it made of", which
 * is the second question every buyer asks. Each weave is a tall panel that
 * opens out when it is hovered or focused, showing the note on how that cloth
 * behaves and how many pieces are on the shelf. The photograph is the
 * best-selling saree in that weave, so the panels change as the shop does.
 *
 * On touch screens there is no hover to open a panel, so they lie in a
 * horizontal scroller, every one already open.
 */

const weaves = FABRICS.map((f) => {
  const items = queryProducts({ fabric: f.slug, sort: "bestsellers", perPage: 99 }).items;
  const lead = items[0];
  const image = lead
    ? (defaultVariant(lead).images.find((i) => i.kind === "model") ?? defaultVariant(lead).images[0])
    : undefined;
  return { ...f, count: items.length, image };
}).filter((w) => w.count > 0 && w.image);
---

<section class="weave section" aria-labelledby="weave-title">
  <div class="shell">
    <div class="section-head section-head--split weave__head">
      <div>
        <p class="eyebrow">The collections</p>
        <h2 class="weave__title" id="weave-title">
          Choose by the cloth, <em>feel it before you touch it</em>
        </h2>
      </div>
      <p class="weave__intro">
        Every silk falls, pleats and catches light differently. Here is what each one is like to
        wear, and which occasions it suits.
      </p>
    </div>

    <ul class="weave__list">
      {
        weaves.map((w, i) => (
          <li class="weave__item">
            <a class="weave__card reveal" href={`/sarees?fabric=${w.slug}`}>
              <img
                class="weave__img"
                src={w.image!.src}
                alt={w.image!.alt}
                width={w.image!.width}
                height={w.image!.height}
                loading="lazy"
                decoding="async"
              />
              <span class="weave__shade" aria-hidden="true" />
              <span class="weave__no" aria-hidden="true">
                {String(i + 1).padStart(2, "0")}
              </span>
              <span class="weave__body">
                <span class="weave__name">{w.name}</span>
                <span class="weave__more">
                  <span class="weave__note">{w.note}</span>
                  <span class="weave__go">
                    {w.count} {w.count === 1 ? "saree" : "sarees"}
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 12h15M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5" />
                    </svg>
                  </span>
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .weave {
    position: relative;
    background: var(--dark);
    color: var(--on-dark);
    overflow: hidden;
  }

  .weave::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(50% 60% at 85% 10%, rgba(101, 29, 53, 0.55), transparent 70%),
      repeating-linear-gradient(45deg, rgba(181, 138, 67, 0.05) 0 1px, transparent 1px 40px),
      repeating-linear-gradient(-45deg, rgba(181, 138, 67, 0.05) 0 1px, transparent 1px 40px);
    pointer-events: none;
  }

  .weave .shell {
    position: relative;
  }

  .weave__head {
    align-items: end;
  }

  .weave__title {
    max-width: 18ch;
    margin-top: 0.5rem;
    font-size: var(--step-3);
    font-weight: 300;
  }

  .weave__title em {
    display: block;
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    text-transform: none;
    color: var(--gold-light);
  }

  .weave__intro {
    max-width: 40ch;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--on-dark-soft);
  }

  /* ---- the accordion ---------------------------------------------------- */
  .weave__list {
    display: flex;
    gap: 0.6rem;
    height: clamp(26rem, 62vh, 36rem);
  }

  .weave__item {
    flex: 1 1 0;
    min-width: 0;
    transition: flex-grow 0.8s var(--ease-out-soft);
  }

  /* The first panel is open until the pointer picks another. */
  .weave__item:first-child,
  .weave__list:hover .weave__item:hover,
  .weave__item:focus-within {
    flex-grow: 3.4;
  }

  .weave__list:hover .weave__item:first-child:not(:hover),
  .weave__list:focus-within .weave__item:first-child:not(:focus-within) {
    flex-grow: 1;
  }

  .weave__card {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    border: 1px solid rgba(181, 138, 67, 0.25);
    border-radius: var(--r-sm);
    background: #12080c;
  }

  .weave__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 22%;
    scale: 1.08;
    filter: saturate(0.75) brightness(0.8);
    transition:
      scale 1.2s var(--ease-out-soft),
      filter 0.8s var(--ease);
  }

  .weave__item:hover .weave__img,
  .weave__item:focus-within .weave__img,
  .weave__list:not(:hover) .weave__item:first-child .weave__img {
    scale: 1;
    filter: none;
  }

  .weave__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(18, 8, 12, 0.92) 0%, rgba(18, 8, 12, 0.25) 50%, rgba(18, 8, 12, 0.1));
  }

  .weave__no {
    position: absolute;
    top: 1rem;
    left: 1.1rem;
    font-family: var(--font-display);
    font-size: 0.85rem;
    color: var(--gold-light);
    letter-spacing: 0.12em;
  }

  .weave__body {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    display: grid;
    gap: 0.6rem;
    padding: clamp(1rem, 2vw, 1.6rem);
  }

  /* A closed panel shows its name up the side, like the spine of a folded
     saree on a shelf; the open one turns it to read across. */
  .weave__name {
    justify-self: start;
    font-family: var(--font-display);
    font-size: clamp(1.1rem, 0.9rem + 0.8vw, 1.8rem);
    line-height: 1.15;
    white-space: nowrap;
    writing-mode: vertical-rl;
    rotate: 180deg;
  }

  .weave__item:hover .weave__name,
  .weave__item:focus-within .weave__name,
  .weave__list:not(:hover) .weave__item:first-child .weave__name {
    writing-mode: horizontal-tb;
    rotate: none;
  }

  /* The note takes no room on a closed panel, so the spine sits at the foot. */
  .weave__item:not(:hover):not(:focus-within) .weave__more {
    position: absolute;
    visibility: hidden;
  }

  .weave__list:not(:hover) .weave__item:first-child .weave__more {
    position: static;
    visibility: visible;
  }

  /* The note opens out only on the open panel. */
  .weave__more {
    display: grid;
    gap: 0.7rem;
    max-width: 34ch;
    opacity: 0;
    translate: 0 10px;
    transition:
      opacity 0.4s var(--ease),
      translate 0.5s var(--ease-out-soft);
  }

  .weave__item:hover .weave__more,
  .weave__item:focus-within .weave__more,
  .weave__list:not(:hover) .weave__item:first-child .weave__more {
    opacity: 1;
    translate: 0 0;
    transition-delay: 0.25s;
  }

  .weave__note {
    font-size: 0.86rem;
    line-height: 1.6;
    color: rgba(246, 239, 228, 0.8);
    white-space: normal;
  }

  .weave__go {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-light);
  }

  .weave__go svg {
    width: 1rem;
    height: 1rem;
    transition: translate 0.35s var(--ease);
  }

  .weave__card:hover .weave__go svg {
    translate: 4px 0;
  }

  /* ---- touch and narrow screens: a scroller, every panel open ---------- */
  @media (max-width: 860px), (hover: none) {
    .weave__list {
      height: auto;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      margin-inline: calc(var(--gutter) * -1);
      padding-inline: var(--gutter);
    }
    .weave__list::-webkit-scrollbar {
      display: none;
    }
    .weave__item,
    .weave__item:first-child,
    .weave__list:hover .weave__item:first-child:not(:hover) {
      flex: 0 0 min(72vw, 18rem);
      scroll-snap-align: start;
    }
    .weave__card {
      aspect-ratio: 3 / 4.4;
      height: auto;
    }
    .weave__img {
      scale: 1;
      filter: none;
    }
    .weave__more {
      opacity: 1;
      translate: none;
    }
    .weave__name {
      white-space: normal;
      writing-mode: horizontal-tb !important;
      rotate: none !important;
    }
    .weave__more {
      position: static !important;
      visibility: visible !important;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .weave__item,
    .weave__img,
    .weave__more {
      transition: none;
    }
  }
</style>

---
/**
 * The cultural argument, and the house's intention.
 *
 * This is the section that separates a boutique from a marketplace. It was
 * previously five paragraphs of text with a strip of photographs bolted on
 * underneath, so the imagery illustrated nothing in particular and the
 * reasoning read as a wall.
 *
 * Now each reason is a tab: one photograph, the tradition it belongs to,
 * and — the part that was missing — what JAIISHA actually does about it.
 * Five tall chapters ran to several screens; as tabs they take one. A
 * claim about heritage means very little without the commitment that follows
 * from it, so every chapter ends with one.
 */

const reasons = [
  {
    no: "01",
    deva: "अखण्ड",
    title: "Unstitched, and therefore whole",
    body:
      "Classical Indian dress avoided the needle. Cloth that had not been cut was considered pure enough for a temple, a ritual and a wedding, which is why the saree, the dhoti and the angavastram all survived while stitched court dress came and went.",
    commitment:
      "So we sell it as it leaves the loom — uncut, 5.5 or 6.3 metres, blouse piece still attached. Nothing is trimmed to make a parcel cheaper to post.",
    image: "/img/culture/loom-detail.jpg",
    alt: "Uncut cloth and warp threads running through the reed of a wooden handloom",
    caption: "Cloth, still on the loom",
  },
  {
    no: "02",
    deva: "रंग",
    title: "The colour speaks before you do",
    body:
      "Red and maroon for a bride and for saubhagya. Ivory and gold for a pooja. Green for a new beginning and for Teej. Yellow for haldi. A woman walking into a room in the right colour has already said the right thing.",
    commitment:
      "So every listing names its true shade, not a marketing name. If the colour has to be exact, we send a video of that actual piece in daylight and in lamp light before you pay.",
    image: "/img/culture/tradition-festival.jpg",
    alt: "Two women in red and emerald Banarasi silk sarees with gold zari borders",
    caption: "Rani red and emerald, as they are worn",
  },
  {
    no: "03",
    deva: "विरासत",
    title: "It is inherited, not replaced",
    body:
      "A Banarasi outlives the occasion it was bought for. It is folded into muslin, refolded every few months, and handed over at a daughter's wedding. Very few garments in the world are bought with the next generation in mind.",
    commitment:
      "So we weave for thirty years, not for a season: pure Katan, gold-plated silver zari, and a care card in the box that tells you how to fold it so the creases never become cracks.",
    image: "/img/culture/bride-alt.jpg",
    alt: "A bride in red and gold, eyes lowered, wearing heavy traditional gold jewellery",
    caption: "Bought once, kept for a daughter",
  },
  {
    no: "04",
    deva: "अवसर",
    title: "The occasion chooses the weave",
    body:
      "A kadwa Katan for a wedding, a tissue for Diwali lamps, an ivory Katan for a griha pravesh, a light organza for a reception you will dance at. Weight, length and zari are not style choices so much as answers to the day.",
    commitment:
      "So the shop is arranged by occasion before anything else. Tell us the day and we will narrow six centuries of weaving down to three sarees.",
    image: "/img/culture/pooja-lamps.jpg",
    alt: "A brass thali of lit clay diyas surrounded by scattered flower petals",
    caption: "The day decides the cloth",
  },
  {
    no: "05",
    deva: "हाथ",
    title: "Someone's hands are in it",
    body:
      "A handloom Banarasi takes two to four weeks on a pit loom in Varanasi, worked by a family that has done this for generations. Buying one keeps a loom running — which is the honest reason handloom costs what it does.",
    commitment:
      "So we buy direct from weaving families in Madanpura and Lallapura, pay per piece at a rate agreed before the warp is dressed, and name the loom on the certificate in your box.",
    image: "/img/culture/weaver-at-loom.jpg",
    alt: "A weaver at a large loom, golden warp threads radiating out across the frame",
    caption: "Four weeks of one person's work",
  },
];
---

<section class="why section" id="why" aria-labelledby="why-title">
  <div class="shell">
    <div class="why__head">
      <div>
        <p class="eyebrow">Why the saree endures</p>
        <h2 class="why__title" id="why-title">
          Not a dress that came back into fashion. <em class="why__title-em">One that never left.</em>
        </h2>
      </div>
      <p class="why__lede">
        Five traditions every Indian family knows by heart — and, because we would rather explain a
        saree than sell one, the promise each of them obliges us to keep.
      </p>
    </div>

    <!-- Five reasons as tabs: the list on the left, the chosen one on the
         right. Every panel is in the HTML; the script only picks which shows. -->
    <div class="ws" data-ws>
      <div class="ws__tabs" role="tablist" aria-label="Five reasons" aria-orientation="vertical">
        {
          reasons.map((r, i) => (
            <button
              type="button"
              role="tab"
              class="ws__tab"
              id={`ws-tab-${i}`}
              aria-controls={`ws-panel-${i}`}
              aria-selected={i === 0 ? "true" : "false"}
              tabindex={i === 0 ? "0" : "-1"}
              data-ws-tab={i}
            >
              <span class="ws__no">{r.no}</span>
              <span class="ws__tab-text">
                <span class="ws__deva" lang="hi">{r.deva}</span>
                <span class="ws__name">{r.title}</span>
              </span>
            </button>
          ))
        }
      </div>

      <div class="ws__stage">
        {
          reasons.map((r, i) => (
            <div
              class="ws__panel"
              role="tabpanel"
              id={`ws-panel-${i}`}
              aria-labelledby={`ws-tab-${i}`}
              hidden={i !== 0}
              data-ws-panel={i}
            >
              <figure class="ws__media">
                <img src={r.image} alt={r.alt} width="1600" height="1200" loading="lazy" decoding="async" />
                <figcaption>{r.caption}</figcaption>
              </figure>
              <div class="ws__text">
                <h3 class="ws__title">{r.title}</h3>
                <p class="ws__body">{r.body}</p>
                <p class="ws__commit">
                  <span class="ws__commit-label">What we do about it</span>
                  {r.commitment}
                </p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-ws]").forEach((root) => {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>("[data-ws-tab]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-ws-panel]")];

    const select = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        t.setAttribute("aria-selected", j === i ? "true" : "false");
        t.tabIndex = j === i ? 0 : -1;
      });
      panels.forEach((p, j) => (p.hidden = j !== i));
      if (focus) tabs[i]?.focus();
    };

    tabs.forEach((t, i) => {
      t.addEventListener("click", () => select(i));
      /* On a pointer, hovering a reason is enough to read it. */
      t.addEventListener("pointerenter", (e) => {
        if ((e as PointerEvent).pointerType === "mouse") select(i);
      });
    });

    root.querySelector("[role=tablist]")?.addEventListener("keydown", (e) => {
      const ev = e as KeyboardEvent;
      const cur = tabs.findIndex((t) => t.getAttribute("aria-selected") === "true");
      const keys: Record<string, number> = {
        ArrowDown: 1,
        ArrowRight: 1,
        ArrowUp: -1,
        ArrowLeft: -1,
      };
      if (!(ev.key in keys)) return;
      ev.preventDefault();
      select((cur + keys[ev.key] + tabs.length) % tabs.length, true);
    });
  });
</script>

<style>
  .why {
    background:
      radial-gradient(60% 50% at 85% 0%, rgba(181, 138, 67, 0.08), transparent 70%),
      var(--bg);
  }

  .why__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 1rem clamp(2rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: clamp(1.6rem, 3vw, 2.4rem);
  }

  .why__title {
    margin-top: 0.5rem;
    font-size: var(--step-3);
    font-weight: 300;
  }

  .why__title-em {
    display: block;
    font-family: "Playfair Display", Georgia, serif;
    font-style: italic;
    text-transform: none;
    color: var(--wine);
  }

  .why__lede {
    max-width: 46ch;
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  /* ---- the panel --------------------------------------------------------- */
  .ws {
    display: grid;
    grid-template-columns: minmax(15rem, 0.8fr) minmax(0, 2fr);
    border: 1px solid var(--line);
    border-top: 2px solid var(--gold);
    background: var(--surface);
    box-shadow: 0 24px 50px -34px rgba(66, 20, 36, 0.45);
  }

  .ws__tabs {
    display: grid;
    align-content: stretch;
    border-right: 1px solid var(--line);
    background: linear-gradient(180deg, rgba(181, 138, 67, 0.06), transparent);
  }

  .ws__tab {
    position: relative;
    display: grid;
    grid-template-columns: 2rem 1fr;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 1.2rem;
    border: 0;
    border-bottom: 1px solid var(--line);
    background: none;
    text-align: left;
    color: var(--ink-soft);
    cursor: pointer;
    transition: background-color 0.3s var(--ease), color 0.3s var(--ease);
  }

  .ws__tab:last-child {
    border-bottom: 0;
  }

  .ws__tab::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 3px;
    background: var(--wine);
    scale: 1 0;
    transition: scale 0.4s var(--ease-out-soft);
  }

  .ws__tab:hover {
    background: rgba(181, 138, 67, 0.08);
  }

  .ws__tab[aria-selected="true"] {
    background: var(--surface);
    color: var(--ink);
  }

  .ws__tab[aria-selected="true"]::before {
    scale: 1 1;
  }

  .ws__no {
    font-family: var(--font-display);
    font-size: 1.1rem;
    color: var(--gold);
  }

  .ws__tab-text {
    display: grid;
    gap: 0.1rem;
  }

  .ws__deva {
    font-size: 0.78rem;
    color: var(--gold);
  }

  .ws__name {
    font-family: var(--font-display);
    font-size: 0.95rem;
    line-height: 1.25;
  }

  .ws__tab[aria-selected="true"] .ws__name {
    color: var(--wine);
  }

  .ws__stage {
    display: grid;
  }

  .ws__panel {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(1.2rem, 2.5vw, 2rem);
    padding: clamp(1.2rem, 2.5vw, 2rem);
    animation: wsIn 0.5s var(--ease-out-soft);
  }

  .ws__panel[hidden] {
    display: none;
  }

  @keyframes wsIn {
    from {
      opacity: 0;
      translate: 0 10px;
    }
  }

  .ws__media {
    margin: 0;
  }

  .ws__media img {
    display: block;
    width: 100%;
    height: clamp(14rem, 26vw, 20rem);
    object-fit: cover;
    border-radius: var(--r-sm);
  }

  .ws__media figcaption {
    margin-top: 0.5rem;
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .ws__text {
    display: grid;
    align-content: center;
    gap: 0.8rem;
  }

  .ws__title {
    font-size: var(--step-2);
    font-weight: 400;
  }

  .ws__body {
    font-size: 0.92rem;
    line-height: 1.7;
    color: var(--ink-soft);
  }

  .ws__commit {
    padding: 0.9rem 1rem;
    border-left: 2px solid var(--wine);
    background: var(--bg-sunk);
    font-size: 0.84rem;
    line-height: 1.6;
  }

  .ws__commit-label {
    display: block;
    margin-bottom: 0.25rem;
    font-size: 0.6rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--wine);
  }

  @media (max-width: 900px) {
    .why__head {
      grid-template-columns: 1fr;
    }
    .ws {
      grid-template-columns: 1fr;
    }
    /* The reasons become a row of chips that scrolls sideways. */
    .ws__tabs {
      display: flex;
      overflow-x: auto;
      scrollbar-width: none;
      border-right: 0;
      border-bottom: 1px solid var(--line);
    }
    .ws__tabs::-webkit-scrollbar {
      display: none;
    }
    .ws__tab {
      flex: 0 0 auto;
      grid-template-columns: auto auto;
      border-bottom: 0;
      border-right: 1px solid var(--line);
    }
    .ws__tab::before {
      top: auto;
      right: 0;
      width: auto;
      height: 3px;
      scale: 0 1;
    }
    .ws__tab[aria-selected="true"]::before {
      scale: 1 1;
    }
    .ws__panel {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ws__panel {
      animation: none;
    }
  }
</style>

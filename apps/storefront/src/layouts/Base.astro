---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import CartDrawer from "../components/CartDrawer.astro";
import { SITE, whatsappLink } from "../lib/site.ts";

interface Props {
  title: string;
  description: string;
  /** Transparent header laid over a dark hero. */
  overHero?: boolean;
  /** Preload the hero image on pages whose LCP is a photograph. */
  preloadImage?: string;
  /** Absolute or root-relative share image. */
  image?: string;
  /** Extra JSON-LD, already stringified objects. */
  schema?: Record<string, unknown>[];
  canonicalPath?: string;
}

const {
  title,
  description,
  overHero = false,
  preloadImage,
  image = "/img/og-default.svg",
  schema = [],
  canonicalPath,
} = Astro.props;

const canonical = new URL(canonicalPath ?? Astro.url.pathname, Astro.site ?? SITE.url).href;
const ogImage = new URL(image, Astro.site ?? SITE.url).href;

const organisation = {
  "@context": "https://schema.org",
  "@type": "Store",
  name: SITE.name,
  description: SITE.tagline,
  url: SITE.url,
  telephone: `+${SITE.whatsapp}`,
  email: SITE.email,
  sameAs: [SITE.instagram],
  address: {
    "@type": "PostalAddress",
    addressLocality: "Varanasi",
    addressRegion: "Uttar Pradesh",
    addressCountry: "IN",
  },
  currenciesAccepted: "INR",
  priceRange: "₹₹₹",
};

/* An inline favicon keeps the brand mark without another request. */
const favicon =
  "data:image/svg+xml," +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><rect width="32" height="32" fill="#651d35"/><path d="M16 4 L20 12 L28 16 L20 20 L16 28 L12 20 L4 16 L12 12 Z" fill="none" stroke="#d9b872" stroke-width="1.5" stroke-linejoin="round"/><circle cx="16" cy="16" r="2.6" fill="#d9b872"/></svg>`,
  );
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#651d35" />
    <!-- The palette is designed light. Saying so stops browsers that
         auto-darken pages from repainting it, which turned dark text on
         light grounds into dark text on dark ones. -->
    <meta name="color-scheme" content="light only" />
    <link rel="icon" href={favicon} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="en_IN" />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Plus+Jakarta+Sans:wght@300;400;500;600;700&family=Rozha+One&family=Tiro+Devanagari+Hindi&display=swap"
    />

    <!-- The hero photograph is the LCP element; preload it so it is not
         discovered late by the parser. -->
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    <script
      type="application/ld+json"
      set:html={JSON.stringify(organisation)}
    />
    {
      schema.map((s) => (
        <script type="application/ld+json" set:html={JSON.stringify(s)} />
      ))
    }
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <Header overHero={overHero} />

    <main id="main">
      <slot />
    </main>

    <Footer />

    <!-- Persistent WhatsApp enquiry button: the Phase 1 ordering channel. -->
    <a
      class="wa-float"
      href={whatsappLink("Hello JAIISHA, I am looking at your sarees and would like some help.")}
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Enquire on WhatsApp"
    >
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <path
          d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Z"
          fill="currentColor"></path>
        <path
          d="M8.6 7.6c.4 0 .8.2 1 .6l.7 1.6c.1.3 0 .6-.2.8l-.7.7c.5 1 1.3 1.8 2.3 2.3l.7-.7c.2-.2.5-.3.8-.2l1.6.7c.4.2.6.6.6 1 0 1-.8 1.8-1.8 1.8A7.4 7.4 0 0 1 6.8 9.4c0-1 .8-1.8 1.8-1.8Z"
          fill="#1faa59"></path>
      </svg>
      <span class="wa-float__label">Order on WhatsApp</span>
    </a>

    <style>
      .skip {
        position: absolute;
        top: -100%;
        left: 1rem;
        z-index: 200;
        padding: 0.7rem 1.2rem;
        background: var(--wine);
        color: var(--ivory);
        font-size: 0.8rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
      }

      .skip:focus {
        top: 1rem;
      }

      .wa-float {
        position: fixed;
        right: clamp(0.9rem, 2.5vw, 1.8rem);
        bottom: clamp(0.9rem, 2.5vw, 1.8rem);
        z-index: 70;
        display: inline-flex;
        align-items: center;
        gap: 0.55rem;
        padding: 0.65rem;
        background: #1faa59;
        color: #fff;
        border-radius: var(--r-pill);
        box-shadow: 0 8px 28px rgba(31, 170, 89, 0.4);
        transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease),
          padding 0.4s var(--ease);
      }

      .wa-float svg {
        width: 1.7rem;
        height: 1.7rem;
        flex: none;
      }

      .wa-float__label {
        max-width: 0;
        overflow: hidden;
        white-space: nowrap;
        font-size: 0.76rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: max-width 0.5s var(--ease-out-soft), padding-right 0.5s var(--ease);
      }

      .wa-float:hover {
        transform: translateY(-2px);
        box-shadow: 0 12px 34px rgba(31, 170, 89, 0.5);
      }

      .wa-float:hover .wa-float__label,
      .wa-float:focus-visible .wa-float__label {
        max-width: 12rem;
        padding-right: 0.5rem;
      }
    </style>

    <script>
      // Scroll reveal. One observer for the whole page, elements unobserved
      // once they have appeared so nothing re-animates on the way back up.
      const reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      const targets = document.querySelectorAll<HTMLElement>(".reveal");

      if (reduced || !("IntersectionObserver" in window)) {
        targets.forEach((el) => el.classList.add("is-in"));
      } else {
        const io = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              const el = entry.target as HTMLElement;
              // Stagger siblings slightly for an unhurried feel.
              const siblings = Array.from(el.parentElement?.children ?? []);
              const i = Math.min(siblings.indexOf(el), 6);
              el.style.transitionDelay = `${i * 70}ms`;
              el.classList.add("is-in");
              io.unobserve(el);
            });
          },
          { rootMargin: "0px 0px -8% 0px", threshold: 0.08 },
        );
        targets.forEach((el) => io.observe(el));
      }
    </script>

    <CartDrawer />
  </body>
</html>

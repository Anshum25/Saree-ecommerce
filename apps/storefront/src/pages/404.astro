---
import Base from "../layouts/Base.astro";
import { OCCASIONS } from "@jaiisha/catalogue";
import { SITE } from "../lib/site.ts";
---

<Base
  title={`Page not found | ${SITE.name}`}
  description="That page does not exist. Browse the collection instead."
>
  <div class="shell nf">
    <p class="eyebrow">404</p>
    <h1 class="nf__title">That thread does not go anywhere</h1>
    <p class="nf__body">
      The page you were after has moved or never existed. The sarees are all still here.
    </p>

    <div class="nf__actions">
      <a class="btn" href="/sarees">Browse all sarees</a>
      <a class="btn btn--ghost" href="/">Back to home</a>
    </div>

    <nav class="nf__links" aria-label="Shop by occasion">
      <p class="nf__links-head">Or start from the occasion</p>
      <ul>
        {OCCASIONS.map((o) => <li><a href={`/occasion/${o.slug}`}>{o.name}</a></li>)}
      </ul>
    </nav>
  </div>
</Base>

<style>
  .nf {
    padding-block: clamp(3rem, 9vw, 7rem) var(--section-y);
    display: grid;
    gap: 0.7rem;
    justify-items: start;
    min-height: 55svh;
  }

  .nf__title {
    font-size: var(--step-4);
    font-weight: 300;
    max-width: 24ch;
  }

  .nf__body {
    max-width: 50ch;
    color: var(--ink-soft);
    font-weight: 300;
    font-size: var(--step-1);
  }

  .nf__actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-top: 1rem;
  }

  .nf__links {
    margin-top: 2.5rem;
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
    width: 100%;
  }

  .nf__links-head {
    font-size: 0.68rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--ink-faint);
    margin-bottom: 0.8rem;
  }

  .nf__links ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .nf__links a {
    display: inline-block;
    padding: 0.45rem 1rem;
    border: 1px solid var(--line-strong);
    border-radius: var(--r-pill);
    font-size: 0.8rem;
  }

  .nf__links a:hover {
    background: var(--wine);
    border-color: var(--wine);
    color: var(--ivory);
  }
</style>

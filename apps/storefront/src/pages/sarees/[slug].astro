</style>

<script>
  /**
   * PDP behaviour: variant switching, gallery, magnifier, lightbox, video,
   * wishlist, bag and share.
   */
  interface VImage {
    src: string;
    alt: string;
    kind: string;
  }
  interface VData {
    id: string;
    sku: string;
    colour: string;
    colourSlug: string;
    secondary: string | null;
    price: string;
    /** Integer paise — the cart totals from this, never from the formatted string. */
    paise: number;
    mrp: string;
    off: number;
    availability: string;
    state: string;
    images: VImage[];
  }

  const root = document.querySelector<HTMLElement>("[data-pdp]");
  if (root) {
    const variants: VData[] = JSON.parse(root.dataset.variants || "[]");
    let current = 0;
    let imageIndex = 0;

    const mainImg = root.querySelector<HTMLImageElement>("[data-main-img]");
    const thumbList = root.querySelector<HTMLElement>("[data-thumbs]");
    const priceEl = root.querySelector<HTMLElement>("[data-price]");
    const mrpEl = root.querySelector<HTMLElement>("[data-mrp]");
    const offEl = root.querySelector<HTMLElement>("[data-off]");
    const skuEl = root.querySelector<HTMLElement>("[data-sku]");
    const colourName = root.querySelector<HTMLElement>("[data-colour-name]");
    const availBox = root.querySelector<HTMLElement>("[data-availability]");
    const availText = root.querySelector<HTMLElement>("[data-availability-text]");
    const waLink = root.querySelector<HTMLAnchorElement>("[data-wa]");
    const specSku = root.querySelector<HTMLElement>('[data-spec="sku"]');
    const specColour = root.querySelector<HTMLElement>('[data-spec="colour"]');
    const specAvail = root.querySelector<HTMLElement>('[data-spec="availability"]');

    /** Rebuild the thumbnail strip for the selected colourway. */
    const paintThumbs = (v: VData) => {
      if (!thumbList) return;
      const videoThumb = thumbList.querySelector(".gal__thumb--video")?.closest("li");
      thumbList.querySelectorAll("li").forEach((li) => {
        if (li !== videoThumb) li.remove();
      });

      v.images.forEach((im, i) => {
        const li = document.createElement("li");
        li.innerHTML = `
          <button class="gal__thumb" type="button" data-thumb="${i}"
                  aria-label="View image ${i + 1}: ${im.kind}"
                  aria-pressed="${i === imageIndex}">
            <img src="${im.src}" alt="" width="300" height="400" loading="lazy" decoding="async"/>
            <span class="gal__thumb-kind">${im.kind}</span>
          </button>`;
        thumbList.insertBefore(li, videoThumb ?? null);
      });

      bindThumbs();
    };

    const showImage = (i: number) => {
      const v = variants[current];
      if (!v?.images[i] || !mainImg) return;
      imageIndex = i;
      mainImg.src = v.images[i].src;
      mainImg.alt = v.images[i].alt;
      root
        .querySelectorAll<HTMLButtonElement>("[data-thumb]")
        .forEach((b) => b.setAttribute("aria-pressed", String(Number(b.dataset.thumb) === i)));
    };

    const bindThumbs = () => {
      root.querySelectorAll<HTMLButtonElement>("[data-thumb]").forEach((btn) => {
        btn.addEventListener("click", () => showImage(Number(btn.dataset.thumb)));
      });
    };

    const selectVariant = (i: number) => {
      const v = variants[i];
      if (!v) return;
      current = i;
      imageIndex = 0;

      if (priceEl) priceEl.textContent = v.price;
      if (mrpEl) {
        mrpEl.textContent = v.mrp;
        mrpEl.hidden = v.off === 0;
      }
      if (offEl) {
        offEl.textContent = `${v.off}% off`;
        offEl.hidden = v.off === 0;
      }
      if (skuEl) skuEl.textContent = v.sku;
      if (specSku) specSku.textContent = v.sku;

      const colourText = v.secondary ? `${v.colour} with ${v.secondary}` : v.colour;
      if (colourName) colourName.textContent = colourText;
      if (specColour) specColour.textContent = colourText;

      if (availText) availText.textContent = v.availability;
      if (specAvail) specAvail.textContent = v.availability;
      if (availBox) availBox.dataset.state = v.state;

      if (waLink) {
        const msg = `Hello JAIISHA, I would like to enquire about:\n\n${document.title.split(" | ")[0]}\nColour: ${v.colour}\nCode: ${v.sku}\nPrice: ${v.price}\n\n${location.href}`;
        waLink.href = waLink.href.split("?text=")[0] + "?text=" + encodeURIComponent(msg);
      }

      root
        .querySelectorAll<HTMLButtonElement>("[data-variant]")
        .forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.variant === v.id)));

      paintThumbs(v);
      showImage(0);

      // Reflect the choice in the URL so a colourway can be linked to.
      const url = new URL(location.href);
      url.searchParams.set("colour", v.colourSlug);
      history.replaceState({}, "", url);
    };

    root.querySelectorAll<HTMLButtonElement>("[data-variant]").forEach((btn) => {
      btn.addEventListener("click", () => selectVariant(Number(btn.dataset.index)));
    });

    bindThumbs();

    // Deep link: /sarees/x?colour=green opens on that colourway.
    const wanted = new URLSearchParams(location.search).get("colour");
    const wantedIndex = variants.findIndex((v) => v.colourSlug === wanted);
    if (wantedIndex > 0) selectVariant(wantedIndex);

    /* --- magnifier ---------------------------------------------------- */
    const stage = root.querySelector<HTMLElement>("[data-zoom-open]");
    if (stage && mainImg && window.matchMedia("(hover: hover)").matches) {
      stage.addEventListener("mousemove", (e) => {
        const r = stage.getBoundingClientRect();
        const x = ((e.clientX - r.left) / r.width) * 100;
        const y = ((e.clientY - r.top) / r.height) * 100;
        mainImg.style.transformOrigin = `${x}% ${y}%`;
        stage.classList.add("is-magnified");
      });
      stage.addEventListener("mouseleave", () => {
        stage.classList.remove("is-magnified");
        mainImg.style.transformOrigin = "center";
      });
    }

    /* --- lightbox ------------------------------------------------------ */
    const zoom = document.querySelector<HTMLElement>("[data-zoom]");
    const zoomImg = document.querySelector<HTMLImageElement>("[data-zoom-img]");
    const zoomCaption = document.querySelector<HTMLElement>("[data-zoom-caption]");

    // Ensure hidden on boot
    if (zoom) {
      zoom.hidden = true;
      zoom.style.display = "none";
    }

    const paintZoom = () => {
      const im = variants[current]?.images[imageIndex] ?? variants[current]?.images[0];
      if (!im) return;
      if (zoomImg) {
        zoomImg.src = im.src;
        zoomImg.alt = im.alt;
      }
      if (zoomCaption) {
        zoomCaption.textContent = `${im.alt} · ${imageIndex + 1} of ${variants[current].images.length}`;
      }
    };

    const openZoom = () => {
      if (!zoom) return;
      paintZoom();
      zoom.hidden = false;
      zoom.style.display = "grid";
      document.body.classList.add("no-scroll");
    };
    const closeZoom = () => {
      if (!zoom) return;
      zoom.hidden = true;
      zoom.style.display = "none";
      document.body.classList.remove("no-scroll");
    };
    const step = (dir: number) => {
      const n = variants[current].images.length;
      showImage((imageIndex + dir + n) % n);
      paintZoom();
    };

    stage?.addEventListener("click", (e) => {
      e.preventDefault();
      openZoom();
    });

    const zoomCloseBtn = document.querySelector<HTMLElement>("[data-zoom-close]");
    zoomCloseBtn?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeZoom();
    });

    document.querySelector("[data-zoom-prev]")?.addEventListener("click", (e) => {
      e.stopPropagation();
      step(-1);
    });
    document.querySelector("[data-zoom-next]")?.addEventListener("click", (e) => {
      e.stopPropagation();
      step(1);
    });

    zoom?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === zoom || target.classList.contains("zoom") || target.closest("[data-zoom-close]")) {
        closeZoom();
      }
    });

    document.addEventListener("keydown", (e) => {
      if (!zoom || zoom.hidden || zoom.style.display === "none") return;
      if (e.key === "Escape") closeZoom();
      if (e.key === "ArrowLeft") step(-1);
      if (e.key === "ArrowRight") step(1);
    });

    /* --- video -------------------------------------------------------- */
    const vmodal = document.querySelector<HTMLElement>("[data-vmodal]");
    const video = document.querySelector<HTMLVideoElement>("[data-pdp-video]");

    if (vmodal) {
      vmodal.hidden = true;
      vmodal.style.display = "none";
    }

    document.querySelector("[data-open-video]")?.addEventListener("click", (e) => {
      e.preventDefault();
      if (!vmodal) return;
      vmodal.hidden = false;
      vmodal.style.display = "grid";
      document.body.classList.add("no-scroll");
      void video?.play().catch(() => {});
    });

    const closeVideo = () => {
      if (!vmodal) return;
      vmodal.hidden = true;
      vmodal.style.display = "none";
      video?.pause();
      document.body.classList.remove("no-scroll");
    };

    document.querySelector("[data-close-video]")?.addEventListener("click", (e) => {
      e.preventDefault();
      e.stopPropagation();
      closeVideo();
    });
    vmodal?.addEventListener("click", (e) => {
      const target = e.target as HTMLElement;
      if (target === vmodal || target.classList.contains("vmodal") || target.closest("[data-close-video]")) {
        closeVideo();
      }
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && vmodal && !vmodal.hidden && vmodal.style.display !== "none") closeVideo();
    });

    /* --- wishlist & bag with CRUD ------------------------------------- */
    let pdpQuantity = 1;
    const qtyValEl = root.querySelector<HTMLElement>("[data-pdp-qty]");
    root.querySelector("[data-pdp-minus]")?.addEventListener("click", () => {
      if (pdpQuantity > 1) {
        pdpQuantity--;
        if (qtyValEl) qtyValEl.textContent = String(pdpQuantity);
      }
    });
    root.querySelector("[data-pdp-plus]")?.addEventListener("click", () => {
      if (pdpQuantity < 10) {
        pdpQuantity++;
        if (qtyValEl) qtyValEl.textContent = String(pdpQuantity);
      }
    });

    const wishBtn = root.querySelector<HTMLButtonElement>("[data-wish-pdp]");
    if (wishBtn) {
      const slug = wishBtn.dataset.wishPdp!;
      const key = "jaiisha:wishlist";
      const getWish = (): string[] => {
        try {
          return JSON.parse(localStorage.getItem(key) || "[]");
        } catch {
          return [];
        }
      };
      const setWish = (l: string[]) => {
        try {
          localStorage.setItem(key, JSON.stringify(l));
        } catch {}
        window.dispatchEvent(new CustomEvent("jaiisha:store"));
      };

      const set = new Set(getWish());
      wishBtn.setAttribute("aria-pressed", set.has(slug) ? "true" : "false");
      wishBtn.addEventListener("click", () => {
        if (set.has(slug)) set.delete(slug);
        else set.add(slug);
        wishBtn.setAttribute("aria-pressed", set.has(slug) ? "true" : "false");
        setWish([...set]);
      });
    }

    const bagBtn = root.querySelector<HTMLButtonElement>("[data-add-bag]");
    const bagLabel = root.querySelector<HTMLElement>("[data-bag-label]");
    bagBtn?.addEventListener("click", () => {
      const v = variants[current];
      const title = document.title.split(" | ")[0];
      const im = v.images[0]?.src || "";
      const item = {
        sku: v.sku,
        slug: location.pathname.split("/").pop() || "",
        name: title,
        colour: v.colour,
        price: v.price,
        paise: v.paise,
        gst: Number(root.dataset.gst ?? "5"),
        image: im,
        quantity: pdpQuantity,
      };

      if ((window as any).jaiishaCart?.add) {
        (window as any).jaiishaCart.add(item);
      }
      if (bagLabel) {
        bagLabel.textContent = "Added to bag!";
        setTimeout(() => (bagLabel.textContent = "Add to bag"), 2000);
      }
    });

    /* --- write review modal CRUD -------------------------------------- */
    const revModal = document.querySelector<HTMLElement>("[data-rev-modal]");
    const revForm = document.querySelector<HTMLFormElement>("[data-rev-form]");
    const revAlert = document.querySelector<HTMLElement>("[data-rev-alert]");
    const revContainer = document.querySelector<HTMLElement>("[data-reviews-container]");
    const starPicker = document.querySelector<HTMLElement>("[data-star-picker]");
    const ratingInput = document.querySelector<HTMLInputElement>("[data-rating-input]");

    const openRev = () => {
      if (!revModal) return;
      revModal.hidden = false;
      revModal.style.display = "grid";
      document.body.classList.add("no-scroll");
    };

    const closeRev = () => {
      if (!revModal) return;
      revModal.hidden = true;
      revModal.style.display = "none";
      document.body.classList.remove("no-scroll");
    };

    document.querySelectorAll("[data-open-rev]").forEach((b) => b.addEventListener("click", openRev));
    document.querySelectorAll("[data-close-rev]").forEach((b) => b.addEventListener("click", closeRev));
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && revModal && !revModal.hidden && revModal.style.display !== "none") closeRev();
    });

    starPicker?.querySelectorAll<HTMLButtonElement>(".rev-star").forEach((btn) => {
      btn.addEventListener("click", () => {
        const star = Number(btn.dataset.star || "5");
        if (ratingInput) ratingInput.value = String(star);
        starPicker.querySelectorAll<HTMLButtonElement>(".rev-star").forEach((s) => {
          const val = Number(s.dataset.star || "0");
          s.classList.toggle("is-active", val <= star);
        });
      });
    });

    const slug = location.pathname.split("/").pop() || "default";
    const revKey = `jaiisha:user-reviews:${slug}`;

    const loadUserReviews = () => {
      if (!revContainer) return;
      try {
        const stored = JSON.parse(localStorage.getItem(revKey) || "[]");
        stored.forEach((r: any) => {
          const li = document.createElement("li");
          li.className = "pdp-rev__item";
          li.innerHTML = `
            <div class="pdp-rev__meta">
              <span style="color:var(--gold); letter-spacing: 2px;">${"★".repeat(r.rating)}${"☆".repeat(5 - r.rating)}</span>
              <p class="pdp-rev__author">${r.author} <span>${r.city}</span></p>
              <span class="pdp-rev__verified">Verified Customer</span>
            </div>
            <div>
              <h3 class="pdp-rev__item-title">${r.title}</h3>
              <p class="pdp-rev__body">${r.body}</p>
            </div>
          `;
          revContainer.prepend(li);
        });
      } catch {}
    };
    loadUserReviews();

    revForm?.addEventListener("submit", (e) => {
      e.preventDefault();
      const formData = new FormData(revForm);
      const newRev = {
        rating: Number(formData.get("rating") || 5),
        author: String(formData.get("author")),
        city: String(formData.get("city")),
        title: String(formData.get("title")),
        body: String(formData.get("body")),
        date: new Date().toLocaleDateString("en-IN"),
      };

      try {
        const existing = JSON.parse(localStorage.getItem(revKey) || "[]");
        existing.push(newRev);
        localStorage.setItem(revKey, JSON.stringify(existing));
      } catch {}

      if (revContainer) {
        const li = document.createElement("li");
        li.className = "pdp-rev__item";
        li.style.animation = "fadeIn 0.4s";
        li.innerHTML = `
          <div class="pdp-rev__meta">
            <span style="color:var(--gold); letter-spacing: 2px;">${"★".repeat(newRev.rating)}${"☆".repeat(5 - newRev.rating)}</span>
            <p class="pdp-rev__author">${newRev.author} <span>${newRev.city}</span></p>
            <span class="pdp-rev__verified">Verified Customer</span>
          </div>
          <div>
            <h3 class="pdp-rev__item-title">${newRev.title}</h3>
            <p class="pdp-rev__body">${newRev.body}</p>
          </div>
        `;
        revContainer.prepend(li);
      }

      closeRev();
      if (revAlert) revAlert.hidden = false;
      revForm.reset();
    });

    /* --- share -------------------------------------------------------- */
    const shareBtn = root.querySelector<HTMLButtonElement>("[data-share]");
    const shareMsg = root.querySelector<HTMLElement>("[data-share-msg]");
    shareBtn?.addEventListener("click", async () => {
      try {
        if (navigator.share) {
          await navigator.share({ title: document.title, url: location.href });
          return;
        }
        await navigator.clipboard.writeText(location.href);
        if (shareMsg) shareMsg.textContent = "Link copied";
      } catch {
        if (shareMsg) shareMsg.textContent = location.href;
      }
      setTimeout(() => shareMsg && (shareMsg.textContent = ""), 2500);
    });
  }
</script>

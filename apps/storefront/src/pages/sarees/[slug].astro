---
import Base from "../../layouts/Base.astro";
import ProductCard from "../../components/ProductCard.astro";
import Stars from "../../components/Stars.astro";
import {
  PRODUCTS,
  ZARI_LABELS,
  discountPercent,
  fabricBySlug,
  formatINR,
  occasionBySlug,
  relatedProducts,
  reviewsForProduct,
  type Product,
  type ProductVariant,
} from "@jaiisha/catalogue";
import { SITE, PHASE2_NOTICE, whatsappLink } from "../../lib/site.ts";

export function getStaticPaths() {
  return PRODUCTS.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

interface Props {
  product: Product;
}
const { product } = Astro.props;

const variants = product.variants;
const initial: ProductVariant = variants.find((v) => v.availability === "in_stock") ?? variants[0];
const fabric = fabricBySlug(product.fabric);
const reviews = reviewsForProduct(product.id);
const related = relatedProducts(product, 4);
const off = discountPercent(initial);

const weaveLabel: Record<string, string> = {
  handloom: "Handloom, woven on a pit loom",
  "semi-handloom": "Semi-handloom",
  powerloom: "Powerloom",
};

const availabilityLabel = (v: ProductVariant) =>
  v.availability === "in_stock"
    ? v.stock !== null && v.stock <= 3
      ? `In stock — only ${v.stock} left`
      : "In stock, ships in 24 hours"
    : v.availability === "made_to_order"
      ? `Made to order — woven in ${v.leadTimeDays ?? 21} days`
      : "Sold out";

/** The spec sheet from the brief, in the order a buyer asks about it. */
const specs = [
  { label: "Product code", value: initial.sku, key: "sku" },
  { label: "Fabric", value: fabric?.name ?? product.fabric },
  { label: "Weaving", value: weaveLabel[product.weave] ?? product.weave },
  { label: "Technique", value: product.craft },
  { label: "Zari", value: ZARI_LABELS[product.zari] ?? product.zari },
  { label: "Colour", value: initial.colour.name + (initial.secondaryColour ? ` with ${initial.secondaryColour.name}` : ""), key: "colour" },
  { label: "Saree length", value: `${product.sareeLengthMetres} metres` },
  {
    label: "Blouse piece",
    value: product.blousePieceMetres ? `Included, ${product.blousePieceMetres} m unstitched` : "Not included",
  },
  { label: "Weight", value: product.weightGrams ? `${product.weightGrams} g` : "—" },
  { label: "Woven in", value: product.origin },
  { label: "Occasion", value: product.occasions.map((o) => occasionBySlug(o)?.name ?? o).join(", ") },
  { label: "Availability", value: availabilityLabel(initial), key: "availability" },
  { label: "Care", value: product.care[0] },
];

const enquiry = (v: ProductVariant) =>
  whatsappLink(
    `Hello JAIISHA, I would like to enquire about:\n\n${product.name}\nColour: ${v.colour.name}\nCode: ${v.sku}\nPrice: ${formatINR(v.price)}\n\n${SITE.url}/sarees/${product.slug}`,
  );

/* --- structured data ---------------------------------------------------- */
const schema = [
  {
    "@context": "https://schema.org",
    "@type": "Product",
    name: product.name,
    description: product.seo.description,
    sku: initial.sku,
    brand: { "@type": "Brand", name: SITE.name },
    material: fabric?.name ?? product.fabric,
    color: initial.colour.name,
    image: variants.flatMap((v) => v.images.map((i) => new URL(i.src, SITE.url).href)).slice(0, 6),
    aggregateRating: {
      "@type": "AggregateRating",
      ratingValue: product.rating.value,
      reviewCount: product.rating.count,
    },
    offers: variants.map((v) => ({
      "@type": "Offer",
      sku: v.sku,
      price: (v.price.paise / 100).toFixed(2),
      priceCurrency: v.price.currency,
      availability:
        v.availability === "in_stock"
          ? "https://schema.org/InStock"
          : v.availability === "made_to_order"
            ? "https://schema.org/PreOrder"
            : "https://schema.org/OutOfStock",
      url: `${SITE.url}/sarees/${product.slug}`,
    })),
    review: reviews.slice(0, 3).map((r) => ({
      "@type": "Review",
      author: { "@type": "Person", name: r.author },
      reviewRating: { "@type": "Rating", ratingValue: r.rating },
      name: r.title,
      reviewBody: r.body,
      datePublished: r.createdAt,
    })),
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      { "@type": "ListItem", position: 1, name: "Home", item: SITE.url },
      { "@type": "ListItem", position: 2, name: "Sarees", item: `${SITE.url}/sarees` },
      { "@type": "ListItem", position: 3, name: product.name },
    ],
  },
];
---

<Base
  title={product.seo.title}
  description={product.seo.description}
  image={initial.images[0].src}
  schema={schema}
  canonicalPath={`/sarees/${product.slug}`}
>
  <nav class="crumbs shell" aria-label="Breadcrumb">
    <ol>
      <li><a href="/">Home</a></li>
      <li><a href="/sarees">Sarees</a></li>
      <li aria-current="page">{product.name}</li>
    </ol>
  </nav>

  <article
    class="pdp shell"
    data-pdp
    data-gst={String(product.tax.gstRate)}
    data-variants={JSON.stringify(
      variants.map((v) => ({
        id: v.id,
        sku: v.sku,
        colour: v.colour.name,
        colourSlug: v.colour.slug,
        secondary: v.secondaryColour?.name ?? null,
        price: formatINR(v.price),
        paise: v.price.paise,
        mrp: formatINR(v.mrp),
        off: discountPercent(v),
        availability: availabilityLabel(v),
        state: v.availability,
        images: v.images,
      })),
    )}
  >
    <!-- ===================== gallery ===================== -->
    <div class="gal">
      <ul class="gal__thumbs" data-thumbs aria-label="Product images">
        {
          initial.images.map((im, i) => (
            <li>
              <button
                class="gal__thumb"
                type="button"
                aria-label={`View image ${i + 1}: ${im.kind}`}
                aria-pressed={i === 0 ? "true" : "false"}
                data-thumb={i}
              >
                <img src={im.src} alt="" width="300" height="400" loading="lazy" decoding="async" />
                <span class="gal__thumb-kind">{im.kind}</span>
              </button>
            </li>
          ))
        }
        {
          product.video && (
            <li>
              <button class="gal__thumb gal__thumb--video" type="button" aria-label="Play the saree video" data-open-video>
                <img src={initial.images[0].src} alt="" width="300" height="400" loading="lazy" decoding="async" />
                <span class="gal__thumb-play" aria-hidden="true">
                  <svg viewBox="0 0 24 24"><path d="M9 7.5l8 4.5-8 4.5z" fill="currentColor" /></svg>
                </span>
                <span class="gal__thumb-kind">video</span>
              </button>
            </li>
          )
        }
      </ul>

      <div class="gal__stage">
        <!-- Hover to magnify, click to open full screen. -->
        <button class="gal__main" type="button" data-zoom-open aria-label="Open full-screen view">
          <img
            src={initial.images[0].src}
            alt={initial.images[0].alt}
            width={initial.images[0].width}
            height={initial.images[0].height}
            fetchpriority="high"
            decoding="async"
            data-main-img
          />
          <span class="gal__hint">
            <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M16 16l4.5 4.5M11 8.5v5M8.5 11h5" stroke="currentColor" stroke-width="1.5" fill="none" /></svg>
            Click to zoom
          </span>
        </button>

        {
          product.badges.includes("handloom") && (
            <span class="gal__flag">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3 17c3-6 6-6 9-3s6 3 9-3" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
              Handloom · Varanasi
            </span>
          )
        }
      </div>
    </div>

    <!-- ===================== buy panel ===================== -->
    <div class="buy">
      <p class="buy__fabric">{fabric?.name ?? product.fabric} · {product.craft}</p>
      <h1 class="buy__title">{product.name}</h1>
      <p class="buy__tagline">{product.tagline}</p>

      <div class="buy__rating">
        <Stars value={product.rating.value} count={product.rating.count} />
        <a class="buy__rating-link" href="#reviews">Read reviews</a>
      </div>

      <div class="buy__price price">
        <span class="price__now" data-price>{formatINR(initial.price)}</span>
        <span class="price__was" data-mrp hidden={off === 0}>{formatINR(initial.mrp)}</span>
        <span class="price__off" data-off hidden={off === 0}>{off}% off</span>
      </div>
      <p class="buy__tax">Inclusive of all taxes · GST {product.tax.gstRate}% · HSN {product.tax.hsn}</p>

      <!-- Colour: built from the variants that exist, so a colour can never be
           chosen that this design is not woven in. -->
      <div class="buy__field">
        <div class="buy__field-head">
          <span class="buy__label">Colour</span>
          <span class="buy__value" data-colour-name>
            {initial.colour.name}{initial.secondaryColour ? ` with ${initial.secondaryColour.name}` : ""}
          </span>
        </div>
        <ul class="buy__swatches">
          {
            variants.map((v, i) => (
              <li>
                <button
                  class="buy__swatch"
                  type="button"
                  style={`--c:${v.colour.hex};--c2:${v.colour.shadeHex ?? v.colour.hex}`}
                  aria-label={`${v.colour.name} — ${formatINR(v.price)}`}
                  aria-pressed={v.id === initial.id ? "true" : "false"}
                  data-variant={v.id}
                  data-index={i}
                >
                  <span class="buy__swatch-disc"></span>
                  {v.availability === "sold_out" && <span class="buy__swatch-out" aria-hidden="true"></span>}
                </button>
              </li>
            ))
          }
        </ul>
      </div>

      <p class="buy__stock" data-availability data-state={initial.availability}>
        <span class="buy__dot" aria-hidden="true"></span>
        <span data-availability-text>{availabilityLabel(initial)}</span>
      </p>

      <p class="buy__sku">Code <strong data-sku>{initial.sku}</strong></p>

      <!-- Quantity selection -->
      <div class="buy__field buy__field--qty">
        <span class="buy__label">Quantity</span>
        <div class="buy__qty-box">
          <button class="buy__qty-btn" type="button" data-pdp-minus aria-label="Decrease quantity">−</button>
          <span class="buy__qty-val" data-pdp-qty>1</span>
          <button class="buy__qty-btn" type="button" data-pdp-plus aria-label="Increase quantity">+</button>
        </div>
      </div>

      <div class="buy__actions">
        <button class="btn btn--gold buy__bag" type="button" data-add-bag>
          <svg viewBox="0 0 24 24" aria-hidden="true" style="width: 1.15rem; height: 1.15rem;">
            <path d="M6 8h12l-1 11.5H7L6 8Z" fill="none" stroke="currentColor" stroke-width="1.6" />
            <path d="M9.5 8V6.4a2.5 2.5 0 0 1 5 0V8" fill="none" stroke="currentColor" stroke-width="1.6" />
          </svg>
          <span data-bag-label>Add to bag</span>
        </button>
        <a class="btn btn--wa buy__wa" href={enquiry(initial)} target="_blank" rel="noopener noreferrer" data-wa>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 11.7a7.9 7.9 0 0 1-11.6 7L4 20l1.4-4.2A7.9 7.9 0 1 1 20 11.7Z" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
          Order on WhatsApp
        </a>
        <button class="buy__wish" type="button" aria-pressed="false" data-wish-pdp={product.slug} aria-label="Save to wishlist">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20s-7.5-4.6-7.5-9.6A4.4 4.4 0 0 1 12 7.7a4.4 4.4 0 0 1 7.5 2.7c0 5-7.5 9.6-7.5 9.6Z" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </button>
      </div>

      <p class="buy__phase2">{PHASE2_NOTICE}</p>

      <ul class="buy__assure">
        <li>Free insured shipping above ₹3,000</li>
        <li>Weaver's certificate in the box</li>
        <li>7-day return on unworn pieces</li>
      </ul>

      <!-- Story -->
      <section class="buy__story" aria-labelledby="story-title">
        <h2 class="buy__story-title" id="story-title">About this saree</h2>
        <p>{product.story}</p>
      </section>

      <!-- Spec sheet -->
      <section class="spec" aria-labelledby="spec-title">
        <h2 class="spec__title" id="spec-title">Details</h2>
        <dl class="spec__list">
          {
            specs.map((s) => (
              <div class="spec__row">
                <dt>{s.label}</dt>
                <dd data-spec={s.key ?? undefined}>{s.value}</dd>
              </div>
            ))
          }
        </dl>
      </section>

      <!-- Care -->
      <section class="care" aria-labelledby="care-title">
        <h2 class="care__title" id="care-title">Caring for it</h2>
        <ul class="care__list">
          {product.care.map((c) => <li>{c}</li>)}
        </ul>
      </section>

      <div class="buy__share">
        <span class="buy__label">Share</span>
        <button class="buy__share-btn" type="button" data-share>Copy link</button>
        <a class="buy__share-btn" href={`https://wa.me/?text=${encodeURIComponent(`${product.name} — ${SITE.url}/sarees/${product.slug}`)}`} target="_blank" rel="noopener noreferrer">WhatsApp</a>
        <span class="buy__share-msg" data-share-msg role="status" aria-live="polite"></span>
      </div>
    </div>
  </article>

  <!-- ===================== reviews ===================== -->
  <section class="pdp-rev section" id="reviews" aria-labelledby="pdp-rev-title">
    <div class="shell">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Customer reviews</p>
          <h2 class="pdp-rev__title" id="pdp-rev-title">
            {product.rating.value.toFixed(1)} out of 5
            <span class="pdp-rev__count">from {product.rating.count} reviews</span>
          </h2>
        </div>
        <button class="btn btn--gold" type="button" data-open-rev>
          Write a review
        </button>
      </div>

      <div class="rev-alert" data-rev-alert hidden>
        ✓ Thank you! Your review has been published below.
      </div>

      <ul class="pdp-rev__list" data-reviews-container>
        {reviews.map((r) => (
              <li class="pdp-rev__item">
                <div class="pdp-rev__meta">
                  <Stars value={r.rating} compact />
                  <p class="pdp-rev__author">{r.author} <span>{r.city}</span></p>
                  {r.verified && <span class="pdp-rev__verified">Verified purchase</span>}
                </div>
                <div>
                  <h3 class="pdp-rev__item-title">{r.title}</h3>
                  <p class="pdp-rev__body">{r.body}</p>
                </div>
              </li>
            ))}
      </ul>
    </div>
  </section>

  <!-- ===================== related ===================== -->
  <section class="rel section section--sunk" aria-labelledby="rel-title">
    <div class="shell">
      <div class="section-head">
        <p class="eyebrow">You may also like</p>
        <h2 class="rel__title" id="rel-title">Woven for the same occasions</h2>
      </div>
      <div class="rel__grid">
        {related.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  <!-- ===================== zoom lightbox ===================== -->
  <div class="zoom" data-zoom hidden style="display: none;">
    <button class="zoom__close" type="button" aria-label="Close" data-zoom-close>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
    </button>
    <button class="zoom__nav zoom__nav--prev" type="button" aria-label="Previous image" data-zoom-prev>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
    <figure class="zoom__figure">
      <img src={initial.images[0].src} alt="" data-zoom-img />
      <figcaption class="zoom__caption" data-zoom-caption></figcaption>
    </figure>
    <button class="zoom__nav zoom__nav--next" type="button" aria-label="Next image" data-zoom-next>
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
    </button>
  </div>

  <!-- ===================== video modal ===================== -->
  {
    product.video && (
      <div class="vmodal" data-vmodal hidden style="display: none;">
        <button class="zoom__close" type="button" aria-label="Close video" data-close-video>
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none" /></svg>
        </button>
        <div class="vmodal__frame" data-aspect={product.video.aspect}>
          <video controls playsinline preload="none" data-pdp-video>
            <source src={product.video.src} type="video/mp4" />
          </video>
        </div>
      </div>
    )
  }

  <!-- ===================== review modal ===================== -->
  <div class="rev-modal" data-rev-modal hidden aria-hidden="true" style="display: none;">
    <div class="rev-modal__scrim" data-close-rev></div>
    <div class="rev-modal__panel" role="dialog" aria-modal="true" aria-label="Write a review">
      <div class="rev-modal__head">
        <div>
          <p class="eyebrow">Customer feedback</p>
          <h3 class="rev-modal__title">Review {product.name}</h3>
        </div>
        <button class="icon-btn rev-modal__close" type="button" aria-label="Close review modal" data-close-rev>
          <svg viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" stroke="currentColor" stroke-width="1.6" fill="none"/></svg>
        </button>
      </div>

      <form class="rev-modal__form" data-rev-form>
        <div class="rev-field">
          <label class="rev-label">Your Rating</label>
          <div class="rev-stars" data-star-picker>
            <button type="button" class="rev-star is-active" data-star="1" aria-label="1 star">★</button>
            <button type="button" class="rev-star is-active" data-star="2" aria-label="2 stars">★</button>
            <button type="button" class="rev-star is-active" data-star="3" aria-label="3 stars">★</button>
            <button type="button" class="rev-star is-active" data-star="4" aria-label="4 stars">★</button>
            <button type="button" class="rev-star is-active" data-star="5" aria-label="5 stars">★</button>
          </div>
          <input type="hidden" name="rating" value="5" data-rating-input />
        </div>

        <div class="rev-grid">
          <div class="rev-field">
            <label class="rev-label" for="rev-author">Full Name</label>
            <input id="rev-author" type="text" name="author" class="rev-input" required placeholder="e.g. Radhika Sharma" />
          </div>
          <div class="rev-field">
            <label class="rev-label" for="rev-city">City</label>
            <input id="rev-city" type="text" name="city" class="rev-input" required placeholder="e.g. Varanasi, Delhi" />
          </div>
        </div>

        <div class="rev-field">
          <label class="rev-label" for="rev-title">Review Headline</label>
          <input id="rev-title" type="text" name="title" class="rev-input" required placeholder="e.g. Exquisite silver zari weave, felt like royalty" />
        </div>

        <div class="rev-field">
          <label class="rev-label" for="rev-body">Your Review</label>
          <textarea id="rev-body" name="body" class="rev-textarea" rows="4" required placeholder="Share how the silk draped, the weight, shine of zari under lights, and occasion compliments..."></textarea>
        </div>

        <button type="submit" class="btn btn--gold rev-submit">Submit Verified Review</button>
      </form>
    </div>
  </div>
</Base>

<style>
  .crumbs {
    padding-top: 1.5rem;
    font-size: 0.74rem;
    color: var(--ink-faint);
  }
  .crumbs ol {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .crumbs li + li::before {
    content: "/";
    margin-right: 0.5rem;
    color: var(--line-strong);
  }
  .crumbs a:hover {
    color: var(--wine);
  }
  .crumbs li[aria-current] {
    color: var(--ink-soft);
  }

  /* ===================== layout ===================== */
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    padding-block: clamp(1.2rem, 3vw, 2.5rem) var(--section-y);
    align-items: start;
  }

  /* ===================== gallery ===================== */
  .gal {
    display: grid;
    grid-template-columns: 5.5rem minmax(0, 1fr);
    gap: 0.8rem;
    position: sticky;
    top: 6rem;
  }

  .gal__thumbs {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .gal__thumb {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg-sunk);
    border: 1px solid transparent;
    transition: border-color 0.3s var(--ease), opacity 0.3s var(--ease);
    opacity: 0.72;
  }

  .gal__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gal__thumb:hover,
  .gal__thumb[aria-pressed="true"] {
    opacity: 1;
    border-color: var(--gold);
  }

  .gal__thumb-kind {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    padding: 0.15rem;
    background: rgba(28, 15, 21, 0.72);
    color: var(--gold-pale);
    font-size: 0.52rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: center;
  }

  .gal__thumb-play {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: rgba(28, 15, 21, 0.4);
    color: var(--ivory);
  }

  .gal__thumb-play svg {
    width: 1.6rem;
    height: 1.6rem;
  }

  .gal__stage {
    position: relative;
  }

  .gal__main {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    background: var(--bg-sunk);
    cursor: zoom-in;
  }

  .gal__main img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: scale 0.6s var(--ease-out-soft);
  }

  /* Pointer-tracked magnification, set by the script. */
  .gal__main.is-magnified img {
    scale: 1.9;
  }

  .gal__hint {
    position: absolute;
    bottom: 0.8rem;
    right: 0.8rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.75rem;
    background: rgba(255, 255, 255, 0.92);
    border-radius: var(--r-pill);
    font-size: 0.68rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
    opacity: 0;
